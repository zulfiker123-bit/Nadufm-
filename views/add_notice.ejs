<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>নোটিশ ম্যানেজমেন্ট</title>
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#15803d">
    <link rel="stylesheet" href="/fonts.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Kalpurush', sans-serif; background: #f4f7f5; color: #0f172a; padding: 20px; line-height: 1.5; }
        .wrap { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 360px 1fr; gap: 20px; align-items: start; }
        .panel { background: #ffffff; border: 1px solid rgba(15, 23, 42, 0.09); border-radius: 16px; padding: 20px; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04); margin-bottom: 18px; }
        .panel h2 { font-size: 1.08rem; font-weight: 700; color: #14532d; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(15, 23, 42, 0.08); }
        .field { margin-bottom: 14px; }
        .field label { display: block; font-size: 0.88rem; font-weight: 600; color: #334155; margin-bottom: 5px; }
        .field input[type="text"], .field textarea { width: 100%; padding: 10px 12px; border: 1px solid rgba(15, 23, 42, 0.14); border-radius: 10px; background: #f8faf9; font-family: inherit; font-size: 0.94rem; outline: none; }
        .field input[type="text"]:focus, .field textarea:focus { border-color: #15803d; background: #ffffff; }
        .check-row { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #f8faf9; border: 1px solid rgba(15, 23, 42, 0.08); border-radius: 10px; margin-bottom: 14px; font-size: 0.9rem; font-weight: 600; }
        .check-row input { width: 16px; height: 16px; accent-color: #15803d; }
        .btn { width: 100%; min-height: 44px; border: 1px solid transparent; border-radius: 11px; font-family: inherit; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease; }
        .btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
        .btn:active { transform: translateY(2px); }
        .btn-green { background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%); color: #ffffff; border-color: #146c34; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 3.5px 0 #0e5427, 0 6px 14px -3px rgba(21,128,61,0.3); }
        .btn-green:active { box-shadow: 0 1px 0 #0e5427; }
        .btn-blue { background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border-color: #1e40af; box-shadow: inset 0 1px 0 rgba(255,255,255,0.26), 0 3.5px 0 #172f82, 0 6px 14px -3px rgba(29,78,216,0.3); }
        .btn-blue:active { box-shadow: 0 1px 0 #172f82; }
        .alert { padding: 10px 12px; border-radius: 10px; font-size: 0.9rem; font-weight: 600; margin-bottom: 14px; }
        .alert-green { background: #dcfce7; color: #166534; }
        .alert-blue { background: #dbeafe; color: #1e40af; }
        .alert-red { background: #fee2e2; color: #b91c1c; }
        .cancel-link { display: block; text-align: center; margin-top: 10px; font-size: 0.88rem; color: #dc2626; font-weight: 600; text-decoration: none; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
        th { background: #f8faf9; color: #14532d; font-weight: 700; text-align: left; padding: 12px 14px; border-bottom: 1px solid rgba(15, 23, 42, 0.09); }
        td { padding: 12px 14px; border-bottom: 1px solid rgba(15, 23, 42, 0.06); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        .action-row { display: flex; gap: 8px; justify-content: flex-end; }
        .act-btn { padding: 6px 12px; border-radius: 8px; text-decoration: none; font-size: 0.84rem; font-weight: 600; transition: transform 0.13s ease, box-shadow 0.13s ease; }
        .act-btn:hover { transform: translateY(-1px); }
        .act-btn:active { transform: translateY(1px); }
        .act-edit { background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%); color: #1d4ed8; border: 1px solid #93c5fd; box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(29, 78, 216, 0.16); }
        .act-del { background: linear-gradient(180deg, #fef2f2 0%, #fee2e2 100%); color: #b91c1c; border: 1px solid #fca5a5; box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(185, 28, 28, 0.16); }
        @media (max-width: 900px) { .wrap { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="wrap">
        <div>
            <div class="panel">
                <h2>স্ক্রলিং হেডলাইন আপডেট</h2>
                <div id="headlineAlert" class="alert alert-blue" style="display:none;"></div>
                <form id="headlineForm" action="/add_notice.php" method="POST">
                    <div class="field">
                        <label for="headline_text">চলমান ঘোষণা</label>
                        <input id="headline_text" type="text" name="headline_text" value="<%= currentHeadline ? currentHeadline.subject : '' %>" placeholder="চলমান ঘোষণাটি লিখুন..." required>
                    </div>
                    <button type="submit" name="headline_submit" value="1" class="btn btn-blue">হেডলাইন আপডেট করুন</button>
                </form>
            </div>

            <div class="panel">
                <h2 id="noticeFormHeading"><%= editData.id ? "নোটিশ এডিট করুন" : "নতুন নোটিশ যোগ করুন" %></h2>
                <div id="noticeAlert" class="alert <%= messageType === 'red' ? 'alert-red' : (messageType === 'blue' ? 'alert-blue' : 'alert-green') %>" style="<%= message ? '' : 'display:none;' %>"><%= message || '' %></div>
                <form id="noticeForm" action="/add_notice.php" method="POST">
                    <input type="hidden" id="update_id" name="update_id" value="<%= editData.id %>">
                    <div class="field">
                        <label for="notice_date">তারিখ</label>
                        <input id="notice_date" type="text" name="notice_date" placeholder="যেমন: ২০ জানুয়ারি ২০২৬" value="<%= editData.date %>" required>
                    </div>
                    <div class="field">
                        <label for="subject">বিষয়</label>
                        <input id="subject" type="text" name="subject" value="<%= editData.subject %>" required>
                    </div>
                    <div class="field">
                        <label for="description">বিস্তারিত বর্ণনা</label>
                        <textarea id="description" name="description" rows="4"><%= editData.description %></textarea>
                    </div>
                    <div class="field">
                        <label for="link">লিংক (ঐচ্ছিক)</label>
                        <input id="link" type="text" name="link" value="<%= editData.link %>">
                    </div>
                    <label class="check-row">
                        <input type="checkbox" id="is_new" name="is_new" <%= (!editData.id || editData.isNew === 'yes') ? 'checked' : '' %>>
                        <span>নতুন (NEW) হিসেবে চিহ্নিত করুন</span>
                    </label>
                    <button type="submit" id="noticeSubmitBtn" name="notice_submit" value="1" class="btn btn-green">
                        <%= editData.id ? "নোটিশ আপডেট করুন" : "নোটিশ প্রকাশ করুন" %>
                    </button>
                    <a href="/add_notice.php" id="cancelNoticeEdit" class="cancel-link" style="<%= editData.id ? '' : 'display:none;' %>">পরিবর্তন বাতিল করুন</a>
                </form>
            </div>
        </div>

        <div class="panel">
            <h2>প্রকাশিত নোটিশ তালিকা</h2>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>তারিখ</th>
                            <th>বিষয়</th>
                            <th style="text-align:right;">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody id="noticesTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/offline-sync.js"></script>
    <script>
        let noticesList = <%- JSON.stringify(notices || []) %>;

        function esc(s) {
            return String(s ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
        }

        function showNoticeAlert(elId, msg, typeClass) {
            const el = document.getElementById(elId);
            if (!el) return;
            el.className = 'alert ' + (typeClass || 'alert-green');
            el.textContent = msg;
            el.style.display = 'block';
            setTimeout(() => { el.style.display = 'none'; }, 4500);
        }

        function normalizePublicNoticeList(list) {
            return (list || []).map(n => ({
                id: n.id,
                date: n.notice_date || n.date || '',
                subject: n.subject || '',
                link: n.link || '',
                isNew: n.is_new || n.isNew || 'no',
                description: n.description || '',
            }));
        }

        function renderNoticesTable() {
            const tbody = document.getElementById('noticesTableBody');
            if (!tbody) return;
            if (!noticesList.length) {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:32px; color:#64748b;">কোনো নোটিশ পাওয়া যায়নি।</td></tr>';
                return;
            }
            tbody.innerHTML = noticesList.map(row => `
                <tr>
                    <td style="white-space:nowrap; font-weight:600;">${esc(row.notice_date || row.date || '')}</td>
                    <td>${esc(row.subject || '')}</td>
                    <td>
                        <div class="action-row">
                            <button type="button" class="act-btn act-edit" onclick="startEditNotice('${esc(row.id)}')">এডিট</button>
                            <button type="button" class="act-btn act-del" onclick="deleteNotice('${esc(row.id)}')">ডিলিট</button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function startEditNotice(id) {
            const item = noticesList.find(n => String(n.id) === String(id));
            if (!item) return;
            document.getElementById('update_id').value = item.id;
            document.getElementById('notice_date').value = item.notice_date || item.date || '';
            document.getElementById('subject').value = item.subject || '';
            document.getElementById('description').value = item.description || '';
            document.getElementById('link').value = item.link || '';
            document.getElementById('is_new').checked = String(item.is_new || item.isNew || '').toLowerCase() === 'yes';
            document.getElementById('noticeFormHeading').textContent = 'নোটিশ এডিট করুন';
            document.getElementById('noticeSubmitBtn').textContent = 'নোটিশ আপডেট করুন';
            document.getElementById('cancelNoticeEdit').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetNoticeForm() {
            document.getElementById('noticeForm').reset();
            document.getElementById('update_id').value = '';
            document.getElementById('is_new').checked = true;
            document.getElementById('noticeFormHeading').textContent = 'নতুন নোটিশ যোগ করুন';
            document.getElementById('noticeSubmitBtn').textContent = 'নোটিশ প্রকাশ করুন';
            document.getElementById('cancelNoticeEdit').style.display = 'none';
        }

        document.getElementById('cancelNoticeEdit').addEventListener('click', function (e) {
            e.preventDefault();
            resetNoticeForm();
        });

        async function deleteNotice(id) {
            const strId = String(id);
            const applyDelete = (baseNotices) => (baseNotices || []).filter(n => String(n.id) !== strId);

            try {
                if (window.NadufmOffline) {
                    const res = await window.NadufmOffline.saveMutationOrQueue({
                        label: 'নোটিশ মুছে ফেলা',
                        url: '/api/portal/notices/' + encodeURIComponent(strId),
                        method: 'DELETE',
                        headers: {},
                        optimisticUpdate: () => window.NadufmOffline.updateBootstrap(base => {
                            base.notices = base.notices || { headlines: [], notices: [] };
                            base.notices.notices = applyDelete(base.notices.notices);
                            return base;
                        }),
                        onOnlineSuccess: (data) => {
                            if (data && Array.isArray(data.notices)) {
                                noticesList = data.notices;
                                return window.NadufmOffline.updateBootstrap(base => {
                                    base.notices = base.notices || { headlines: [], notices: [] };
                                    base.notices.notices = normalizePublicNoticeList(data.notices);
                                    return base;
                                });
                            }
                        },
                    });
                    if (res.queued) {
                        noticesList = applyDelete(noticesList);
                        renderNoticesTable();
                        showNoticeAlert('noticeAlert', 'অফলাইনে নোটিশ ডিলিট সংরক্ষিত — অনলাইনে অটো সিঙ্ক হবে।', 'alert-blue');
                        return;
                    }
                    renderNoticesTable();
                    showNoticeAlert('noticeAlert', 'নোটিশ সফলভাবে মুছে ফেলা হয়েছে।', 'alert-green');
                    return;
                }
                const resp = await fetch('/api/portal/notices/' + encodeURIComponent(strId), { method: 'DELETE' });
                const data = await resp.json();
                if (resp.ok && data.notices) {
                    noticesList = data.notices;
                    renderNoticesTable();
                    showNoticeAlert('noticeAlert', 'নোটিশ সফলভাবে মুছে ফেলা হয়েছে।', 'alert-green');
                }
            } catch (err) {
                showNoticeAlert('noticeAlert', err.message || 'নোটিশ মুছে ফেলা যায়নি।', 'alert-red');
            }
        }

        document.getElementById('headlineForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const text = document.getElementById('headline_text').value.trim();
            if (!text) return;

            try {
                if (window.NadufmOffline) {
                    const res = await window.NadufmOffline.saveMutationOrQueue({
                        label: 'স্ক্রলিং হেডলাইন আপডেট',
                        url: '/api/portal/headline',
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ headline_text: text }),
                        optimisticUpdate: () => window.NadufmOffline.updateBootstrap(base => {
                            base.notices = base.notices || { headlines: [], notices: [] };
                            base.notices.headlines = [{ id: Date.now(), subject: text, link: '' }].concat(base.notices.headlines || []);
                            return base;
                        }),
                        onOnlineSuccess: (data) => window.NadufmOffline.updateBootstrap(base => {
                            base.notices = base.notices || { headlines: [], notices: [] };
                            if (Array.isArray(data.headlines)) base.notices.headlines = data.headlines;
                            return base;
                        }),
                    });
                    if (res.queued) {
                        showNoticeAlert('headlineAlert', 'অফলাইনে হেডলাইন সংরক্ষিত হয়েছে — অনলাইনে অটো সিঙ্ক হবে।', 'alert-blue');
                        return;
                    }
                    showNoticeAlert('headlineAlert', 'স্ক্রলিং হেডলাইন সফলভাবে আপডেট করা হয়েছে!', 'alert-green');
                    return;
                }
                const resp = await fetch('/api/portal/headline', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ headline_text: text }),
                });
                if (!resp.ok) throw new Error('আপডেট ব্যর্থ হয়েছে');
                showNoticeAlert('headlineAlert', 'স্ক্রলিং হেডলাইন সফলভাবে আপডেট করা হয়েছে!', 'alert-green');
            } catch (err) {
                showNoticeAlert('headlineAlert', err.message || 'হেডলাইন আপডেট করা যায়নি।', 'alert-red');
            }
        });

        document.getElementById('noticeForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const updateId = document.getElementById('update_id').value.trim();
            const payload = {
                update_id: updateId || '',
                notice_date: document.getElementById('notice_date').value.trim(),
                subject: document.getElementById('subject').value.trim(),
                description: document.getElementById('description').value.trim(),
                link: document.getElementById('link').value.trim(),
                is_new: document.getElementById('is_new').checked ? 'yes' : 'no',
            };
            if (!payload.notice_date || !payload.subject) return;

            const tempItem = {
                id: updateId ? Number(updateId) || updateId : Date.now(),
                type: 'notice',
                notice_date: payload.notice_date,
                subject: payload.subject,
                description: payload.description,
                link: payload.link,
                is_new: payload.is_new,
            };

            const applyOptimistic = (arr) => {
                const list = Array.isArray(arr) ? arr.slice() : [];
                if (updateId) {
                    const idx = list.findIndex(n => String(n.id) === String(updateId));
                    if (idx !== -1) {
                        list[idx] = Object.assign({}, list[idx], tempItem);
                        return list;
                    }
                }
                return [tempItem].concat(list);
            };

            try {
                if (window.NadufmOffline) {
                    const res = await window.NadufmOffline.saveMutationOrQueue({
                        label: updateId ? 'নোটিশ আপডেট' : 'নতুন নোটিশ প্রকাশ',
                        url: '/api/portal/notices',
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                        optimisticUpdate: () => window.NadufmOffline.updateBootstrap(base => {
                            base.notices = base.notices || { headlines: [], notices: [] };
                            const pubItem = {
                                id: tempItem.id,
                                date: tempItem.notice_date,
                                subject: tempItem.subject,
                                link: tempItem.link,
                                isNew: tempItem.is_new,
                                description: tempItem.description,
                            };
                            const existing = Array.isArray(base.notices.notices) ? base.notices.notices.slice() : [];
                            if (updateId) {
                                const idx = existing.findIndex(n => String(n.id) === String(updateId));
                                if (idx !== -1) existing[idx] = Object.assign({}, existing[idx], pubItem);
                                else existing.unshift(pubItem);
                            } else {
                                existing.unshift(pubItem);
                            }
                            base.notices.notices = existing;
                            return base;
                        }),
                        onOnlineSuccess: (data) => {
                            if (data && Array.isArray(data.notices)) {
                                noticesList = data.notices;
                                return window.NadufmOffline.updateBootstrap(base => {
                                    base.notices = base.notices || { headlines: [], notices: [] };
                                    base.notices.notices = normalizePublicNoticeList(data.notices);
                                    return base;
                                });
                            }
                        },
                    });
                    if (res.queued) {
                        noticesList = applyOptimistic(noticesList);
                        resetNoticeForm();
                        renderNoticesTable();
                        showNoticeAlert('noticeAlert', 'অফলাইনে সংরক্ষিত হয়েছে — অনলাইনে এলে অটো সিঙ্ক হবে।', 'alert-blue');
                        return;
                    }
                    resetNoticeForm();
                    renderNoticesTable();
                    showNoticeAlert('noticeAlert', updateId ? 'নোটিশ সফলভাবে আপডেট করা হয়েছে!' : 'নতুন নোটিশ সফলভাবে যুক্ত হয়েছে!', 'alert-green');
                    return;
                }

                const resp = await fetch('/api/portal/notices', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                const data = await resp.json();
                if (!resp.ok) throw new Error(data.error || 'সংরক্ষণ ব্যর্থ হয়েছে');
                if (data.notices) noticesList = data.notices;
                resetNoticeForm();
                renderNoticesTable();
                showNoticeAlert('noticeAlert', updateId ? 'নোটিশ সফলভাবে আপডেট করা হয়েছে!' : 'নতুন নোটিশ সফলভাবে যুক্ত হয়েছে!', 'alert-green');
            } catch (err) {
                showNoticeAlert('noticeAlert', err.message || 'সংরক্ষণ ব্যর্থ হয়েছে।', 'alert-red');
            }
        });

        async function hydrateOfflineNotices() {
            if (!window.NadufmOffline) return;
            const queue = await window.NadufmOffline.getQueue();
            const hasPendingNotice = queue.some(q => q.url && (q.url.indexOf('/api/portal/notices') !== -1 || q.url.indexOf('/api/portal/headline') !== -1));
            if (!navigator.onLine || hasPendingNotice) {
                const snap = await window.NadufmOffline.getSnapshot('bootstrap');
                if (snap && snap.notices && Array.isArray(snap.notices.notices)) {
                    noticesList = snap.notices.notices.map(n => ({
                        id: n.id,
                        notice_date: n.date || n.notice_date || '',
                        subject: n.subject || '',
                        description: n.description || '',
                        link: n.link || '',
                        is_new: n.isNew || n.is_new || 'no',
                    }));
                    renderNoticesTable();
                }
                if (snap && snap.notices && Array.isArray(snap.notices.headlines) && snap.notices.headlines[0]) {
                    const hlInput = document.getElementById('headline_text');
                    if (hlInput && !hlInput.value) hlInput.value = snap.notices.headlines[0].subject || '';
                }
            }
        }

        window.addEventListener('nadufm:sync-status', function (ev) {
            if (ev && ev.detail && ev.detail.type === 'BOOTSTRAP_REFRESHED') {
                hydrateOfflineNotices();
            }
        });

        renderNoticesTable();
        hydrateOfflineNotices();
    </script>
    <script src="/pwa.js" defer></script>
</body>
</html>
