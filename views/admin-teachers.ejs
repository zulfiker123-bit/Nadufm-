<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>শিক্ষক ও কর্মচারী ব্যবস্থাপনা</title>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Hind Siliguri', sans-serif; background: #f6f8f7; color: #0f172a; padding: 18px; }
        .wrap { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 340px 1fr; gap: 18px; align-items: start; }
        .card { background: #fff; border: 1px solid rgba(15,23,42,0.08); border-radius: 14px; padding: 20px; }
        .card h2 { font-size: 1.06rem; font-weight: 700; color: #14532d; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(15,23,42,0.08); }
        .field { margin-bottom: 12px; }
        .field label { display: block; font-size: 0.86rem; font-weight: 600; color: #334155; margin-bottom: 4px; }
        .field input { width: 100%; height: 40px; padding: 0 12px; border: 1px solid rgba(15,23,42,0.14); border-radius: 9px; background: #f8faf9; font-family: inherit; font-size: 0.92rem; outline: none; }
        .field input:focus { border-color: #15803d; background: #fff; }
        .btn { min-height: 42px; padding: 0 16px; border: none; border-radius: 9px; font-family: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
        .btn-primary { width: 100%; background: #15803d; color: #fff; }
        .btn-primary:hover { background: #14532d; }
        .btn-cancel { width: 100%; margin-top: 8px; background: #f1f5f9; color: #475569; display: none; }
        .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
        .search-input { height: 38px; padding: 0 12px; border: 1px solid rgba(15,23,42,0.14); border-radius: 9px; min-width: 220px; font-family: inherit; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
        th { background: #f8faf9; color: #14532d; text-align: left; padding: 11px 12px; border-bottom: 1px solid rgba(15,23,42,0.09); white-space: nowrap; }
        td { padding: 10px 12px; border-bottom: 1px solid rgba(15,23,42,0.06); vertical-align: middle; }
        .avatar { width: 38px; height: 38px; border-radius: 8px; object-fit: cover; border: 1px solid rgba(15,23,42,0.1); }
        .act-group { display: flex; gap: 6px; justify-content: flex-end; }
        .act-btn { padding: 5px 10px; border-radius: 7px; border: 1px solid transparent; font-family: inherit; font-size: 0.82rem; font-weight: 600; cursor: pointer; }
        .act-edit { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
        .act-del { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
        .status-msg { padding: 9px 12px; border-radius: 9px; font-size: 0.88rem; font-weight: 600; margin-bottom: 12px; display: none; background: #dcfce7; color: #166534; }
        @media (max-width: 920px) { .wrap { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="card">
            <h2 id="formHeading">নতুন শিক্ষক / কর্মচারী যুক্ত করুন</h2>
            <div id="statusMsg" class="status-msg"></div>
            <form id="teacherForm">
                <input type="hidden" id="teacherId">
                <div class="field">
                    <label for="tName">নাম</label>
                    <input type="text" id="tName" required placeholder="সম্পূর্ণ নাম লিখুন">
                </div>
                <div class="field">
                    <label for="tDesg">পদবি</label>
                    <input type="text" id="tDesg" required placeholder="যেমন: সহকারি শিক্ষক">
                </div>
                <div class="field">
                    <label for="tSubject">বিষয় / শাখা</label>
                    <input type="text" id="tSubject" placeholder="যেমন: আরবি / বাংলা">
                </div>
                <div class="field">
                    <label for="tIndex">ইনডেক্স নম্বর</label>
                    <input type="text" id="tIndex" placeholder="যেমন: M0041854">
                </div>
                <div class="field">
                    <label for="tMpo">এমপিও তারিখ</label>
                    <input type="text" id="tMpo" placeholder="যেমন: ২০২৩-১০-০১">
                </div>
                <div class="field">
                    <label for="tMobile">মোবাইল নম্বর</label>
                    <input type="text" id="tMobile" placeholder="017...">
                </div>
                <div class="field">
                    <label for="tPhoto">ছবির ফাইল/লিংক</label>
                    <input type="text" id="tPhoto" placeholder="logo.png বা ছবির URL">
                </div>
                <button type="submit" class="btn btn-primary" id="saveBtn">সংরক্ষণ করুন</button>
                <button type="button" class="btn btn-cancel" id="cancelEditBtn" onclick="resetForm()">বাতিল করুন</button>
            </form>
        </div>

        <div class="card">
            <div class="toolbar">
                <h2 style="margin:0; border:none; padding:0;">শিক্ষক ও কর্মচারী তালিকা (<span id="totalCount">০</span>)</h2>
                <input type="search" id="searchBox" class="search-input" placeholder="নাম, পদবি বা মোবাইল খুঁজুন..." oninput="renderTable()">
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ছবি</th>
                            <th>নাম ও পদবি</th>
                            <th>বিষয়</th>
                            <th>ইনডেক্স ও মোবাইল</th>
                            <th style="text-align:right;">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody id="teachersBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        let teachers = <%- JSON.stringify(teachers || []) %>;

        function bnNum(v) {
            const d = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
            return String(v).replace(/[0-9]/g, ch => d[Number(ch)]);
        }

        function esc(s) {
            return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
        }

        function showStatus(msg) {
            const el = document.getElementById('statusMsg');
            el.textContent = msg;
            el.style.display = 'block';
            setTimeout(() => { el.style.display = 'none'; }, 3500);
        }

        function renderTable() {
            const q = (document.getElementById('searchBox').value || '').trim().toLowerCase();
            const list = teachers.filter(t => {
                const hay = `${t.name} ${t.designation} ${t.subject} ${t.index_no} ${t.mobile}`.toLowerCase();
                return !q || hay.includes(q);
            });
            document.getElementById('totalCount').textContent = bnNum(list.length);
            const tbody = document.getElementById('teachersBody');
            if (!list.length) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:24px; color:#64748b;">কোনো তথ্য পাওয়া যায়নি।</td></tr>';
                return;
            }
            tbody.innerHTML = list.map(t => {
                const photoSrc = t.photo && /^https?:\/\//i.test(t.photo) ? t.photo : ('/' + (t.photo || 'logo.png'));
                return `
                    <tr>
                        <td><img src="${esc(photoSrc)}" alt="${esc(t.name)}" class="avatar" onerror="this.src='/logo.png'"></td>
                        <td>
                            <div style="font-weight:700; color:#0f172a;">${esc(t.name)}</div>
                            <div style="font-size:0.82rem; color:#475569;">${esc(t.designation)}</div>
                        </td>
                        <td>${esc(t.subject || '—')}</td>
                        <td>
                            <div>${esc(t.index_no || '—')}</div>
                            <div style="font-size:0.82rem; color:#475569;">${esc(t.mobile || '—')}</div>
                        </td>
                        <td>
                            <div class="act-group">
                                <button type="button" class="act-btn act-edit" onclick="editTeacher('${esc(t.id)}')">এডিট</button>
                                <button type="button" class="act-btn act-del" onclick="deleteTeacher('${esc(t.id)}')">ডিলিট</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function editTeacher(id) {
            const t = teachers.find(x => x.id === id);
            if (!t) return;
            document.getElementById('teacherId').value = t.id;
            document.getElementById('tName').value = t.name || '';
            document.getElementById('tDesg').value = t.designation || '';
            document.getElementById('tSubject').value = t.subject || '';
            document.getElementById('tIndex').value = t.index_no || '';
            document.getElementById('tMpo').value = t.mpo_date || '';
            document.getElementById('tMobile').value = t.mobile || '';
            document.getElementById('tPhoto').value = t.photo || '';
            document.getElementById('formHeading').textContent = 'শিক্ষকের তথ্য এডিট করুন';
            document.getElementById('saveBtn').textContent = 'আপডেট করুন';
            document.getElementById('cancelEditBtn').style.display = 'inline-flex';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            document.getElementById('teacherForm').reset();
            document.getElementById('teacherId').value = '';
            document.getElementById('formHeading').textContent = 'নতুন শিক্ষক / কর্মচারী যুক্ত করুন';
            document.getElementById('saveBtn').textContent = 'সংরক্ষণ করুন';
            document.getElementById('cancelEditBtn').style.display = 'none';
        }

        async function deleteTeacher(id) {
            const res = await fetch('/api/portal/teachers/' + encodeURIComponent(id), { method: 'DELETE' });
            const data = await res.json();
            if (res.ok && data.teachers) {
                teachers = data.teachers;
                renderTable();
                showStatus('তালিকা থেকে মুছে ফেলা হয়েছে।');
            }
        }

        document.getElementById('teacherForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const payload = {
                id: document.getElementById('teacherId').value || undefined,
                name: document.getElementById('tName').value.trim(),
                designation: document.getElementById('tDesg').value.trim(),
                subject: document.getElementById('tSubject').value.trim(),
                index_no: document.getElementById('tIndex').value.trim(),
                mpo_date: document.getElementById('tMpo').value.trim(),
                mobile: document.getElementById('tMobile').value.trim(),
                photo: document.getElementById('tPhoto').value.trim() || 'logo.png',
            };
            const res = await fetch('/api/portal/teachers', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (res.ok && data.teachers) {
                teachers = data.teachers;
                resetForm();
                renderTable();
                showStatus('শিক্ষক তথ্য সফলভাবে সংরক্ষণ করা হয়েছে।');
            }
        });

        renderTable();
    </script>
</body>
</html>
