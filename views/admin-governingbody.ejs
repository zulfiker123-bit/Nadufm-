<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>গভর্নিং বডি ব্যবস্থাপনা</title>
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#15803d">
    <link rel="stylesheet" href="/fonts.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Kalpurush', sans-serif; background: #f6f8f7; color: #0f172a; padding: 18px; }
        .wrap { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 360px 1fr; gap: 18px; align-items: start; }
        .left-stack { display: flex; flex-direction: column; gap: 16px; }
        .card { background: #fff; border: 1px solid rgba(15,23,42,0.08); border-radius: 14px; padding: 20px; }
        .card h2 { font-size: 1.06rem; font-weight: 700; color: #14532d; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(15,23,42,0.08); }
        .field { margin-bottom: 12px; }
        .field label { display: block; font-size: 0.86rem; font-weight: 600; color: #334155; margin-bottom: 4px; }
        .field input { width: 100%; height: 40px; padding: 0 12px; border: 1px solid rgba(15,23,42,0.14); border-radius: 9px; background: #f8faf9; font-family: inherit; font-size: 0.92rem; outline: none; }
        .field input:focus { border-color: #15803d; background: #fff; }
        .btn { min-height: 42px; padding: 0 16px; border: 1px solid transparent; border-radius: 10px; font-family: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease; }
        .btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
        .btn:active { transform: translateY(2px); }
        .btn-primary { width: 100%; background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%); color: #fff; border-color: #146c34; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 3.5px 0 #0e5427, 0 6px 14px -3px rgba(21,128,61,0.3); }
        .btn-primary:active { box-shadow: 0 1px 0 #0e5427; }
        .btn-secondary { width: 100%; background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%); color: #fff; border-color: #1e40af; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 3.5px 0 #1e3a8a, 0 6px 14px -3px rgba(29,78,216,0.25); }
        .btn-cancel { width: 100%; margin-top: 8px; background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%); color: #475569; border-color: rgba(15,23,42,0.14); box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15,23,42,0.1); display: none; }
        .btn-cancel:active { box-shadow: 0 1px 0 rgba(15,23,42,0.1); }
        .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
        .search-input { height: 38px; padding: 0 12px; border: 1px solid rgba(15,23,42,0.14); border-radius: 9px; min-width: 220px; font-family: inherit; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
        th { background: #f8faf9; color: #14532d; text-align: left; padding: 11px 12px; border-bottom: 1px solid rgba(15,23,42,0.09); white-space: nowrap; }
        td { padding: 10px 12px; border-bottom: 1px solid rgba(15,23,42,0.06); vertical-align: middle; }
        .serial-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 30px; height: 28px; padding: 0 8px; border-radius: 8px; background: #f0fdf4; color: #15803d; font-weight: 700; border: 1px solid rgba(21,128,61,0.18); }
        .act-group { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: nowrap; }
        .act-btn { padding: 5px 10px; border-radius: 8px; border: 1px solid transparent; font-family: inherit; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: transform 0.13s ease, box-shadow 0.13s ease; }
        .act-btn:hover:not(:disabled) { transform: translateY(-1px); }
        .act-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .act-move { background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%); color: #334155; border-color: #cbd5e1; }
        .act-edit { background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%); color: #1d4ed8; border-color: #93c5fd; box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(29, 78, 216, 0.16); }
        .act-del { background: linear-gradient(180deg, #fef2f2 0%, #fee2e2 100%); color: #b91c1c; border-color: #fca5a5; box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(185, 28, 28, 0.16); }
        .status-msg { padding: 9px 12px; border-radius: 9px; font-size: 0.88rem; font-weight: 600; margin-bottom: 12px; display: none; background: #dcfce7; color: #166534; }
        .status-msg.is-err { background: #fee2e2; color: #b91c1c; }
        .meta-preview { margin-bottom: 14px; padding: 12px 14px; border-radius: 10px; background: #f8faf9; border-left: 4px solid #15803d; font-size: 0.88rem; color: #334155; line-height: 1.55; }
        @media (max-width: 960px) { .wrap { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="left-stack">
            <div class="card">
                <h2>কমিটির তথ্য ও কার্যকাল</h2>
                <div id="metaStatusMsg" class="status-msg"></div>
                <form id="metaForm">
                    <div class="field">
                        <label for="gbInstName">মাদ্রাসার নাম</label>
                        <input type="text" id="gbInstName" required value="<%= governingBody.institutionName %>">
                    </div>
                    <div class="field">
                        <label for="gbTerm">কমিটির কার্যকাল</label>
                        <input type="text" id="gbTerm" required value="<%= governingBody.term %>">
                    </div>
                    <button type="submit" class="btn btn-secondary">তথ্য আপডেট করুন</button>
                </form>
            </div>

            <div class="card">
                <h2 id="formHeading">নতুন সদস্য যুক্ত করুন</h2>
                <div id="memberStatusMsg" class="status-msg"></div>
                <form id="memberForm">
                    <input type="hidden" id="memberId">
                    <div class="field">
                        <label for="mName">সদস্যের নাম</label>
                        <input type="text" id="mName" required placeholder="সম্পূর্ণ নাম লিখুন">
                    </div>
                    <div class="field">
                        <label for="mDesg">পদবী</label>
                        <input type="text" id="mDesg" required placeholder="যেমন: সভাপতি / বিদ্যোৎসাহী প্রতিনিধি">
                    </div>
                    <button type="submit" class="btn btn-primary" id="saveBtn">সংরক্ষণ করুন</button>
                    <button type="button" class="btn btn-cancel" id="cancelEditBtn" onclick="resetMemberForm()">বাতিল করুন</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="toolbar">
                <h2 style="margin:0; border:none; padding:0;">গভর্নিং বডি সদস্য তালিকা (<span id="totalCount">০</span> জন)</h2>
                <input type="search" id="searchBox" class="search-input" placeholder="নাম বা পদবী খুঁজুন..." oninput="renderTable()">
            </div>
            <div class="meta-preview">
                <div><strong>প্রতিষ্ঠান:</strong> <span id="previewInst"><%= governingBody.institutionName %></span></div>
                <div><strong>কার্যকাল:</strong> <span id="previewTerm"><%= governingBody.term %></span></div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ক্রম</th>
                            <th>সদস্যের নাম</th>
                            <th>পদবী</th>
                            <th style="text-align:right;">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody id="gbBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/offline-sync.js"></script>
    <script>
        let governingBody = <%- JSON.stringify(governingBody || { institutionName: '', term: '', members: [] }) %>;

        function bnNum(v) {
            const d = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
            return String(v).replace(/[0-9]/g, ch => d[Number(ch)]);
        }

        function esc(s) {
            return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
        }

        function showStatus(elId, msg, isErr) {
            const el = document.getElementById(elId);
            if (!el) return;
            el.textContent = msg;
            el.classList.toggle('is-err', Boolean(isErr));
            el.style.display = 'block';
            setTimeout(() => { el.style.display = 'none'; }, 3800);
        }

        function renderMeta() {
            document.getElementById('gbInstName').value = governingBody.institutionName || '';
            document.getElementById('gbTerm').value = governingBody.term || '';
            document.getElementById('previewInst').textContent = governingBody.institutionName || '';
            document.getElementById('previewTerm').textContent = governingBody.term || '';
        }

        function renderTable() {
            const q = (document.getElementById('searchBox').value || '').trim().toLowerCase();
            const members = Array.isArray(governingBody.members) ? governingBody.members : [];
            const filtered = members.map((m, idx) => ({ m, idx })).filter(({ m }) => {
                const hay = `${m.name || ''} ${m.designation || ''}`.toLowerCase();
                return !q || hay.includes(q);
            });
            document.getElementById('totalCount').textContent = bnNum(members.length);
            const tbody = document.getElementById('gbBody');
            if (!filtered.length) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:24px; color:#64748b;">কোনো সদস্য পাওয়া যায়নি।</td></tr>';
                return;
            }
            const isSearching = Boolean(q);
            tbody.innerHTML = filtered.map(({ m, idx }) => `
                <tr>
                    <td><span class="serial-badge">${bnNum(idx + 1)}</span></td>
                    <td style="font-weight:700; color:#0f172a;">${esc(m.name)}</td>
                    <td style="color:#334155;">${esc(m.designation)}</td>
                    <td>
                        <div class="act-group">
                            <button type="button" class="act-btn act-move" title="উপরে তুলুন" onclick="moveMember('${esc(m.id)}', 'up')" ${isSearching || idx === 0 ? 'disabled' : ''}>▲</button>
                            <button type="button" class="act-btn act-move" title="নিচে নামান" onclick="moveMember('${esc(m.id)}', 'down')" ${isSearching || idx === members.length - 1 ? 'disabled' : ''}>▼</button>
                            <button type="button" class="act-btn act-edit" onclick="editMember('${esc(m.id)}')">এডিট</button>
                            <button type="button" class="act-btn act-del" onclick="deleteMember('${esc(m.id)}')">ডিলিট</button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function editMember(id) {
            const m = (governingBody.members || []).find(x => String(x.id) === String(id));
            if (!m) return;
            document.getElementById('memberId').value = m.id;
            document.getElementById('mName').value = m.name || '';
            document.getElementById('mDesg').value = m.designation || '';
            document.getElementById('formHeading').textContent = 'সদস্যের তথ্য এডিট করুন';
            document.getElementById('saveBtn').textContent = 'আপডেট করুন';
            document.getElementById('cancelEditBtn').style.display = 'inline-flex';
            document.getElementById('mName').focus();
        }

        function resetMemberForm() {
            document.getElementById('memberForm').reset();
            document.getElementById('memberId').value = '';
            document.getElementById('formHeading').textContent = 'নতুন সদস্য যুক্ত করুন';
            document.getElementById('saveBtn').textContent = 'সংরক্ষণ করুন';
            document.getElementById('cancelEditBtn').style.display = 'none';
        }

        async function moveMember(id, direction) {
            const members = (governingBody.members || []).slice();
            const idx = members.findIndex(x => String(x.id) === String(id));
            if (idx === -1) return;
            const targetIdx = direction === 'up' ? idx - 1 : idx + 1;
            if (targetIdx < 0 || targetIdx >= members.length) return;
            const tmp = members[idx];
            members[idx] = members[targetIdx];
            members[targetIdx] = tmp;

            if (window.NadufmOffline) {
                const res = await window.NadufmOffline.saveMutationOrQueue({
                    label: 'গভর্নিং বডি ক্রম পরিবর্তন',
                    url: '/api/portal/governingbody/members/move',
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, direction }),
                    optimisticUpdate: () => window.NadufmOffline.updateBootstrap(base => {
                        base.governingBody = Object.assign({}, governingBody, { members });
                        return base;
                    }),
                    onOnlineSuccess: (data) => {
                        if (data && data.governingBody) {
                            governingBody = data.governingBody;
                            return window.NadufmOffline.updateBootstrap(base => {
                                base.governingBody = data.governingBody;
                                return base;
                            });
                        }
                    },
                });
                if (res.queued) {
                    governingBody.members = members;
                    renderTable();
                    showStatus('memberStatusMsg', 'অফলাইনে ক্রম সংরক্ষিত হয়েছে — অনলাইনে অটো সিঙ্ক হবে।');
                    return;
                }
                renderTable();
                return;
            }

            const res = await fetch('/api/portal/governingbody/members/move', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, direction }),
            });
            const data = await res.json();
            if (res.ok && data.governingBody) {
                governingBody = data.governingBody;
                renderTable();
            }
        }

        async function deleteMember(id) {
            const nextMembers = (governingBody.members || []).filter(m => String(m.id) !== String(id));
            if (window.NadufmOffline) {
                const res = await window.NadufmOffline.saveMutationOrQueue({
                    label: 'গভর্নিং বডি সদস্য ডিলিট',
                    url: '/api/portal/governingbody/members/' + encodeURIComponent(id),
                    method: 'DELETE',
                    headers: {},
                    optimisticUpdate: () => window.NadufmOffline.updateBootstrap(base => {
                        base.governingBody = Object.assign({}, governingBody, { members: nextMembers });
                        return base;
                    }),
                    onOnlineSuccess: (data) => {
                        if (data && data.governingBody) {
                            governingBody = data.governingBody;
                            return window.NadufmOffline.updateBootstrap(base => {
                                base.governingBody = data.governingBody;
                                return base;
                            });
                        }
                    },
                });
                if (res.queued) {
                    governingBody.members = nextMembers;
                    renderTable();
                    showStatus('memberStatusMsg', 'অফলাইনে ডিলিট সংরক্ষিত হয়েছে — অনলাইনে অটো সিঙ্ক হবে।');
                    return;
                }
                renderTable();
                showStatus('memberStatusMsg', 'সদস্য তালিকা থেকে মুছে ফেলা হয়েছে।');
                return;
            }

            const res = await fetch('/api/portal/governingbody/members/' + encodeURIComponent(id), { method: 'DELETE' });
            const data = await res.json();
            if (res.ok && data.governingBody) {
                governingBody = data.governingBody;
                renderTable();
                showStatus('memberStatusMsg', 'সদস্য তালিকা থেকে মুছে ফেলা হয়েছে।');
            }
        }

        document.getElementById('metaForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const payload = {
                institutionName: document.getElementById('gbInstName').value.trim(),
                term: document.getElementById('gbTerm').value.trim(),
            };
            if (!payload.institutionName || !payload.term) {
                showStatus('metaStatusMsg', 'মাদ্রাসার নাম ও কার্যকাল পূরণ করুন।', true);
                return;
            }
            if (window.NadufmOffline) {
                const res = await window.NadufmOffline.saveMutationOrQueue({
                    label: 'গভর্নিং বডি তথ্য আপডেট',
                    url: '/api/portal/governingbody/meta',
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    optimisticUpdate: () => window.NadufmOffline.updateBootstrap(base => {
                        base.governingBody = Object.assign({}, governingBody, payload);
                        return base;
                    }),
                    onOnlineSuccess: (data) => {
                        if (data && data.governingBody) {
                            governingBody = data.governingBody;
                            return window.NadufmOffline.updateBootstrap(base => {
                                base.governingBody = data.governingBody;
                                return base;
                            });
                        }
                    },
                });
                if (res.queued) {
                    governingBody = Object.assign({}, governingBody, payload);
                    renderMeta();
                    showStatus('metaStatusMsg', 'অফলাইনে সংরক্ষিত হয়েছে — অনলাইনে অটো সিঙ্ক হবে।');
                    return;
                }
                renderMeta();
                showStatus('metaStatusMsg', 'কমিটির তথ্য সফলভাবে আপডেট হয়েছে।');
                return;
            }

            const res = await fetch('/api/portal/governingbody/meta', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (res.ok && data.governingBody) {
                governingBody = data.governingBody;
                renderMeta();
                showStatus('metaStatusMsg', 'কমিটির তথ্য সফলভাবে আপডেট হয়েছে।');
            }
        });

        document.getElementById('memberForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const existingId = document.getElementById('memberId').value;
            const payload = {
                id: existingId || undefined,
                name: document.getElementById('mName').value.trim(),
                designation: document.getElementById('mDesg').value.trim(),
            };
            if (!payload.name || !payload.designation) {
                showStatus('memberStatusMsg', 'সদস্যের নাম ও পদবী আবশ্যক।', true);
                return;
            }
            const currentMembers = Array.isArray(governingBody.members) ? governingBody.members : [];
            const tempRecord = Object.assign({ id: existingId || ('gb_local_' + Date.now()) }, payload);
            const optimisticMembers = existingId
                ? currentMembers.map(m => (String(m.id) === String(existingId) ? Object.assign({}, m, tempRecord) : m))
                : currentMembers.concat([tempRecord]);

            if (window.NadufmOffline) {
                const res = await window.NadufmOffline.saveMutationOrQueue({
                    label: 'গভর্নিং বডি সদস্য সংরক্ষণ (' + payload.name + ')',
                    url: '/api/portal/governingbody/members',
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    optimisticUpdate: () => window.NadufmOffline.updateBootstrap(base => {
                        base.governingBody = Object.assign({}, governingBody, { members: optimisticMembers });
                        return base;
                    }),
                    onOnlineSuccess: (data) => {
                        if (data && data.governingBody) {
                            governingBody = data.governingBody;
                            return window.NadufmOffline.updateBootstrap(base => {
                                base.governingBody = data.governingBody;
                                return base;
                            });
                        }
                    },
                });
                if (res.queued) {
                    governingBody.members = optimisticMembers;
                    resetMemberForm();
                    renderTable();
                    showStatus('memberStatusMsg', 'অফলাইনে সংরক্ষিত হয়েছে — অনলাইনে অটো সিঙ্ক হবে।');
                    return;
                }
                resetMemberForm();
                renderTable();
                showStatus('memberStatusMsg', 'সদস্যের তথ্য সফলভাবে সংরক্ষণ করা হয়েছে।');
                return;
            }

            const res = await fetch('/api/portal/governingbody/members', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (res.ok && data.governingBody) {
                governingBody = data.governingBody;
                resetMemberForm();
                renderTable();
                showStatus('memberStatusMsg', 'সদস্যের তথ্য সফলভাবে সংরক্ষণ করা হয়েছে।');
            }
        });

        async function hydrateOfflineGoverningBody() {
            if (!window.NadufmOffline) return;
            const queue = await window.NadufmOffline.getQueue();
            const hasPending = queue.some(q => q.url && q.url.indexOf('/api/portal/governingbody') !== -1);
            if (!navigator.onLine || hasPending) {
                const snap = await window.NadufmOffline.getSnapshot('bootstrap');
                if (snap && snap.governingBody) {
                    governingBody = snap.governingBody;
                    renderMeta();
                    renderTable();
                }
            }
        }

        window.addEventListener('nadufm:sync-status', function (ev) {
            if (ev && ev.detail && ev.detail.type === 'BOOTSTRAP_REFRESHED') {
                hydrateOfflineGoverningBody();
            }
        });

        renderMeta();
        renderTable();
        hydrateOfflineGoverningBody();
    </script>
    <script src="/pwa.js" defer></script>
</body>
</html>
