<%- include('partials/header') %>
<style>
    .gb-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        font-family: 'Kalpurush', sans-serif;
    }
    .gb-table th, .gb-table td {
        border: 1px solid #ddd;
        padding: 10px;
        text-align: left;
    }
    .gb-table th {
        background-color: #4CAF50;
        color: white;
        text-align: center;
    }
    .gb-table tr:nth-child(even) {
        background-color: #f2f2f2;
    }
    .gb-table tr:hover {
        background-color: #ddd;
    }
    .committee-info {
        background: #f9f9f9;
        padding: 15px;
        border-left: 5px solid green;
        margin-bottom: 20px;
    }
</style>

<main>
    <section id="notice-section">
        <h2 style="text-align: center; color: green; margin-top: 20px;">গভর্নিং বডি</h2>

        <div class="committee-info">
            <p><strong>মাদ্রাসার নাম:</strong> <span id="gbInstitutionNameText"><%= governingBody && governingBody.institutionName ? governingBody.institutionName : 'নলতা আহ্ছানিয়া দারুল উলূম ফাযিল মাদ্রাসা, সাতক্ষীরা।' %></span></p>
            <p><strong>কার্যকাল:</strong> <span id="gbTenureText"><%= governingBody && governingBody.tenure ? governingBody.tenure : '২৫.০৪.২০২৫ হতে ২৪.০৪.২০২৮ খ্রি: পর্যন্ত (০৩ বছর)।' %></span></p>
        </div>

        <table class="gb-table">
            <thead>
                <tr>
                    <th>ক্রম</th>
                    <th>সদস্যগণের নাম</th>
                    <th>পদবী</th>
                </tr>
            </thead>
            <tbody id="gbMembersBody">
                <% const gbMembers = (governingBody && Array.isArray(governingBody.members)) ? governingBody.members : []; %>
                <% if (gbMembers.length === 0) { %>
                    <tr><td colspan="3" align="center">কোনো সদস্যের তথ্য পাওয়া যায়নি।</td></tr>
                <% } else { %>
                    <% gbMembers.forEach(function (member, idx) { %>
                        <tr>
                            <td align="center"><%= convertToBengali(idx + 1) %></td>
                            <td><%= member.name %></td>
                            <td><%= member.designation %></td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<script>
    (function () {
        function escHtml(s) {
            return String(s || '').replace(/[&<>"']/g, function (m) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
            });
        }
        function renderGbSnapshot(gb) {
            if (!gb || typeof gb !== 'object') return;
            var nameEl = document.getElementById('gbInstitutionNameText');
            var tenureEl = document.getElementById('gbTenureText');
            var tbody = document.getElementById('gbMembersBody');
            if (nameEl && gb.institutionName) nameEl.textContent = gb.institutionName;
            if (tenureEl && gb.tenure) tenureEl.textContent = gb.tenure;
            if (tbody && Array.isArray(gb.members)) {
                if (!gb.members.length) {
                    tbody.innerHTML = '<tr><td colspan="3" align="center">কোনো সদস্যের তথ্য পাওয়া যায়নি।</td></tr>';
                } else {
                    tbody.innerHTML = gb.members.map(function (m, idx) {
                        var bn = window.NadufmOffline ? window.NadufmOffline.bnNum(idx + 1) : String(idx + 1);
                        return '<tr><td align="center">' + escHtml(bn) + '</td><td>' + escHtml(m.name) + '</td><td>' + escHtml(m.designation) + '</td></tr>';
                    }).join('');
                }
            }
        }
        function refreshGbFromOffline() {
            if (!window.NadufmOffline) return;
            window.NadufmOffline.getSnapshot('bootstrap').then(function (snap) {
                if (snap && snap.governingBody) renderGbSnapshot(snap.governingBody);
            });
        }
        document.addEventListener('DOMContentLoaded', refreshGbFromOffline);
        window.addEventListener('nadufm:sync-status', function (ev) {
            if (ev && ev.detail && (ev.detail.type === 'BOOTSTRAP_REFRESHED' || ev.detail.type === 'QUEUE_UPDATED' || ev.detail.type === 'SYNC_COMPLETED')) {
                refreshGbFromOffline();
            }
        });
    })();
</script>

<%- include('partials/footer') %>

