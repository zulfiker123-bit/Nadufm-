<%- include('partials/header') %>
<style>
    .gb-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        font-family: 'Kalpurush', sans-serif;
    }
    .gb-table th, .gb-table td {
        border: 1px solid #ddd;
        padding: 10px;
        text-align: left;
    }
    .gb-table th {
        background-color: #4CAF50;
        color: white;
        text-align: center;
    }
    .gb-table tr:nth-child(even) {
        background-color: #f2f2f2;
    }
    .gb-table tr:hover {
        background-color: #ddd;
    }
    .committee-info {
        background: #f9f9f9;
        padding: 15px;
        border-left: 5px solid green;
        margin-bottom: 20px;
    }
</style>

<main>
    <section id="notice-section">
        <h2 style="text-align: center; color: green; margin-top: 20px;">গভর্নিং বডি</h2>

        <div class="committee-info">
            <p><strong>মাদ্রাসার নাম:</strong> <span id="gbPublicInst"><%= governingBody.institutionName %></span></p>
            <p><strong>কার্যকাল:</strong> <span id="gbPublicTerm"><%= governingBody.term %></span></p>
        </div>

        <table class="gb-table">
            <thead>
                <tr>
                    <th>ক্রম</th>
                    <th>সদস্যগণের নাম</th>
                    <th>পদবী</th>
                </tr>
            </thead>
            <tbody id="gbPublicBody">
                <% (governingBody.members || []).forEach(function(member, idx) { %>
                    <tr>
                        <td align="center"><%= convertToBengali(idx + 1) %></td>
                        <td><%= member.name %></td>
                        <td><%= member.designation %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </section>
</main>

<script>
    (function () {
        function esc(s) {
            return String(s || '').replace(/[&<>"']/g, function (m) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
            });
        }
        function bnNum(v) {
            var d = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
            return String(v).replace(/[0-9]/g, function (ch) { return d[Number(ch)]; });
        }
        function renderPublicGb(gb) {
            if (!gb || !Array.isArray(gb.members)) return;
            var instEl = document.getElementById('gbPublicInst');
            var termEl = document.getElementById('gbPublicTerm');
            var tbody = document.getElementById('gbPublicBody');
            if (instEl && gb.institutionName) instEl.textContent = gb.institutionName;
            if (termEl && gb.term) termEl.textContent = gb.term;
            if (tbody) {
                tbody.innerHTML = gb.members.map(function (m, idx) {
                    return '<tr><td align="center">' + bnNum(idx + 1) + '</td><td>' + esc(m.name) + '</td><td>' + esc(m.designation) + '</td></tr>';
                }).join('');
            }
        }
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.NadufmOffline) return;
            window.NadufmOffline.getSnapshot('bootstrap').then(function (snap) {
                if (snap && snap.governingBody) {
                    renderPublicGb(snap.governingBody);
                }
            });
        });
    })();
</script>

<%- include('partials/footer') %>
