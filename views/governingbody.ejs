<%- include('partials/header') %>
<style>
    .gb-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        font-family: 'Kalpurush', sans-serif;
    }
    .gb-table th, .gb-table td {
        border: 1px solid #ddd;
        padding: 10px;
        text-align: left;
    }
    .gb-table th {
        background-color: #4CAF50;
        color: white;
        text-align: center;
    }
    .gb-table tr:nth-child(even) {
        background-color: #f2f2f2;
    }
    .gb-table tr:hover {
        background-color: #ddd;
    }
    .committee-info {
        background: #f9f9f9;
        padding: 15px;
        border-left: 5px solid green;
        margin-bottom: 20px;
    }
</style>

<main>
    <section id="notice-section">
        <h2 style="text-align: center; color: green; margin-top: 20px;">গভর্নিং বডি</h2>

        <div class="committee-info">
            <p><strong>মাদ্রাসার নাম:</strong> <span id="gbPublicInst"><%= governingBody?.institutionName || 'নলতা আহ্ছানিয়া দারুল উলূম ফাযিল মাদ্রাসা, সাতক্ষীরা।' %></span></p>
            <p><strong>কার্যকাল:</strong> <span id="gbPublicTenure"><%= governingBody?.tenure || '২৫.০৪.২০২৫ হতে ২৪.০৪.২০২৮ খ্রি: পর্যন্ত (০৩ বছর)।' %></span></p>
        </div>

        <table class="gb-table">
            <thead>
                <tr>
                    <th>ক্রম</th>
                    <th>সদস্যগণের নাম</th>
                    <th>পদবী</th>
                </tr>
            </thead>
            <tbody id="gbPublicBody">
                <%
                    const gbMembers = Array.isArray(governingBody?.members)
                        ? governingBody.members.slice().sort((a, b) => (Number(a.order) || 9999) - (Number(b.order) || 9999))
                        : [];
                %>
                <% if (gbMembers.length) { %>
                    <% gbMembers.forEach((member, idx) => { %>
                        <tr>
                            <td align="center"><%= convertToBengali(Number(member.order) || (idx + 1)) %></td>
                            <td><%= member.name %></td>
                            <td><%= member.designation %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="3" align="center">কোনো সদস্যের তথ্য পাওয়া যায়নি।</td></tr>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<script>
    (function () {
        function escHtml(s) {
            return String(s || '').replace(/[&<>"']/g, function (m) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
            });
        }
        function renderGbFromSnap(gb) {
            if (!gb || !Array.isArray(gb.members)) return;
            var instEl = document.getElementById('gbPublicInst');
            var tenureEl = document.getElementById('gbPublicTenure');
            var tbody = document.getElementById('gbPublicBody');
            if (instEl && gb.institutionName) instEl.textContent = gb.institutionName;
            if (tenureEl && gb.tenure) tenureEl.textContent = gb.tenure;
            if (!tbody) return;
            var sorted = gb.members.slice().sort(function (a, b) {
                return (Number(a.order) || 9999) - (Number(b.order) || 9999);
            });
            if (!sorted.length) {
                tbody.innerHTML = '<tr><td colspan="3" align="center">কোনো সদস্যের তথ্য পাওয়া যায়নি।</td></tr>';
                return;
            }
            tbody.innerHTML = sorted.map(function (m, idx) {
                var ord = Number(m.order) || (idx + 1);
                var ordBn = window.NadufmOffline ? window.NadufmOffline.bnNum(ord) : String(ord);
                return '<tr><td align="center">' + escHtml(ordBn) + '</td><td>' + escHtml(m.name) + '</td><td>' + escHtml(m.designation) + '</td></tr>';
            }).join('');
        }
        async function hydrateGb() {
            if (!window.NadufmOffline) return;
            var queue = await window.NadufmOffline.getQueue();
            var hasPending = queue.some(function (q) { return q.url && q.url.indexOf('/api/portal/governing-body') !== -1; });
            if (!navigator.onLine || hasPending) {
                var snap = await window.NadufmOffline.getSnapshot('bootstrap');
                if (snap && snap.governingBody) renderGbFromSnap(snap.governingBody);
            }
        }
        window.addEventListener('nadufm:sync-status', function (ev) {
            if (ev && ev.detail && ev.detail.type === 'BOOTSTRAP_REFRESHED') hydrateGb();
        });
        hydrateGb();
    })();
</script>

<%- include('partials/footer') %>
