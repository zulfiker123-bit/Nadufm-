<%- include('partials/header') %>
<style>
    .gb-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        font-family: 'Kalpurush', sans-serif;
    }
    .gb-table th, .gb-table td {
        border: 1px solid #ddd;
        padding: 10px;
        text-align: left;
    }
    .gb-table th {
        background-color: #4CAF50;
        color: white;
        text-align: center;
    }
    .gb-table tr:nth-child(even) {
        background-color: #f2f2f2;
    }
    .gb-table tr:hover {
        background-color: #ddd;
    }
    .committee-info {
        background: #f9f9f9;
        padding: 15px;
        border-left: 5px solid green;
        margin-bottom: 20px;
    }
</style>

<main>
    <section id="notice-section">
        <h2 style="text-align: center; color: green; margin-top: 20px;">গভর্নিং বডি</h2>

        <div class="committee-info">
            <p><strong>মাদ্রাসার নাম:</strong> <span id="gbMadrasahName"><%= (governingBodyInfo && governingBodyInfo.madrasahName) || 'নলতা আহ্ছানিয়া দারুল উলূম ফাযিল মাদ্রাসা, সাতক্ষীরা।' %></span></p>
            <p><strong>কার্যকাল:</strong> <span id="gbTenure"><%= (governingBodyInfo && governingBodyInfo.tenure) || '২৫.০৪.২০২৫ হতে ২৪.০৪.২০২৮ খ্রি: পর্যন্ত (০৩ বছর)।' %></span></p>
        </div>

        <table class="gb-table">
            <thead>
                <tr>
                    <th>ক্রম</th>
                    <th>সদস্যগণের নাম</th>
                    <th>পদবী</th>
                </tr>
            </thead>
            <tbody id="gbTableBody">
                <% const members = Array.isArray(governingBody) ? governingBody.slice().sort((a, b) => (Number(a.order) || 999) - (Number(b.order) || 999)) : []; %>
                <% if (members.length === 0) { %>
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 20px; color: #64748b;">গভর্নিং বডির কোনো তথ্য পাওয়া যায়নি।</td>
                    </tr>
                <% } else { %>
                    <% members.forEach(function(member, idx) { %>
                        <tr>
                            <td align="center"><%= convertToBengali(member.order || (idx + 1)) %></td>
                            <td><%= member.name %></td>
                            <td><%= member.designation %></td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </section>
</main>

<script>
    (function () {
        function escapeHtml(str) {
            return String(str || '').replace(/[&<>"']/g, function (m) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
            });
        }
        function bnNum(val) {
            var d = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
            return String(val == null ? '' : val).replace(/[0-9]/g, function (c) {
                return d[Number(c)];
            });
        }
        function renderFromBootstrap(snap) {
            if (!snap) return;
            if (snap.governingBodyInfo) {
                var nameEl = document.getElementById('gbMadrasahName');
                var tenureEl = document.getElementById('gbTenure');
                if (nameEl && snap.governingBodyInfo.madrasahName) {
                    nameEl.textContent = snap.governingBodyInfo.madrasahName;
                }
                if (tenureEl && snap.governingBodyInfo.tenure) {
                    tenureEl.textContent = snap.governingBodyInfo.tenure;
                }
            }
            if (Array.isArray(snap.governingBody)) {
                var tbody = document.getElementById('gbTableBody');
                if (!tbody) return;
                var sorted = snap.governingBody.slice().sort(function (a, b) {
                    return (Number(a.order) || 999) - (Number(b.order) || 999);
                });
                if (!sorted.length) {
                    tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 20px; color: #64748b;">গভর্নিং বডির কোনো তথ্য পাওয়া যায়নি।</td></tr>';
                    return;
                }
                tbody.innerHTML = sorted.map(function (m, idx) {
                    return '<tr><td align="center">' + escapeHtml(bnNum(m.order || (idx + 1))) + '</td><td>' + escapeHtml(m.name) + '</td><td>' + escapeHtml(m.designation) + '</td></tr>';
                }).join('');
            }
        }
        function hydrate() {
            if (!window.NadufmOffline) return;
            window.NadufmOffline.getSnapshot('bootstrap').then(renderFromBootstrap);
        }
        document.addEventListener('DOMContentLoaded', hydrate);
        window.addEventListener('nadufm:sync-status', function (ev) {
            var t = ev && ev.detail && ev.detail.type;
            if (t === 'BOOTSTRAP_REFRESHED' || t === 'QUEUE_UPDATED' || t === 'SYNC_COMPLETED') {
                hydrate();
            }
        });
    })();
</script>

<%- include('partials/footer') %>
