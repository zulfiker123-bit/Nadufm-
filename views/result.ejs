<%- include('partials/header') %>

<style>
    .result-shell {
        max-width: 900px;
        margin: 24px auto 36px auto;
        padding: 0 16px;
    }

    .result-search-card {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.09);
        border-radius: 18px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.07);
        overflow: hidden;
        max-width: 520px;
        margin: 0 auto;
    }

    .result-search-head {
        background: linear-gradient(135deg, #14532d 0%, #15803d 100%);
        color: #ffffff;
        padding: 26px 20px;
        text-align: center;
    }

    .result-search-head img {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: #ffffff;
        padding: 3px;
        margin: 0 auto 10px auto;
        display: block;
    }

    .result-search-head h1 {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
    }

    .result-search-head p {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-top: 4px;
    }

    .result-search-body {
        padding: 24px;
    }

    .result-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.92rem;
        font-weight: 600;
        text-align: center;
        margin-bottom: 18px;
    }

    .result-field {
        margin-bottom: 16px;
    }

    .result-field label {
        display: block;
        margin-bottom: 6px;
        font-size: 0.94rem;
        font-weight: 600;
        color: #0f172a;
    }

    .result-field select,
    .result-field input {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        border-radius: 10px;
        background: #f8faf9;
        color: #0f172a;
        font-size: 0.96rem;
        outline: none;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .result-field select:focus,
    .result-field input:focus {
        border-color: #15803d;
        background: #ffffff;
    }

    .result-btn-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 8px;
    }

    .result-field label {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .roll-auto-panel {
        margin-top: 10px;
        background: #f8faf9;
        border: 1px solid rgba(21, 128, 61, 0.22);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .roll-auto-title {
        font-size: 0.84rem;
        font-weight: 700;
        color: #14532d;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .roll-auto-select {
        height: 40px !important;
        background: #ffffff !important;
        margin-bottom: 8px;
        font-size: 0.9rem !important;
    }

    .roll-chips-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        max-height: 150px;
        overflow-y: auto;
    }

    .roll-chip-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 9px;
        border: 1px solid rgba(21, 128, 61, 0.25);
        background: linear-gradient(180deg, #ffffff 0%, #f4f9f6 100%);
        color: #0f172a;
        font-family: inherit;
        font-size: 0.84rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(21, 128, 61, 0.14);
        transition: transform 0.13s ease, box-shadow 0.13s ease, background 0.13s ease, color 0.13s ease;
    }

    .roll-chip-btn:hover,
    .roll-chip-btn.active {
        background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
        color: #ffffff;
        border-color: #146c34;
        transform: translateY(-1px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), 0 2.5px 0 #0e5427;
    }

    .roll-chip-btn:active { transform: translateY(1px); box-shadow: 0 1px 0 #0e5427; }

    .roll-empty-note { font-size: 0.83rem; color: #64748b; }

    .id-count-pill {
        font-size: 0.78rem;
        font-weight: 700;
        color: #15803d;
        background: #dcfce7;
        padding: 2px 8px;
        border-radius: 999px;
    }

    .r-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 17px;
        border-radius: 11px;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        white-space: nowrap;
        transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease;
    }

    .r-btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
    .r-btn:active { transform: translateY(2px); }
    .r-btn-primary { background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%); color: #ffffff; border-color: #146c34; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 3.5px 0 #0e5427, 0 6px 14px -3px rgba(21,128,61,0.3); }
    .r-btn-primary:active { box-shadow: 0 1px 0 #0e5427; }
    .r-btn-blue { background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border-color: #1e40af; box-shadow: inset 0 1px 0 rgba(255,255,255,0.26), 0 3.5px 0 #172f82, 0 6px 14px -3px rgba(29,78,216,0.3); }
    .r-btn-blue:active { box-shadow: 0 1px 0 #172f82; }
    .r-btn-rose { background: linear-gradient(180deg, #e11d48 0%, #be123c 100%); color: #ffffff; border-color: #9f1239; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 3.5px 0 #881337, 0 6px 14px -3px rgba(190,18,60,0.3); }
    .r-btn-rose:active { box-shadow: 0 1px 0 #881337; }
    .r-btn-secondary { background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%); color: #0f172a; border-color: rgba(15, 23, 42, 0.14); box-shadow: inset 0 1px 0 #ffffff, 0 3px 0 rgba(15,23,42,0.1), 0 5px 10px -3px rgba(15,23,42,0.08); }
    .r-btn-secondary:active { box-shadow: 0 1px 0 rgba(15,23,42,0.1); }

    .marksheet-controls {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.09);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .marksheet-toolbar {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .a4-style-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding-top: 10px;
        border-top: 1px solid rgba(15, 23, 42, 0.08);
        font-size: 0.88rem;
        color: #334155;
        font-variant-numeric: tabular-nums;
    }

    .a4-control-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .a4-control-item input[type="range"] {
        width: 110px;
        accent-color: #15803d;
    }

    .a4-preview-scroll {
        overflow-x: auto;
        padding-bottom: 8px;
    }

    .marksheet {
        background: #ffffff;
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 12mm;
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
        font-size: 14px;
        border: 1px solid rgba(15, 23, 42, 0.16);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

    .marksheet * {
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    .marksheet-inner {
        position: relative;
        border: 3px double #14532d;
        outline: 1px solid #b45309;
        outline-offset: -7px;
        padding: 16px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #ffffff;
    }

    .ms-watermark {
        position: absolute;
        left: 50%;
        top: 52%;
        transform: translate(-50%, -50%);
        width: 240px;
        height: 240px;
        object-fit: contain;
        opacity: 0.055;
        pointer-events: none;
        z-index: 0;
    }

    .ms-content-layer {
        position: relative;
        z-index: 1;
    }

    .ms-board-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 10px;
        border-bottom: 2px solid #14532d;
    }

    .ms-logo-col {
        width: 78px;
        flex-shrink: 0;
        text-align: center;
    }

    .ms-logo-col img {
        width: 64px;
        height: 64px;
        object-fit: contain;
    }

    .ms-eiin-tag {
        margin-top: 3px;
        font-size: 0.72em;
        font-weight: 700;
        color: #14532d;
        border: 1px solid rgba(20, 83, 45, 0.35);
        background: #f0fdf4;
        border-radius: 4px;
        padding: 1px 4px;
    }

    .ms-title-col {
        flex: 1;
        text-align: center;
    }

    .ms-bismillah {
        font-size: 0.92em;
        font-weight: 700;
        color: #14532d;
        margin-bottom: 2px;
    }

    .ms-title-col h2 {
        margin: 0;
        color: #14532d;
        font-size: 1.38em;
        font-weight: 800;
        line-height: 1.22;
    }

    .ms-title-col p {
        margin: 2px 0;
        font-size: 0.88em;
        font-weight: 600;
        color: #334155;
    }

    .ms-exam-pill {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 12px;
        background: #f0fdf4;
        border: 1px solid #166534;
        border-radius: 4px;
        color: #14532d;
        font-size: 0.88em;
        font-weight: 700;
    }

    .grade-chart {
        border-collapse: collapse;
        font-size: 0.68em;
        text-align: center;
        border: 1px solid #14532d;
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
    }

    .grade-chart th {
        background: #14532d;
        color: #ffffff;
        border: 1px solid #14532d;
        padding: 2px 5px;
        font-weight: 700;
    }

    .grade-chart td {
        border: 1px solid rgba(20, 83, 45, 0.45);
        padding: 1.5px 5px;
        color: #0f172a;
        background: #ffffff;
    }

    .ms-transcript-title {
        text-align: center;
        margin: 10px 0 10px 0;
    }

    .ms-transcript-title span {
        display: inline-block;
        padding: 3px 22px;
        background: #14532d;
        color: #ffffff;
        border: 1.5px solid #b45309;
        border-radius: 4px;
        font-size: 0.96em;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .ms-student-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid #14532d;
        background: #f8faf9;
        margin-bottom: 12px;
        font-size: 0.92em;
        font-variant-numeric: tabular-nums;
    }

    .ms-info-cell {
        display: flex;
        align-items: baseline;
        gap: 6px;
        padding: 5px 10px;
        border-bottom: 1px solid rgba(20, 83, 45, 0.22);
        border-right: 1px solid rgba(20, 83, 45, 0.22);
    }

    .ms-info-cell:nth-child(even) {
        border-right: none;
    }

    .ms-info-lbl {
        font-weight: 700;
        color: #14532d;
        white-space: nowrap;
        min-width: 82px;
    }

    .ms-info-val {
        font-weight: 700;
        color: #0f172a;
    }

    table.main-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92em;
        font-variant-numeric: tabular-nums;
    }

    table.main-table th, table.main-table td {
        border: 1px solid rgba(20, 83, 45, 0.5);
        padding: 6.5px 6px;
        text-align: center;
    }

    table.main-table th {
        background: #14532d;
        color: #ffffff;
        font-weight: 700;
        border-bottom: 2px solid #b45309;
    }

    table.main-table tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    .status-box {
        margin-top: 14px;
        border: 1.5px solid #14532d;
        border-radius: 4px;
        overflow: hidden;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        font-weight: 700;
        font-size: 0.92em;
        background: #f0fdf4;
        font-variant-numeric: tabular-nums;
    }

    .status-box div {
        padding: 8px 6px;
        border-right: 1px solid rgba(20, 83, 45, 0.35);
        text-align: center;
    }

    .status-box div:last-child { border-right: none; }
    .passed-text { color: #15803d; }
    .promoted-text { color: #b45309; }
    .failed-text { color: #b91c1c; }

    .sign-row {
        position: relative;
        z-index: 1;
        margin-top: 44px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 0 10px;
        color: #14532d;
        font-size: 0.88em;
        font-weight: 700;
    }

    .sign-row div p {
        border-top: 1.4px solid #14532d;
        width: 145px;
        padding-top: 5px;
        text-align: center;
        margin: 0;
    }

    @media (max-width: 640px) {
        .result-btn-row { grid-template-columns: 1fr; }
    }

    @page {
        size: A4 portrait;
        margin: 0;
    }

    @media print {
        .no-print, .app-footer, .app-topbar, .app-bottom-nav { display: none !important; }
        body { background: #ffffff !important; margin: 0 !important; padding: 0 !important; }
        .result-shell { margin: 0 !important; max-width: 100% !important; padding: 0 !important; }
        .a4-preview-scroll { overflow: visible !important; padding: 0 !important; }
        .marksheet { box-shadow: none !important; border: none !important; width: 210mm !important; min-height: 297mm !important; }
    }
</style>

<div class="result-shell">
    <% if (!studentResult) { %>
    <div class="result-search-card no-print">
        <div class="result-search-head">
            <img src="/logo.png" alt="মাদ্রাসার লোগো" referrerpolicy="no-referrer">
            <h1>অনলাইন ফলাফল পোর্টাল</h1>
            <p>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</p>
        </div>
        <div class="result-search-body">
            <% if (searchError) { %>
                <div class="result-error"><%= searchError %></div>
            <% } %>
            <form method="POST" action="/result.php<%= isEmbedded ? '?embed=1' : '' %>" id="resultSearchForm">
                <% if (isEmbedded) { %><input type="hidden" name="embed" value="1"><% } %>
                <div class="result-field">
                    <label for="student_class">শিক্ষার্থীর শ্রেণি / পরীক্ষা</label>
                    <%
                        const _selVal = typeof selectedClassValue !== 'undefined' ? String(selectedClassValue || '') : '';
                        const _selKey = typeof selectedClassKey !== 'undefined' ? String(selectedClassKey || '') : '';
                        const _selRoll = typeof searchedRoll !== 'undefined' ? String(searchedRoll || '') : '';
                    %>
                    <select id="student_class" name="student_class" required>
                        <option value="" disabled <%= (!_selVal && !_selKey) ? 'selected' : '' %>>শ্রেণি বা আপলোডকৃত পরীক্ষা নির্বাচন করুন</option>
                        <% if (typeof uploadedExams !== 'undefined' && uploadedExams.length > 0) { %>
                            <optgroup label="শ্রেণি ভিত্তিক আপলোডকৃত এক্সেল ফলাফল">
                                <% uploadedExams.forEach(function(ex) { %>
                                    <option value="excel:<%= ex.id %>" <%= (_selVal === 'excel:' + ex.id) ? 'selected' : '' %>><%= ex.dropdownLabel || ex.title %> (<%= convertToBengali(ex.rowCount) %> জন)</option>
                                <% }); %>
                            </optgroup>
                        <% } %>
                        <optgroup label="সকল শ্রেণি">
                            <% Object.entries(classMap).forEach(function([k, v]) {
                                const _cname = String(v.name || '').trim();
                                const _clsLbl = /(?:শ্রেণি|শ্রেণী|বর্ষ)$/.test(_cname) ? _cname : _cname + ' শ্রেণি';
                                const _isSelectedCls = (_selVal === k) || (!_selVal.startsWith('excel:') && _selKey === k);
                            %>
                                <option value="<%= k %>" <%= _isSelectedCls ? 'selected' : '' %>><%= _clsLbl %></option>
                            <% }); %>
                        </optgroup>
                    </select>
                </div>
                <div class="result-field">
                    <label for="roll_number">
                        <span>রোল নম্বর</span>
                        <span id="resultRollCountBadge" class="id-count-pill"></span>
                    </label>
                    <input id="roll_number" type="text" name="roll_number" value="<%= _selRoll %>" list="resultRollDatalist" placeholder="রোল নম্বর লিখুন (যেমন: 1 বা ১) অথবা তালিকা থেকে বেছে নিন" required>
                    <datalist id="resultRollDatalist"></datalist>

                    <div id="resultRollAutoWrap" class="roll-auto-panel" style="display:none;">
                        <div class="roll-auto-title">
                            <span style="display:inline-flex;align-items:center;gap:6px;"><%- iconSvg('list-ol', 'app-svg-icon', 16) %> শ্রেণিভিত্তিক অটো রোল তালিকা</span>
                            <span style="font-size:0.78rem; color:#475569;">রোল নির্বাচন করুন</span>
                        </div>
                        <select id="resultRollAutoSelect" class="roll-auto-select"></select>
                        <div id="resultRollChips" class="roll-chips-list"></div>
                    </div>
                </div>
                <input type="hidden" name="view_result" value="1">
                <div class="result-btn-row">
                    <button type="submit" name="view_result" value="1" class="r-btn r-btn-primary">
                        <%- iconSvg('search', 'app-svg-icon', 17) %>
                        <span>ফলাফল দেখুন</span>
                    </button>
                    <a href="/merit-list.php<%= isEmbedded ? '?embed=1' : '' %>" class="r-btn r-btn-secondary">
                        <%- iconSvg('trophy', 'app-svg-icon', 17) %>
                        <span>মেধা তালিকা</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
    <script src="/student-picker.js"></script>
    <script>
        (function () {
            if (!window.NadufmStudentPicker) return;
            var picker = window.NadufmStudentPicker;
            var formEl = document.getElementById('resultSearchForm');
            var classEl = document.getElementById('student_class');
            var rollEl = document.getElementById('roll_number');
            var isEmbeddedFlag = <%= isEmbedded ? 'true' : 'false' %>;

            function esc(s) { return picker.escapeHtml(s); }
            function bn(v) { return picker.bnNum(v); }

            function showOfflineError(msg) {
                var body = document.querySelector('.result-search-body');
                if (!body) return;
                var errBox = body.querySelector('.result-error');
                if (!errBox) {
                    errBox = document.createElement('div');
                    errBox.className = 'result-error';
                    body.insertBefore(errBox, body.firstChild);
                }
                errBox.textContent = msg;
                errBox.style.display = 'block';
            }

            async function renderOfflineMarksheet(clsVal, rollVal) {
                if (!window.NadufmOffline) {
                    showOfflineError('অফলাইন ডেটা পাওয়া যায়নি। ইন্টারনেটে সংযুক্ত হয়ে একবার পাতাটি খুলুন।');
                    return;
                }
                var res = await window.NadufmOffline.findStudents({ classParam: clsVal, rollParam: rollVal });
                var st = res && res.student;
                if (!st || !st.resultSummary || !Array.isArray(st.resultSummary.subjects) || !st.resultSummary.subjects.length) {
                    showOfflineError('দুঃখিত! অফলাইন ডেটাবেজে এই শ্রেণি ও রোলের ফলাফল পাওয়া যায়নি।');
                    return;
                }
                var rs = st.resultSummary;
                var qCls = encodeURIComponent(clsVal || rs.classId || st.classKey || '');
                var qRoll = encodeURIComponent(st.roll || rollVal || '');
                var embedSuffix = isEmbeddedFlag ? '&embed=1' : '';
                var failCount = Number(rs.failCount || 0);
                var isPromoted = Boolean(rs.isPromoted);
                var cssCls = isPromoted ? 'promoted-text' : (failCount > 0 ? 'failed-text' : 'passed-text');
                var hasOpt = Boolean(rs.hasOptionalSubject);
                var optBonus = Number(rs.optionalBonus || 0);

                var rowsHtml = rs.subjects.map(function (s, idx) {
                    var avg = s.averageMark != null ? s.averageMark : s.numericMark;
                    var avgRounded = avg != null && !isNaN(avg) ? bn(Math.round(Number(avg) * 10) / 10) : '—';
                    var gColor = s.grade === 'F' ? '#b91c1c' : '#166534';
                    return '<tr style="' + (s.isOptional ? 'background:#fefce8;' : '') + '">' +
                        '<td>' + bn(idx + 1) + '</td>' +
                        '<td style="text-align:left; padding-left:10px; font-weight:600;">' + esc(s.name) +
                            (s.isOptional ? '<span style="display:inline-block; margin-left:6px; padding:1px 6px; font-size:0.78em; font-weight:700; border-radius:4px; background:#fef08a; color:#854d0e; border:1px solid #facc15;">৪র্থ বিষয় (ঐচ্ছিক)</span>' : '') +
                        '</td>' +
                        '<td>' + bn(s.fm || s.fullMarks) + '</td>' +
