<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>অ্যাডমিন প্যানেল ও ড্যাশবোর্ড - <%= institutionName %></title>
    <link rel="shortcut icon" href="/logo.png" type="image/x-icon">
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#14532d">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nadu fm">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Nadu fm">
    <link rel="stylesheet" href="/fonts.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        :root {
            --bg: #f6f8f7;
            --surface: #ffffff;
            --surface-subtle: #f8faf9;
            --border: rgba(15, 23, 42, 0.09);
            --border-strong: rgba(15, 23, 42, 0.16);
            --brand: #15803d;
            --brand-dark: #14532d;
            --brand-tint: #f0fdf4;
            --text: #0f172a;
            --text-muted: #475569;
            --radius: 14px;
            --topbar-h: 56px;
            --sidebar-w: 262px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Kalpurush', sans-serif;
            background: var(--bg);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        button, input {
            font-family: inherit;
        }

        :focus-visible {
            outline: 2px solid var(--brand);
            outline-offset: 2px;
        }

        /* Single Top Header */
        .adm-topbar {
            height: var(--topbar-h);
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 0 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-shrink: 0;
            z-index: 40;
        }

        .adm-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            flex: 1;
        }

        .adm-menu-btn {
            display: none;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid rgba(15, 23, 42, 0.12);
            background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%);
            color: var(--text);
            cursor: pointer;
            flex-shrink: 0;
            font-size: 1rem;
            box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15, 23, 42, 0.09);
            transition: transform 0.14s ease, box-shadow 0.14s ease;
        }

        .adm-menu-btn:hover {
            transform: translateY(-1px);
            background: linear-gradient(180deg, #ffffff 0%, #eaf9ef 100%);
        }

        .adm-menu-btn:active {
            transform: translateY(1.5px);
            box-shadow: 0 1px 0 rgba(15, 23, 42, 0.1);
        }

        .adm-logo {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

        .adm-title-wrap {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
        }

        .adm-brand-btn {
            border: none;
            background: transparent;
            padding: 0;
            font-size: 1.04rem;
            font-weight: 700;
            color: var(--brand-dark);
            cursor: pointer;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: left;
            flex-shrink: 1;
        }

        .adm-brand-btn:hover {
            color: var(--brand);
        }

        .adm-crumb-sep {
            color: #94a3b8;
            font-size: 0.92rem;
            flex-shrink: 0;
        }

        .adm-crumb-active {
            font-size: 0.94rem;
            font-weight: 600;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
        }

        .adm-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .adm-workspace-tools {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .adm-top-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 38px;
            padding: 0 13px;
            border-radius: 10px;
            border: 1px solid rgba(15, 23, 42, 0.12);
            background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%);
            color: var(--text);
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
            box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15, 23, 42, 0.09), 0 4px 8px -2px rgba(15, 23, 42, 0.08);
            transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, border-color 0.14s ease;
        }

        .adm-top-btn:hover {
            transform: translateY(-1px);
            background: linear-gradient(180deg, #ffffff 0%, #eef5f1 100%);
            border-color: var(--border-strong);
            box-shadow: inset 0 1px 0 #ffffff, 0 3.5px 0 rgba(15, 23, 42, 0.11), 0 6px 12px -3px rgba(15, 23, 42, 0.12);
        }

        .adm-top-btn:active {
            transform: translateY(1.5px);
            box-shadow: 0 1px 0 rgba(15, 23, 42, 0.1);
        }

        .adm-logout-btn {
            border-color: #fca5a5;
            background: linear-gradient(180deg, #fff5f5 0%, #fee2e2 100%);
            color: #b91c1c;
            box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 #fca5a5, 0 4px 8px -2px rgba(185, 28, 28, 0.12);
        }

        .adm-logout-btn:hover {
            background: linear-gradient(180deg, #fee2e2 0%, #fecaca 100%);
            border-color: #f87171;
            box-shadow: inset 0 1px 0 #ffffff, 0 3.5px 0 #f87171, 0 6px 12px -3px rgba(185, 28, 28, 0.18);
        }

        /* Shell: Sidebar + Main Viewport */
        .adm-shell {
            flex: 1;
            min-height: 0;
            display: flex;
            position: relative;
        }

        .adm-sidebar {
            width: var(--sidebar-w);
            background: var(--surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            overflow-y: auto;
            padding: 14px 12px 24px 12px;
            z-index: 35;
        }

        .adm-sidebar-head {
            display: none;
            align-items: center;
            justify-content: space-between;
            padding: 2px 4px 12px 4px;
            margin-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }

        .adm-sidebar-head span {
            font-size: 0.96rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .adm-sidebar-close {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface-subtle);
            color: var(--text);
            cursor: pointer;
        }

        .side-home-btn {
            width: 100%;
            min-height: 42px;
            padding: 0 12px;
            border-radius: 10px;
            border: 1px solid rgba(15, 23, 42, 0.08);
            background: linear-gradient(180deg, #ffffff 0%, #f5f8f6 100%);
            color: var(--text);
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 9px;
            text-align: left;
            margin-bottom: 12px;
            box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15, 23, 42, 0.07);
            transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, background 0.14s ease, color 0.14s ease;
        }

        .side-home-btn:hover {
            transform: translateY(-1px);
            background: linear-gradient(180deg, #ffffff 0%, #ebf7ef 100%);
        }

        .side-home-btn.active {
            background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
            color: #ffffff;
            border-color: #146c34;
            font-weight: 700;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3px 0 #0e5427, 0 6px 12px -3px rgba(21, 128, 61, 0.32);
        }

        .side-group {
            margin-bottom: 14px;
        }

        .side-group-title {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-muted);
            padding: 4px 10px 6px 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .side-group-title i {
            font-size: 0.76rem;
            color: var(--brand);
            opacity: 0.85;
        }

        .side-nav-btn {
            width: 100%;
            min-height: 39px;
            padding: 6px 10px;
            margin-bottom: 3px;
            border-radius: 9px;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text);
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 9px;
            text-align: left;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: transform 0.13s cubic-bezier(0.16, 1, 0.3, 1), background 0.14s ease, color 0.14s ease, box-shadow 0.14s ease, border-color 0.14s ease;
        }

        .side-nav-btn i,
        .side-nav-btn .app-svg-icon {
            width: 17px;
            height: 17px;
            text-align: center;
            color: var(--text-muted);
            flex-shrink: 0;
        }

        .side-nav-btn span {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .side-nav-btn:hover {
            background: linear-gradient(180deg, #ffffff 0%, #f1f6f3 100%);
            border-color: rgba(15, 23, 42, 0.08);
            color: var(--brand-dark);
            box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(15, 23, 42, 0.06);
        }

        .side-nav-btn.active {
            background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
            color: #ffffff;
            border-color: #146c34;
            font-weight: 700;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3px 0 #0e5427, 0 5px 10px -2px rgba(21, 128, 61, 0.3);
        }

        .side-nav-btn.active i,
        .side-nav-btn.active .app-svg-icon {
            color: #ffffff;
        }

        .adm-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.45);
            z-index: 45;
        }

        .adm-main {
            flex: 1;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        /* Overview Grid */
        .dash-shell {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            padding: 22px 22px 44px 22px;
        }

        .dash-inner {
            max-width: 1120px;
            margin: 0 auto;
        }

        .stats-strip {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 22px;
        }

        .stat-btn {
            background: linear-gradient(180deg, #ffffff 0%, #f7faf8 100%);
            border: 1px solid rgba(15, 23, 42, 0.1);
            border-radius: 13px;
            padding: 13px 14px;
            text-align: left;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            gap: 3px;
            box-shadow: inset 0 1px 0 #ffffff, 0 3.5px 0 rgba(15, 23, 42, 0.08), 0 6px 12px -4px rgba(15, 23, 42, 0.08);
            transition: border-color 0.15s ease, transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease;
        }

        .stat-btn:hover {
            border-color: rgba(21, 128, 61, 0.42);
            transform: translateY(-2px);
            box-shadow: inset 0 1px 0 #ffffff, 0 5px 0 rgba(21, 128, 61, 0.15), 0 10px 18px -6px rgba(21, 128, 61, 0.2);
        }

        .stat-btn:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 rgba(15, 23, 42, 0.09);
        }

        .stat-val {
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--brand-dark);
            line-height: 1.15;
            font-variant-numeric: tabular-nums;
        }

        .stat-lbl {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dash-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .dash-heading-group h1 {
            font-size: 1.24rem;
            font-weight: 700;
            color: var(--brand-dark);
            line-height: 1.3;
        }

        .dash-heading-group p {
            font-size: 0.86rem;
            color: var(--text-muted);
        }

        .dash-search-box {
            position: relative;
            width: 280px;
            max-width: 100%;
        }

        .dash-search-box i,
        .dash-search-box .app-svg-icon {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.86rem;
            pointer-events: none;
        }

        .dash-search-input {
            width: 100%;
            height: 40px;
            padding: 0 12px 0 34px;
            border: 1px solid var(--border-strong);
            border-radius: 10px;
            background: var(--surface);
            color: var(--text);
            font-size: 0.9rem;
            outline: none;
        }

        .dash-search-input:focus {
            border-color: var(--brand);
        }

        .cat-section {
            margin-bottom: 24px;
        }

        .cat-section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 8px;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .cat-section-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .cat-section-title i {
            color: var(--brand);
            font-size: 0.94rem;
        }

        .dash-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
            gap: 12px;
            font-variant-numeric: tabular-nums;
        }

        .dash-btn {
            background: linear-gradient(180deg, #ffffff 0%, #f7faf8 100%);
            border: 1px solid rgba(15, 23, 42, 0.1);
            border-radius: var(--radius);
            padding: 15px 15px;
            min-height: 82px;
            text-align: left;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: inset 0 1px 0 #ffffff, 0 4px 0 rgba(15, 23, 42, 0.08), 0 8px 16px -6px rgba(15, 23, 42, 0.09);
            transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }

        .dash-btn:hover {
            transform: translateY(-2px);
            border-color: rgba(21, 128, 61, 0.42);
            background: linear-gradient(180deg, #ffffff 0%, #f1fbf4 100%);
            box-shadow: inset 0 1px 0 #ffffff, 0 5.5px 0 rgba(21, 128, 61, 0.16), 0 14px 22px -8px rgba(21, 128, 61, 0.22);
        }

        .dash-btn:hover .dash-btn-icon {
            transform: translateY(-1px) scale(1.06);
        }

        .dash-btn:active {
            transform: translateY(2px);
            box-shadow: 0 1.5px 0 rgba(15, 23, 42, 0.09);
        }

        .dash-btn-icon {
            position: relative;
            width: 48px;
            height: 48px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.08rem;
            flex-shrink: 0;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.36);
            box-shadow: inset 0 1.5px 0 rgba(255, 255, 255, 0.45), inset 0 -2.5px 0 rgba(0, 0, 0, 0.2), 0 4px 0 rgba(15, 23, 42, 0.14), 0 8px 14px -4px rgba(15, 23, 42, 0.24);
            transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .dash-btn-icon::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0.05) 45%, transparent 56%);
            pointer-events: none;
        }

        .ic-green { background: linear-gradient(145deg, #22c55e 0%, #15803d 58%, #14532d 100%); color: #ffffff; }
        .ic-blue { background: linear-gradient(145deg, #3b82f6 0%, #1d4ed8 58%, #1e3a8a 100%); color: #ffffff; }
        .ic-amber { background: linear-gradient(145deg, #f59e0b 0%, #d97706 58%, #92400e 100%); color: #ffffff; }
        .ic-slate { background: linear-gradient(145deg, #64748b 0%, #334155 58%, #1e293b 100%); color: #ffffff; }
        .ic-teal { background: linear-gradient(145deg, #14b8a6 0%, #0f766e 58%, #115e59 100%); color: #ffffff; }
        .ic-indigo { background: linear-gradient(145deg, #6366f1 0%, #4338ca 58%, #312e81 100%); color: #ffffff; }

        .dash-btn-text {
            min-width: 0;
        }

        .dash-btn-title {
            display: block;
            font-size: 0.96rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1.3;
        }

        .dash-btn-meta {
            display: block;
            font-size: 0.81rem;
            font-weight: 500;
            color: var(--text-muted);
            margin-top: 2px;
            line-height: 1.3;
        }

        .dash-empty {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 36px 20px;
            text-align: center;
            color: var(--text-muted);
        }

        .dash-empty-reset {
            margin-top: 12px;
            min-height: 38px;
            padding: 0 16px;
            border-radius: 9px;
            border: 1px solid var(--border-strong);
            background: var(--surface);
            color: var(--text);
            font-weight: 600;
            cursor: pointer;
        }

        /* Integrated Workspace Viewport */
        .adm-workspace {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .adm-frame {
            width: 100%;
            flex: 1;
            min-height: 0;
            border: none;
            background: var(--bg);
            display: block;
        }

        .is-hidden {
            display: none !important;
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition: none !important;
            }
        }

        @media (max-width: 1024px) {
            .adm-menu-btn {
                display: inline-flex;
            }
            .adm-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: 280px;
                max-width: 84vw;
                z-index: 50;
                transform: translateX(-105%);
                transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                box-shadow: 0 16px 40px rgba(15, 23, 42, 0.16);
            }
            .adm-sidebar.open {
                transform: translateX(0);
            }
            .adm-sidebar-head {
                display: flex;
            }
            .adm-backdrop.open {
                display: block;
            }
            .stats-strip {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 640px) {
            .adm-topbar {
                padding: 0 10px;
                gap: 8px;
            }
            .adm-brand {
                gap: 8px;
            }
            .adm-logo {
                width: 30px;
                height: 30px;
            }
            .adm-brand-btn {
                font-size: 0.94rem;
            }
            .adm-crumb-sep, .adm-crumb-active {
                display: none !important;
            }
            .adm-top-btn {
                min-height: 38px;
                padding: 0 10px;
                font-size: 0.82rem;
            }
            .hide-sm {
                display: none;
            }
            .dash-shell {
                padding: 14px 12px 28px 12px;
            }
            .stats-strip {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 8px;
                margin-bottom: 16px;
            }
            .dash-search-box {
                width: 100%;
            }
            .dash-grid {
                grid-template-columns: 1fr;
                gap: 8px;
            }
            .dash-btn {
                padding: 13px 14px;
                min-height: 70px;
            }
        }

        @media (max-width: 420px) {
            .hide-xs {
                display: none;
            }
        }
    </style>
</head>
<body>

    <%
        const currentMod = modules.find(function(m) { return m.id === activeFeature; }) || null;
        const categoryGroups = categories.filter(function(c) { return c.id !== 'all'; });
    %>

    <header class="adm-topbar">
        <div class="adm-brand">
            <button type="button" id="sidebarToggleBtn" class="adm-menu-btn" aria-label="অ্যাডমিন মেনু খুলুন" aria-expanded="false">
                <%- iconSvg('menu', 'app-svg-icon', 19) %>
            </button>
            <img src="/logo.png" alt="মাদ্রাসার লোগো" class="adm-logo" referrerpolicy="no-referrer">
            <div class="adm-title-wrap">
                <button type="button" id="brandHomeBtn" class="adm-brand-btn" title="ড্যাশবোর্ডের মূল পাতায় ফিরে যান">অ্যাডমিন ড্যাশবোর্ড</button>
                <span id="topbarSep" class="adm-crumb-sep <%= currentMod ? '' : 'is-hidden' %>" aria-hidden="true">/</span>
                <span id="topbarActiveLabel" class="adm-crumb-active <%= currentMod ? '' : 'is-hidden' %>"><%= currentMod ? currentMod.label : '' %></span>
            </div>
        </div>
        <div class="adm-actions">
            <span id="workspaceTools" class="adm-workspace-tools <%= currentMod ? '' : 'is-hidden' %>">
                <button type="button" id="refreshFrameBtn" class="adm-top-btn" title="বর্তমান ট্যাব রিফ্রেশ করুন">
                    <%- iconSvg('refresh', 'app-svg-icon', 16) %>
                    <span class="hide-sm">রিফ্রেশ</span>
                </button>
                <button type="button" id="homeGridBtn" class="adm-top-btn" title="সব ফিচার বাটনে ফিরে যান">
                    <%- iconSvg('grid-menu', 'app-svg-icon', 16) %>
                    <span class="hide-sm">সব ফিচার</span>
                </button>
            </span>
            <div id="pwa-install-slot" class="pwa-install-slot"></div>
            <a href="/index.php" class="adm-top-btn" title="মূল ওয়েবসাইট দেখুন">
                <%- iconSvg('external-link', 'app-svg-icon', 16) %>
                <span class="hide-xs">ওয়েবসাইট</span>
            </a>
            <form method="POST" action="/admin-logout" style="margin:0;" onsubmit="if(window.NadufmOffline) window.NadufmOffline.clearAdminCache();">
                <button type="submit" class="adm-top-btn adm-logout-btn" title="অ্যাডমিন প্যানেল থেকে লগআউট করুন">
                    <%- iconSvg('logout', 'app-svg-icon', 16) %>
                    <span class="hide-xs">লগআউট</span>
                </button>
            </form>
        </div>
    </header>

    <div class="adm-shell">
        <div id="sidebarBackdrop" class="adm-backdrop" aria-hidden="true"></div>

        <aside id="admSidebar" class="adm-sidebar" aria-label="অ্যাডমিন নেভিগেশন">
            <div class="adm-sidebar-head">
                <span>অ্যাডমিন মেনু</span>
                <button type="button" id="sidebarCloseBtn" class="adm-sidebar-close" aria-label="মেনু বন্ধ করুন">
                    <%- iconSvg('close', 'app-svg-icon', 17) %>
                </button>
            </div>

            <button type="button" id="sideHomeBtn" class="side-home-btn <%= currentMod ? '' : 'active' %>">
                <%- iconSvg('grid-menu', 'app-svg-icon', 17) %>
                <span>ড্যাশবোর্ড (সব ফিচার)</span>
            </button>

            <% categoryGroups.forEach(function(cat) {
                const catModules = modules.filter(function(m) { return m.category === cat.id; });
            %>
                <div class="side-group">
                    <div class="side-group-title">
                        <%- iconSvg(cat.icon, 'app-svg-icon', 15) %>
                        <span><%= cat.label %></span>
                    </div>
                    <% catModules.forEach(function(mod) { %>
                        <button
                            type="button"
                            class="side-nav-btn <%= currentMod && currentMod.id === mod.id ? 'active' : '' %>"
                            data-open-feature="<%= mod.id %>"
                            title="<%= mod.label %>"
                        >
                            <%- iconSvg(mod.icon, 'app-svg-icon', 17) %>
                            <span><%= mod.label %></span>
                        </button>
                    <% }); %>
                </div>
            <% }); %>
        </aside>

        <div class="adm-main">
            <main id="view-grid" class="dash-shell <%= currentMod ? 'is-hidden' : '' %>">
                <div class="dash-inner">
                    <section class="stats-strip" aria-label="মাদ্রাসার সারসংক্ষেপ">
                        <% summaryStats.forEach(function(stat) { %>
                            <button type="button" class="stat-btn" data-open-feature="<%= stat.feature %>">
                                <span class="stat-val"><%= stat.value %></span>
                                <span class="stat-lbl"><%= stat.label %></span>
                            </button>
                        <% }); %>
                    </section>

                    <div class="dash-toolbar">
                        <div class="dash-heading-group">
                            <h1>একীভূত অ্যাডমিন ও পরিচালনা কেন্দ্র</h1>
                            <p>বাম পাশের মেনু বা নিচের যেকোনো ফিচার বাটনে ক্লিক করে সরাসরি কাজ শুরু করুন</p>
                        </div>
                        <div class="dash-search-box">
                            <%- iconSvg('search', 'app-svg-icon', 16) %>
                            <input
                                type="search"
                                id="featureSearchInput"
                                class="dash-search-input"
                                placeholder="ফিচার খুঁজুন (রুটিন, ফলাফল, নোটিশ)..."
                                aria-label="ফিচার খুঁজুন"
                            >
                        </div>
                    </div>

                    <div id="categorySectionsWrap">
                        <% categoryGroups.forEach(function(cat) {
                            const catModules = modules.filter(function(m) { return m.category === cat.id; });
                        %>
                            <section class="cat-section" data-cat-section="<%= cat.id %>">
                                <div class="cat-section-head">
                                    <h2 class="cat-section-title">
                                        <%- iconSvg(cat.icon, 'app-svg-icon', 18) %>
                                        <span><%= cat.label %></span>
                                    </h2>
                                </div>
                                <div class="dash-grid" role="list" aria-label="<%= cat.label %> ফিচার বাটন">
                                    <% catModules.forEach(function(mod) { %>
                                        <button
                                            type="button"
                                            class="dash-btn"
                                            data-open-feature="<%= mod.id %>"
                                            data-keywords="<%= (mod.label + ' ' + mod.meta + ' ' + cat.label).toLowerCase() %>"
                                            role="listitem"
                                        >
                                            <span class="dash-btn-icon <%= mod.tone %>">
                                                <%- iconSvg(mod.icon, 'app-svg-icon', 24) %>
                                            </span>
                                            <span class="dash-btn-text">
                                                <span class="dash-btn-title"><%= mod.label %></span>
                                                <span class="dash-btn-meta"><%= mod.meta %></span>
                                            </span>
                                        </button>
                                    <% }); %>
                                </div>
                            </section>
                        <% }); %>
                    </div>

                    <div id="dashEmptyState" class="dash-empty is-hidden">
                        <p>আপনার অনুসন্ধানের সাথে মিলে এমন কোনো ফিচার পাওয়া যায়নি।</p>
                        <button type="button" id="resetSearchBtn" class="dash-empty-reset">সব ফিচার দেখান</button>
                    </div>
                </div>
            </main>

            <section id="view-workspace" class="adm-workspace <%= currentMod ? '' : 'is-hidden' %>">
                <iframe
                    id="workspaceFrame"
                    name="nadufm_workspace_frame"
                    class="adm-frame"
                    src="<%= currentMod ? currentMod.src : 'about:blank' %>"
                    title="অ্যাডমিন ওয়ার্কস্পেস"
                ></iframe>
            </section>
        </div>
    </div>

    <script>
        (function () {
            var modulesList = <%- JSON.stringify(modules) %>;
            var modulesMap = {};
            var firstFeatureByTab = {};
            modulesList.forEach(function (m) {
                modulesMap[m.id] = m;
                if (!firstFeatureByTab[m.category]) {
                    firstFeatureByTab[m.category] = m.id;
                }
            });

            var gridEl = document.getElementById('view-grid');
            var workspaceEl = document.getElementById('view-workspace');
            var frameEl = document.getElementById('workspaceFrame');
            var workspaceToolsEl = document.getElementById('workspaceTools');
            var topbarSepEl = document.getElementById('topbarSep');
            var topbarLabelEl = document.getElementById('topbarActiveLabel');
            var refreshBtn = document.getElementById('refreshFrameBtn');
            var homeGridBtn = document.getElementById('homeGridBtn');
            var brandHomeBtn = document.getElementById('brandHomeBtn');
            var sideHomeBtn = document.getElementById('sideHomeBtn');
            var sidebarEl = document.getElementById('admSidebar');
            var backdropEl = document.getElementById('sidebarBackdrop');
            var sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
            var sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
            var searchInput = document.getElementById('featureSearchInput');
            var emptyStateEl = document.getElementById('dashEmptyState');
            var resetSearchBtn = document.getElementById('resetSearchBtn');
            var sideNavBtns = document.querySelectorAll('.side-nav-btn[data-open-feature]');

            var currentFeatureId = <%- JSON.stringify(activeFeature || '') %>;
            var initTabId = <%- JSON.stringify(activeTab || 'all') %>;

            function setSidebarOpen(open) {
                sidebarEl.classList.toggle('open', open);
                backdropEl.classList.toggle('open', open);
                if (sidebarToggleBtn) {
                    sidebarToggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                }
            }

            function syncSidebarActive(activeFeatId) {
                if (sideHomeBtn) {
                    sideHomeBtn.classList.toggle('active', !activeFeatId);
                }
                sideNavBtns.forEach(function (btn) {
                    var isAct = btn.getAttribute('data-open-feature') === activeFeatId;
                    btn.classList.toggle('active', isAct);
                });
            }

            function syncTopbar(mod) {
                var active = Boolean(mod);
                workspaceToolsEl.classList.toggle('is-hidden', !active);
                topbarSepEl.classList.toggle('is-hidden', !active);
                topbarLabelEl.classList.toggle('is-hidden', !active);
                topbarLabelEl.textContent = mod ? mod.label : '';
            }

            function showHomeGrid(pushHistory) {
                currentFeatureId = '';
                syncSidebarActive('');
                syncTopbar(null);
                workspaceEl.classList.add('is-hidden');
                gridEl.classList.remove('is-hidden');
                frameEl.setAttribute('src', 'about:blank');
                setSidebarOpen(false);
                if (pushHistory) {
                    history.pushState({ feature: '' }, '', '/dashboard.php');
                }
            }

            function openFeature(featureId, pushHistory) {
                var mod = featureId ? modulesMap[featureId] : null;
                if (!mod) {
                    showHomeGrid(pushHistory);
                    return;
                }
                currentFeatureId = mod.id;
                syncSidebarActive(mod.id);
                syncTopbar(mod);

                gridEl.classList.add('is-hidden');
                workspaceEl.classList.remove('is-hidden');

                if (frameEl.getAttribute('src') !== mod.src) {
                    frameEl.setAttribute('src', mod.src);
                }

                setSidebarOpen(false);

                if (pushHistory) {
                    history.pushState(
                        { feature: mod.id },
                        '',
                        '/dashboard.php?feature=' + encodeURIComponent(mod.id)
                    );
                }
            }

            function filterDashboardButtons() {
                var q = (searchInput.value || '').trim().toLowerCase();
                var sections = document.querySelectorAll('.cat-section[data-cat-section]');
                var anyVisible = false;

                sections.forEach(function (sec) {
                    var btns = sec.querySelectorAll('.dash-btn[data-open-feature]');
                    var secHasMatch = false;
                    btns.forEach(function (btn) {
                        var kw = btn.getAttribute('data-keywords') || '';
                        var match = !q || kw.indexOf(q) !== -1;
                        btn.classList.toggle('is-hidden', !match);
                        if (match) {
                            secHasMatch = true;
                            anyVisible = true;
                        }
                    });
                    sec.classList.toggle('is-hidden', !secHasMatch);
                });

                emptyStateEl.classList.toggle('is-hidden', anyVisible);
            }

            document.querySelectorAll('[data-open-feature]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openFeature(btn.getAttribute('data-open-feature'), true);
                });
            });

            [homeGridBtn, brandHomeBtn, sideHomeBtn].forEach(function (el) {
                if (el) {
                    el.addEventListener('click', function () {
                        showHomeGrid(true);
                    });
                }
            });

            if (refreshBtn) {
                refreshBtn.addEventListener('click', function () {
                    var mod = currentFeatureId ? modulesMap[currentFeatureId] : null;
                    if (mod) {
                        frameEl.setAttribute('src', mod.src);
                    }
                });
            }

            if (sidebarToggleBtn) {
                sidebarToggleBtn.addEventListener('click', function () {
                    setSidebarOpen(!sidebarEl.classList.contains('open'));
                });
            }

            [sidebarCloseBtn, backdropEl].forEach(function (el) {
                if (el) {
                    el.addEventListener('click', function () {
                        setSidebarOpen(false);
                    });
                }
            });

            if (searchInput) {
                searchInput.addEventListener('input', filterDashboardButtons);
            }

            if (resetSearchBtn) {
                resetSearchBtn.addEventListener('click', function () {
                    searchInput.value = '';
                    filterDashboardButtons();
                    searchInput.focus();
                });
            }

            window.addEventListener('popstate', function () {
                var params = new URLSearchParams(window.location.search);
                var f = params.get('feature') || '';
                var t = params.get('tab') || '';
                if (f && modulesMap[f]) {
                    openFeature(f, false);
                } else if (t && firstFeatureByTab[t]) {
                    openFeature(firstFeatureByTab[t], false);
                } else {
                    showHomeGrid(false);
                }
            });

            if (!currentFeatureId && initTabId && initTabId !== 'all' && firstFeatureByTab[initTabId]) {
                openFeature(firstFeatureByTab[initTabId], false);
            }
        })();
    </script>
    <script src="/offline-sync.js"></script>
    <script src="/pwa.js" defer></script>
</body>
</html>
