    </aside>

    <script>
        (function () {
            var modulesMap = <%- JSON.stringify(modules.reduce(function(acc, m) { acc[m.id] = m; return acc; }, {})) %>;
            var gridEl = document.getElementById('view-grid');
            var workspaceEl = document.getElementById('view-workspace');
            var frameEl = document.getElementById('workspaceFrame');
            var backBtn = document.getElementById('backToGridBtn');
            var topbarTitle = document.getElementById('topbarTitle');

            function openFeature(featureId, pushHistory) {
                var mod = featureId ? modulesMap[featureId] : null;
                if (!mod) {
                    gridEl.classList.remove('is-hidden');
                    workspaceEl.classList.add('is-hidden');
                    backBtn.classList.add('is-hidden');
                    topbarTitle.textContent = 'অ্যাডমিন ড্যাশবোর্ড';
                    frameEl.setAttribute('src', 'about:blank');
                    if (pushHistory) {
                        history.pushState({ feature: '' }, '', '/dashboard.php');
                    }
                    return;
                }

                gridEl.classList.add('is-hidden');
                workspaceEl.classList.remove('is-hidden');
                backBtn.classList.remove('is-hidden');
                topbarTitle.textContent = mod.label;
                if (frameEl.getAttribute('src') !== mod.src) {
                    frameEl.setAttribute('src', mod.src);
                }
                if (pushHistory) {
                    history.pushState({ feature: mod.id }, '', '/dashboard.php?feature=' + encodeURIComponent(mod.id));
                }
            }

            document.querySelectorAll('.dash-btn[data-feature]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openFeature(btn.getAttribute('data-feature'), true);
                });
            });

            backBtn.addEventListener('click', function () {
                openFeature('', true);
            });

            window.addEventListener('popstate', function () {
                var params = new URLSearchParams(window.location.search);
                openFeature(params.get('feature') || '', false);
            });
        })();
    </script>
    <script src="/script.js"></script>
    <script src="/pwa.js" defer></script>
</body>
</html>
