<%- include('partials/header') %>

<style>
    .stu-hub-shell {
        max-width: 960px;
        margin: 22px auto 36px auto;
        padding: 0 16px;
    }

    .search-card {
        background: #ffffff;
        max-width: 620px;
        margin: 0 auto 20px auto;
        border-radius: 18px;
        border: 1px solid rgba(15, 23, 42, 0.09);
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    .search-card-head {
        background: linear-gradient(135deg, #14532d 0%, #15803d 100%);
        color: #ffffff;
        padding: 22px 20px;
        text-align: center;
    }

    .search-card-head h1 { font-size: 1.3rem; font-weight: 700; margin: 0; }
    .search-card-head p { font-size: 0.9rem; opacity: 0.92; margin-top: 4px; }

    .search-card-body { padding: 22px 24px 24px 24px; }

    .stu-field { margin-bottom: 15px; }
    .stu-field label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        font-size: 0.94rem;
        margin-bottom: 6px;
        color: #0f172a;
    }

    .search-input,
    .search-select {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        border-radius: 10px;
        background: #f8faf9;
        color: #0f172a;
        font-family: inherit;
        font-size: 0.95rem;
        outline: none;
    }
    .search-input:focus,
    .search-select:focus { border-color: #15803d; background: #ffffff; }

    .roll-auto-panel {
        margin-top: 10px;
        background: #f8faf9;
        border: 1px solid rgba(21, 128, 61, 0.22);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .roll-auto-title {
        font-size: 0.84rem;
        font-weight: 700;
        color: #14532d;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .roll-auto-select {
        height: 40px !important;
        background: #ffffff !important;
        margin-bottom: 8px;
        font-size: 0.9rem !important;
    }

    .roll-chips-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        max-height: 150px;
        overflow-y: auto;
    }

    .roll-chip-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 9px;
        border: 1px solid rgba(21, 128, 61, 0.25);
        background: linear-gradient(180deg, #ffffff 0%, #f4f9f6 100%);
        color: #0f172a;
        font-family: inherit;
        font-size: 0.84rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(21, 128, 61, 0.14);
        transition: transform 0.13s ease, box-shadow 0.13s ease, background 0.13s ease, color 0.13s ease;
    }
    .roll-chip-btn:hover,
    .roll-chip-btn.active {
        background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
        color: #ffffff;
        border-color: #146c34;
        transform: translateY(-1px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), 0 2.5px 0 #0e5427;
    }
    .roll-chip-btn:active { transform: translateY(1px); box-shadow: 0 1px 0 #0e5427; }

    .roll-empty-note { font-size: 0.83rem; color: #64748b; }

    .id-count-pill {
        font-size: 0.78rem;
        font-weight: 700;
        color: #15803d;
        background: #dcfce7;
        padding: 2px 8px;
        border-radius: 999px;
    }

    .search-or-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 600;
        margin: 14px 0;
    }
    .search-or-divider::before,
    .search-or-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: rgba(15, 23, 42, 0.1);
    }

    .search-btn {
        width: 100%;
        min-height: 46px;
        padding: 0 22px;
        border: 1px solid #146c34;
        border-radius: 11px;
        background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
        color: #ffffff;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.98rem;
        cursor: pointer;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3.5px 0 #0e5427, 0 6px 14px -3px rgba(21, 128, 61, 0.32);
        transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease;
    }
    .search-btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
    .search-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 #0e5427; }

    #loading { display: none; margin-top: 12px; color: #15803d; font-weight: 600; text-align: center; }
    #searchMsg { display: none; margin-top: 12px; color: #b91c1c; font-weight: 600; text-align: center; }

    #multiple-results {
        display: none;
        background: #ffffff;
        padding: 20px;
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, 0.09);
        margin-bottom: 20px;
    }
    .res-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 0.92rem; }
    .res-table th, .res-table td { padding: 10px 12px; border-bottom: 1px solid rgba(15, 23, 42, 0.08); text-align: left; }
    .res-table th { background: #f8faf9; color: #14532d; }
    .view-btn {
        background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
        color: #ffffff;
        border: 1px solid #146c34;
        padding: 6px 14px;
        border-radius: 9px;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 2.5px 0 #0e5427;
        transition: transform 0.13s ease, box-shadow 0.13s ease;
    }
    .view-btn:hover { transform: translateY(-1px); }
    .view-btn:active { transform: translateY(1.5px); box-shadow: 0 1px 0 #0e5427; }

    #print-preview-section { display: none; }

    .hub-controls-card {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.09);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .hub-link-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        margin-bottom: 12px;
        border-radius: 10px;
        background: #f8faf9;
        border: 1px solid rgba(21, 128, 61, 0.16);
        font-size: 0.86rem;
        color: #1e293b;
    }
    .hub-link-summary strong { color: #14532d; }
    .hub-link-meta { font-weight: 600; color: #475569; }

    .doc-tabs-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        padding: 8px;
        background: linear-gradient(180deg, #e9efec 0%, #f4f7f5 100%);
        border: 1px solid rgba(15, 23, 42, 0.09);
        border-radius: 14px;
        box-shadow: inset 0 2px 5px rgba(15, 23, 42, 0.07);
        margin-bottom: 14px;
    }

    .doc-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 40px;
        padding: 0 15px;
        border-radius: 10px;
        border: 1px solid rgba(15, 23, 42, 0.1);
        background: linear-gradient(180deg, #ffffff 0%, #f2f6f4 100%);
        color: #0f172a;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15, 23, 42, 0.09), 0 4px 8px -3px rgba(15, 23, 42, 0.08);
        transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, background 0.14s ease, color 0.14s ease;
    }
    .doc-tab-btn:hover {
        transform: translateY(-1px);
        color: #14532d;
        background: linear-gradient(180deg, #ffffff 0%, #ebf7ef 100%);
    }
    .doc-tab-btn:active {
        transform: translateY(1.5px);
        box-shadow: 0 1px 0 rgba(15, 23, 42, 0.09);
    }
    .doc-tab-btn.active {
        background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
        color: #ffffff;
        border-color: #146c34;
        transform: translateY(-1px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3px 0 #0e5427, 0 6px 14px -3px rgba(21, 128, 61, 0.34);
    }

    .print-toolbar {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .tool-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 41px;
        padding: 0 16px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease;
    }
    .tool-btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
    .tool-btn:active { transform: translateY(2px); }
    .tool-green { background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%); color: #ffffff; border-color: #146c34; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 3px 0 #0e5427, 0 5px 12px -3px rgba(21,128,61,0.3); }
    .tool-green:active { box-shadow: 0 1px 0 #0e5427; }
    .tool-rose { background: linear-gradient(180deg, #e11d48 0%, #be123c 100%); color: #ffffff; border-color: #9f1239; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 3px 0 #881337, 0 5px 12px -3px rgba(190,18,60,0.3); }
    .tool-rose:active { box-shadow: 0 1px 0 #881337; }
    .tool-blue { background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border-color: #1e40af; box-shadow: inset 0 1px 0 rgba(255,255,255,0.26), 0 3px 0 #172f82, 0 5px 12px -3px rgba(29,78,216,0.3); }
    .tool-blue:active { box-shadow: 0 1px 0 #172f82; }
    .tool-slate { background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%); color: #0f172a; border-color: rgba(15, 23, 42, 0.14); box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15,23,42,0.1), 0 4px 8px -3px rgba(15,23,42,0.08); }
    .tool-slate:active { box-shadow: 0 1px 0 rgba(15,23,42,0.1); }

    .cert-extra-bar {
        display: none;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px dashed rgba(15, 23, 42, 0.12);
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 10px;
    }
    .cert-extra-bar.visible { display: grid; }
    .cert-extra-bar input {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.88rem;
    }
    .cert-extra-bar label { display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 3px; }

    .print-scroll { overflow-x: auto; padding-bottom: 8px; }

    .a4-doc-sheet {
        background: #ffffff;
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 12mm 14mm;
        position: relative;
        border: 1px solid rgba(15, 23, 42, 0.16);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
        color: #0f172a;
        box-sizing: border-box;
    }
    .a4-doc-sheet.is-landscape {
        width: 297mm;
        min-height: 210mm;
        padding: 10mm 14mm;
    }
    .a4-doc-sheet * {
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    /* Profile Card Styles */
    .profile-frame { border: 2px solid #166534; padding: 16px; min-height: 266mm; display: flex; flex-direction: column; justify-content: space-between; }
    .header-wrapper { display: flex; align-items: center; border-bottom: 2px solid #166534; padding-bottom: 10px; margin-bottom: 14px; position: relative; min-height: 92px; }
    .logo-top { width: 68px; margin-right: 15px; }
    .header-text { padding-right: 105px; }
    .header-text h2 { color: #166534; margin: 0; font-size: 19px; font-weight: 800; }
    .header-text p { margin: 2px 0; font-size: 12px; color: #334155; font-weight: 600; }
    .photo-box { width: 92px; height: 108px; border: 1px solid #0f172a; position: absolute; top: 0; right: 0; display: flex; align-items: center; justify-content: center; background: #fff; overflow: hidden; }
    .photo-box img { width: 100%; height: 100%; object-fit: cover; }
    .form-title { text-align: center; margin: 8px 0 12px 0; font-weight: 700; font-size: 15.5px; color: #166534; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; }
    .section-title { background: #f0f7f2; padding: 4px 10px; font-weight: 700; margin-top: 10px; margin-bottom: 6px; font-size: 13px; color: #14532d; border: 1px solid #d1e7d9; }
    .doc-field { display: flex; align-items: flex-end; margin-bottom: 7px; }
    .doc-label { font-weight: 600; font-size: 13px; color: #1e293b; white-space: nowrap; }
    .dotted-line { border-bottom: 1px dotted #555; flex-grow: 1; margin-left: 6px; min-height: 18px; color: #000; font-weight: 700; padding-left: 5px; font-size: 13.5px; }
    .doc-row { display: flex; gap: 15px; }
    .doc-col { flex: 1; }
    .signature-area { margin-top: 44px; display: flex; justify-content: space-between; }
    .sig-box { border-top: 1.5px solid #333; width: 155px; text-align: center; font-size: 12.5px; padding-top: 4px; font-weight: 700; }

    /* Certificate / Attestation / Testimonial Frame (Traditional Ornate Landscape Design) */
    .cert-frame {
        position: relative;
        padding: 15px;
        min-height: 266mm;
        background: #ffffff;
        color: #111827;
        border: 2px solid #1f2937;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }
    .a4-doc-sheet.is-landscape .cert-frame {
        min-height: 188mm;
        padding: 12px;
    }
    .trad-cert-ornate-edge {
        position: relative;
        flex: 1;
        border: 1.5px solid #1f2937;
        padding: 16px 24px 18px 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background-color: #ffffff;
    }
    .a4-doc-sheet.is-landscape .trad-cert-ornate-edge {
        padding: 12px 24px 14px 24px;
    }
    .a4-doc-sheet.is-landscape .trad-inst-head {
        margin-bottom: 4px;
    }
    .a4-doc-sheet.is-landscape .trad-inst-logo {
        width: 66px;
        height: 66px;
    }
    .a4-doc-sheet.is-landscape .trad-title-ribbon-row {
        margin: 6px 0 10px 0;
    }
    .a4-doc-sheet.is-landscape .trad-lines {
        font-size: 14.8px;
        line-height: 1.85;
    }
    .a4-doc-sheet.is-landscape .trad-para {
        margin-top: 8px;
        font-size: 14.4px;
        line-height: 1.65;
    }
    .a4-doc-sheet.is-landscape .trad-para-wish {
        margin-top: 6px;
        font-size: 14.4px;
        line-height: 1.6;
    }
    .a4-doc-sheet.is-landscape .trad-watermark {
        width: 220px;
        height: 220px;
    }
    .a4-doc-sheet.is-landscape .trad-sign-footer {
        margin-top: 20px;
    }
    .trad-cert-border-svg {
        position: absolute;
        pointer-events: none;
        z-index: 1;
        display: block;
    }
    .trad-cert-border-svg.is-top { top: -14px; left: -14px; width: calc(100% + 28px); height: 14px; }
    .trad-cert-border-svg.is-bottom { bottom: -14px; left: -14px; width: calc(100% + 28px); height: 14px; }
    .trad-cert-border-svg.is-left { top: 0; left: -14px; width: 14px; height: 100%; }
    .trad-cert-border-svg.is-right { top: 0; right: -14px; width: 14px; height: 100%; }
    .trad-cert-inner {
        position: relative;
        z-index: 2;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .trad-bismillah {
        text-align: center;
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 4px;
        letter-spacing: 0.3px;
    }
    .trad-inst-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }
    .trad-inst-logo {
        width: 78px;
        height: 78px;
        object-fit: contain;
        flex-shrink: 0;
    }
    .trad-inst-title-wrap {
        flex: 1;
        text-align: center;
    }
    .trad-inst-title-wrap h2 {
        margin: 0 0 3px 0;
        font-size: 22px;
        font-weight: 800;
        color: #111827;
        line-height: 1.2;
    }
    .trad-inst-title-wrap p {
        margin: 2px 0;
        font-size: 13.5px;
        font-weight: 600;
        color: #1f2937;
        line-height: 1.35;
    }
    .trad-title-ribbon-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 10px 0 18px 0;
    }
    .trad-memo-cell {
        font-size: 14px;
        font-weight: 700;
        color: #111827;
        min-width: 148px;
        display: flex;
        align-items: baseline;
        gap: 4px;
    }
    .trad-memo-cell.is-right {
        justify-content: flex-end;
    }
    .trad-ribbon-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        flex-shrink: 0;
    }
    .trad-ribbon-wing {
        width: 34px;
        height: 28px;
        color: #111827;
        flex-shrink: 0;
    }
    .trad-ribbon-plaque {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 26px;
        border-radius: 999px;
        background: #111827;
        color: #ffffff;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: 0.4px;
        line-height: 1.25;
        border: 1.5px solid #111827;
    }
    .trad-body-stage {
        position: relative;
        flex: 1;
        padding: 4px 2px;
    }
    .trad-watermark {
        position: absolute;
        left: 50%;
        top: 48%;
        transform: translate(-50%, -50%);
        width: 285px;
        height: 285px;
        object-fit: contain;
        opacity: 0.085;
        filter: grayscale(100%);
        pointer-events: none;
        z-index: 0;
    }
    .trad-lines {
        position: relative;
        z-index: 1;
        font-size: 15.5px;
        line-height: 2.15;
        color: #111827;
    }
    .trad-line-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 10px;
        margin-bottom: 3px;
    }
    .trad-lbl {
        font-weight: 600;
        white-space: nowrap;
    }
    .trad-fill {
        flex: 1 1 90px;
        min-width: 72px;
        border-bottom: 1.4px dotted #1f2937;
        padding: 0 6px 1px 6px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.35;
        outline: none;
    }
    .trad-fill.sm { flex: 0.55 1 60px; min-width: 54px; }
    .trad-fill.md { flex: 0.85 1 95px; min-width: 82px; }
    .trad-fill.lg { flex: 1.5 1 180px; }
    .trad-fill-inline {
        display: inline-block;
        min-width: 82px;
        border-bottom: 1.4px dotted #1f2937;
        padding: 0 5px 1px 5px;
        font-weight: 700;
        line-height: 1.25;
        outline: none;
    }
    .trad-para {
        margin-top: 16px;
        font-size: 15.2px;
        line-height: 1.85;
        text-align: justify;
    }
    .trad-para-wish {
        margin-top: 10px;
        font-size: 15.2px;
        line-height: 1.8;
    }
    .trad-sign-footer {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-top: 42px;
        padding-top: 8px;
        font-size: 14.5px;
        font-weight: 600;
        color: #111827;
    }
    .trad-sign-left {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 230px;
    }
    .trad-sign-line-row {
        display: flex;
        align-items: baseline;
        gap: 6px;
    }
    .trad-sign-right {
        text-align: center;
        min-width: 205px;
    }
    .trad-sign-rule {
        border-top: 1.4px dotted #1f2937;
        padding-top: 5px;
        font-weight: 700;
    }
    @media print {
        .trad-fill:focus, .trad-fill-inline:focus { outline: none !important; }
    }

    /* Board-Style Marksheet */
    .ms-board-frame {
        position: relative;
        border: 3px double #14532d;
        outline: 1px solid #b45309;
        outline-offset: -7px;
        padding: 18px 22px;
        min-height: 270mm;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #ffffff;
    }
    .ms-watermark {
        position: absolute;
        left: 50%;
        top: 52%;
        transform: translate(-50%, -50%);
        width: 235px;
        height: 235px;
        object-fit: contain;
        opacity: 0.055;
        pointer-events: none;
        z-index: 0;
    }
    .ms-content-layer { position: relative; z-index: 1; }
    .ms-board-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 10px;
        border-bottom: 2px solid #14532d;
    }
    .ms-logo-col { width: 76px; flex-shrink: 0; text-align: center; }
    .ms-logo-col img { width: 62px; height: 62px; object-fit: contain; }
    .ms-eiin-tag {
        margin-top: 3px;
        font-size: 10px;
        font-weight: 700;
        color: #14532d;
        border: 1px solid rgba(20, 83, 45, 0.35);
        background: #f0fdf4;
        border-radius: 4px;
        padding: 1px 4px;
    }
    .ms-title-col { flex: 1; text-align: center; }
    .ms-bismillah { font-size: 13px; font-weight: 700; color: #14532d; margin-bottom: 2px; }
    .ms-title-col h2 { margin: 0; color: #14532d; font-size: 19px; font-weight: 800; line-height: 1.22; }
    .ms-title-col p { margin: 2px 0; font-size: 12px; font-weight: 600; color: #334155; }
    .ms-exam-pill {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 12px;
        background: #f0fdf4;
        border: 1px solid #166534;
        border-radius: 4px;
        color: #14532d;
        font-size: 12.5px;
        font-weight: 700;
    }
    .grade-chart { border-collapse: collapse; font-size: 9.5px; text-align: center; border: 1px solid #14532d; flex-shrink: 0; }
    .grade-chart th { background: #14532d; color: #ffffff; border: 1px solid #14532d; padding: 2px 5px; }
    .grade-chart td { border: 1px solid rgba(20, 83, 45, 0.45); padding: 1.5px 5px; color: #0f172a; }
    .ms-transcript-title { text-align: center; margin: 10px 0; }
    .ms-transcript-title span {
        display: inline-block;
        padding: 3px 22px;
        background: #14532d;
        color: #ffffff;
        border: 1.5px solid #b45309;
        border-radius: 4px;
        font-size: 13.5px;
        font-weight: 700;
    }
    .ms-student-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid #14532d;
        background: #f8faf9;
        margin-bottom: 12px;
        font-size: 13px;
    }
    .ms-info-cell {
        display: flex;
        align-items: baseline;
        gap: 6px;
        padding: 5px 10px;
        border-bottom: 1px solid rgba(20, 83, 45, 0.22);
        border-right: 1px solid rgba(20, 83, 45, 0.22);
    }
    .ms-info-cell:nth-child(even) { border-right: none; }
    .ms-info-lbl { font-weight: 700; color: #14532d; white-space: nowrap; min-width: 82px; }
    .ms-info-val { font-weight: 700; color: #0f172a; }
    .ms-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px; }
    .ms-table th, .ms-table td { border: 1px solid rgba(20, 83, 45, 0.5); padding: 6.5px 6px; text-align: center; }
    .ms-table th { background: #14532d; color: #ffffff; border-bottom: 2px solid #b45309; font-weight: 700; }
    .ms-table tbody tr:nth-child(even) { background: #f8fafc; }
    .ms-summary { margin-top: 14px; border: 1.5px solid #14532d; border-radius: 4px; overflow: hidden; display: grid; grid-template-columns: repeat(4, 1fr); font-weight: 700; background: #f0fdf4; font-size: 13px; }
    .ms-summary div { padding: 8px 6px; border-right: 1px solid rgba(20, 83, 45, 0.35); text-align: center; }
    .ms-summary div:last-child { border-right: none; }

    /* ID card pair inside A4 sheet */
    .id-pair { display: flex; justify-content: center; gap: 22px; flex-wrap: wrap; margin-top: 18px; }
    .id-card-box { width: 72mm; min-height: 112mm; border: 2px solid #14532d; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; background: #fff; }
    .id-card-top { background: #14532d; color: #fff; padding: 10px 8px 12px 8px; text-align: center; border-bottom: 3px solid #f59e0b; }

    @media print {
        @page { size: A4; margin: 0; }
        .no-print, .app-footer, .app-topbar, .app-bottom-nav { display: none !important; }
        body { background: #ffffff !important; padding: 0 !important; margin: 0 !important; }
        .stu-hub-shell { margin: 0 !important; max-width: 100% !important; padding: 0 !important; }
        #print-preview-section { display: block !important; }
        .a4-doc-sheet { border: none !important; box-shadow: none !important; margin: 0 !important; }
        .a4-doc-sheet.is-landscape { width: 297mm !important; min-height: 210mm !important; }
    }
</style>
<style id="dynamicPrintOrientationStyle"></style>

<div class="stu-hub-shell">
    <section class="search-card no-print" id="searchCardSection">
        <div class="search-card-head">
            <h1>শিক্ষার্থী তথ্য ও সকল ডকুমেন্ট পোর্টাল</h1>
            <p>শ্রেণি বাছাই করলে অটো রোল তালিকা প্রদর্শিত হবে · সরাসরি রোল বা নাম/আইডি দিয়েও খুঁজতে পারবেন</p>
        </div>
        <div class="search-card-body">
            <div class="stu-field">
                <label for="searchClass">শ্রেণি নির্বাচন করুন (Class)</label>
                <select id="searchClass" class="search-select">
                    <option value="">-- সকল শ্রেণি / শ্রেণি বাছাই করুন --</option>
                    <% if (typeof classMap !== 'undefined') { %>
                        <% Object.entries(classMap).forEach(function([k, v]) { %>
                            <option value="<%= k %>"><%= v.name %> শ্রেণি</option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <div class="stu-field">
                <label for="searchRoll">
                    <span>রোল নম্বর</span>
                    <span id="searchRollCountBadge" class="id-count-pill"></span>
                </label>
                <input type="text" id="searchRoll" list="searchRollDatalist" class="search-input" placeholder="রোল লিখুন বা শ্রেণি বাছাই করে অটো তালিকা থেকে বেছে নিন">
                <datalist id="searchRollDatalist"></datalist>

                <div id="searchRollAutoWrap" class="roll-auto-panel" style="display:none;">
                    <div class="roll-auto-title">
                        <span style="display:inline-flex;align-items:center;gap:6px;"><%- iconSvg('list-ol', 'app-svg-icon', 16) %> এই শ্রেণির অটো রোল তালিকা</span>
                        <span style="font-size:0.78rem; color:#475569;">ক্লিক করলে তথ্য ও ডকুমেন্টস খুলবে</span>
                    </div>
                    <select id="searchRollAutoSelect" class="search-select roll-auto-select"></select>
                    <div id="searchRollChips" class="roll-chips-list"></div>
                </div>
            </div>

            <div class="search-or-divider">অথবা নাম / আইডি / মোবাইল নম্বর দিয়ে খুঁজুন</div>

            <div class="stu-field">
                <input type="text" id="searchQuery" class="search-input" placeholder="আইডি / শিক্ষার্থীর নাম / মোবাইল / জন্ম নিবন্ধন">
            </div>

            <button type="button" onclick="searchStudent()" id="srchBtn" class="search-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;">
                <%- iconSvg('search', 'app-svg-icon', 18) %> <span>শিক্ষার্থী ও ডকুমেন্টস খুঁজুন</span>
            </button>
            <div id="loading">তথ্য খোঁজা হচ্ছে...</div>
            <div id="searchMsg"></div>
        </div>
    </section>

    <section id="multiple-results" class="no-print">
        <h3 style="font-size:1.05rem; color:#14532d;">একাধিক শিক্ষার্থী পাওয়া গেছে (<span id="multiCount"></span> জন)</h3>
        <div style="overflow-x:auto;">
            <table class="res-table">
                <thead>
                    <tr>
                        <th>রোল</th>
                        <th>শিক্ষার্থীর নাম</th>
                        <th>শ্রেণি</th>
                        <th>পিতার নাম</th>
                        <th>আইডি</th>
                        <th>অ্যাকশন</th>
                    </tr>
                </thead>
                <tbody id="result-list"></tbody>
            </table>
        </div>
    </section>

    <section id="print-preview-section">
        <div class="hub-controls-card no-print">
            <div class="hub-link-summary" id="hubStudentLinkBar"></div>
            <div class="doc-tabs-bar" role="tablist">
                <button type="button" class="doc-tab-btn active" data-doc="profile" onclick="switchDocTab('profile')">
                    <%- iconSvg('grad-cap', 'app-svg-icon', 17) %> <span>তথ্য কার্ড</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="idcard" onclick="switchDocTab('idcard')">
                    <%- iconSvg('id-badge', 'app-svg-icon', 17) %> <span>আইডি কার্ড</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="admit" onclick="switchDocTab('admit')">
                    <%- iconSvg('id-card', 'app-svg-icon', 17) %> <span>এডমিট কার্ড</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="marksheet" onclick="switchDocTab('marksheet')">
                    <%- iconSvg('poll', 'app-svg-icon', 17) %> <span>মার্কশিট</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="attestation" onclick="switchDocTab('attestation')">
                    <%- iconSvg('certificate', 'app-svg-icon', 17) %> <span>প্রত্যায়ন পত্র</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="testimonial" onclick="switchDocTab('testimonial')">
                    <%- iconSvg('award', 'app-svg-icon', 17) %> <span>প্রশংসা পত্র</span>
                </button>
            </div>

            <div class="print-toolbar">
                <button type="button" onclick="window.print()" class="tool-btn tool-green">
                    <%- iconSvg('printer', 'app-svg-icon', 17) %> <span>প্রিন্ট করুন (A4)</span>
                </button>
                <button type="button" onclick="downloadCurrentDocPdf()" class="tool-btn tool-rose">
                    <%- iconSvg('file-pdf', 'app-svg-icon', 17) %> <span>PDF ডাউনলোড</span>
                </button>
                <button type="button" onclick="downloadCurrentDocWord()" class="tool-btn tool-blue">
                    <%- iconSvg('file-word', 'app-svg-icon', 17) %> <span>Word (.docx)</span>
                </button>
                <button type="button" onclick="resetStudentSearch()" class="tool-btn tool-slate">
                    <%- iconSvg('refresh', 'app-svg-icon', 17) %> <span>নতুন অনুসন্ধান</span>
                </button>
            </div>

            <div class="cert-extra-bar" id="certExtraBar">
                <div>
                    <label>স্মারক নং</label>
                    <input type="text" id="certMemoInput" value="নালতা/ফা.মা./২০২৬/০১" oninput="renderActiveDoc()">
                </div>
                <div>
                    <label>তারিখ</label>
                    <input type="text" id="certDateInput" oninput="renderActiveDoc()">
                </div>
                <div>
                    <label>শিক্ষাবর্ষ</label>
                    <input type="text" id="certSessionInput" value="২০২৫-২০২৬" oninput="renderActiveDoc()">
                </div>
                <div>
                    <label>জিপিএ / ফলাফল</label>
                    <input type="text" id="certGpaInput" placeholder="যেমন: ৫.০০" oninput="renderActiveDoc()">
                </div>
                <div style="grid-column: 1 / -1;">
                    <label>মন্তব্য / চরিত্র সনদ বাক্য</label>
                    <input type="text" id="certRemarkInput" value="আমার জানামতে সে একজন উত্তম চরিত্রের অধিকারী এবং মাদ্রাসার নিয়ম-শৃঙ্খলা মেনে চলে।" oninput="renderActiveDoc()">
                </div>
            </div>

            <div id="stuExportStatus" style="display:none; margin-top:10px; padding:9px 13px; border-radius:9px; font-size:0.86rem; font-weight:600; text-align:center;"></div>
        </div>

        <div class="print-scroll">
            <div class="a4-doc-sheet" id="docCanvas"></div>
        </div>
    </section>
</div>

<script src="/student-picker.js"></script>
<script>
    const pickerLib = window.NadufmStudentPicker;
    const esc = pickerLib.escapeHtml;
    const bnNum = pickerLib.bnNum;
    const classSelectEl = document.getElementById('searchClass');
    const rollInputEl = document.getElementById('searchRoll');
    const queryInputEl = document.getElementById('searchQuery');
    document.getElementById('certDateInput').value = bnNum(new Date().toISOString().slice(0, 10));

    let allMatches = [];
    let currentStudent = null;
    let activeDocTab = 'profile';

    function isScienceGroupClient(raw) {
        const s = String(raw || '').trim().toLowerCase();
        if (!s) return false;
        return s.includes('বিজ্ঞান') || s.includes('science') || s === 'sci';
    }

    function formatStudentNameClient(name, isScience) {
        const clean = String(name || '').trim() || '—';
        if (!isScience) return clean;
        if (/\(?\s*(বিজ্ঞান|science)\s*\)?/i.test(clean)) return clean;
        return clean + ' (বিজ্ঞান)';
    }

    function normalizeRecord(raw) {
        const rs = raw.resultSummary || null;
        const groupText = raw.group || raw.groupLabel || (rs && rs.groupLabel) || '';
        const nameBnRaw = raw.name_bn || raw.name_en || '—';
        const isScience = Boolean(
            raw.isScience
            || (rs && rs.isScience)
            || isScienceGroupClient(groupText)
            || isScienceGroupClient(nameBnRaw)
        );
        const displayName = raw.displayName
            || (rs && rs.displayName)
            || formatStudentNameClient(nameBnRaw, isScience);
        return {
            roll: raw.roll || '',
            rollBn: raw.rollBn || (raw.roll ? bnNum(raw.roll) : ''),
            id: raw.id || raw.reg_no || '',
            reg_no: raw.reg_no || raw.id || raw.birth_reg || '',
            name_bn: nameBnRaw,
            displayName,
            isScience,
            group: groupText,
            name_en: raw.name_en || '',
            class_name: raw.class_name || raw.student_class || '',
            classKey: raw.classKey || '',
            father_bn: raw.father_bn || raw.f_name_bn || raw.f_name_en || '',
            father_en: raw.f_name_en || '',
            mother_bn: raw.mother_bn || raw.m_name_bn || raw.m_name_en || '',
            mother_en: raw.m_name_en || '',
            dob: raw.dob || '',
            gender: raw.gender || '',
            blood: raw.blood || '',
            mobile: raw.mobile || '',
            address: raw.address || ((raw.village || '') + (raw.union ? ', ' + raw.union : '')),
            upazila: raw.upazila || '',
            district: raw.district || '',
            session: raw.session || '২০২৫-২০২৬',
            gpa: raw.gpa || (rs && rs.gpa ? Number(rs.gpa).toFixed(2) : ''),
            meritRank: raw.meritRank || (rs ? rs.meritRank : null),
            remark: raw.remark || '',
            photo: pickerLib.safePhotoUrl(raw.photo),
            resultSummary: rs,
            p_school: raw.p_school || '',
            p_reg: raw.p_reg || '',
            timestamp: raw.timestamp || '',
        };
    }

    async function searchStudent() {
        const clsVal = classSelectEl.value.trim();
        const rollVal = rollInputEl.value.trim();
        const qVal = queryInputEl.value.trim();
        const searchMsg = document.getElementById('searchMsg');
        searchMsg.style.display = 'none';

        if (!clsVal && !rollVal && !qVal) {
            searchMsg.textContent = "অনুগ্রহ করে শ্রেণি/রোল বাছাই করুন অথবা নাম/আইডি লিখুন।";
            searchMsg.style.display = 'block';
            return;
        }

        document.getElementById('loading').style.display = 'block';
        document.getElementById('multiple-results').style.display = 'none';
        document.getElementById('print-preview-section').style.display = 'none';

        try {
            if (typeof navigator === 'undefined' || navigator.onLine) {
                try {
                    const url = '/api/portal/student-record?class=' + encodeURIComponent(clsVal) +
                        '&roll=' + encodeURIComponent(rollVal) +
                        '&q=' + encodeURIComponent(qVal);
                    const res = await fetch(url);
                    if (res.ok) {
                        const localData = await res.json();
                        if (localData.status === 'success' && Array.isArray(localData.matches) && localData.matches.length > 0) {
                            allMatches = localData.matches.map(normalizeRecord);
                            if (allMatches.length === 1 || rollVal) {
                                displayProfile(0);
                            } else {
                                showMultipleMatches(allMatches);
                            }
                            return;
                        }
                    }
                } catch (_) {
                    // Fall back to offline IndexedDB snapshot below
                }
            }

            if (window.NadufmOffline) {
                const offData = await window.NadufmOffline.findStudents({
                    classParam: clsVal,
                    rollParam: rollVal,
                    query: qVal,
                });
                if (offData && offData.status === 'success' && Array.isArray(offData.matches) && offData.matches.length > 0) {
                    allMatches = offData.matches.map(normalizeRecord);
                    if (allMatches.length === 1 || rollVal) {
                        displayProfile(0);
                    } else {
                        showMultipleMatches(allMatches);
                    }
                    return;
                }
            }

            // Fallback to external Google Apps Script if online and searching by query text
            const fallbackQ = qVal || rollVal;
            if (fallbackQ && (typeof navigator === 'undefined' || navigator.onLine)) {
                const scriptURL = 'https://script.google.com/macros/s/AKfycbze9QMzRJcCadXzDKcU0W12nigMYg0fOKk_4zY5JFWwo7R10L3PYx0YnjVNZXiWtA_npg/exec';
                const extRes = await fetch(`${scriptURL}?query=${encodeURIComponent(fallbackQ)}`);
                const extData = await extRes.json();
                if (Array.isArray(extData) && extData.length > 0) {
                    allMatches = extData.map(normalizeRecord);
                    if (allMatches.length === 1) {
                        displayProfile(0);
                    } else {
                        showMultipleMatches(allMatches);
                    }
                    return;
                }
            }

            searchMsg.textContent = "দুঃখিত, কোনো শিক্ষার্থীর তথ্য পাওয়া যায়নি।";
            searchMsg.style.display = 'block';
        } catch (err) {
            searchMsg.textContent = "অফলাইন ডেটাবেজ বা সার্ভার থেকে তথ্য খুঁজে পাওয়া যায়নি।";
            searchMsg.style.display = 'block';
        } finally {
            document.getElementById('loading').style.display = 'none';
        }
    }

    function showMultipleMatches(list) {
        const tbody = document.getElementById('result-list');
        document.getElementById('multiCount').textContent = bnNum(list.length);
        tbody.innerHTML = list.map((item, idx) => `
            <tr>
                <td><strong>${esc(item.rollBn || '—')}</strong></td>
                <td>${esc(item.displayName || item.name_bn)}</td>
                <td>${esc(item.class_name || '—')}</td>
                <td>${esc(item.father_bn || '—')}</td>
                <td>${esc(item.id || '—')}</td>
                <td><button type="button" onclick="displayProfile(${idx})" class="view-btn">দেখুন ও ডকুমেন্ট</button></td>
            </tr>
        `).join('');
        document.getElementById('multiple-results').style.display = 'block';
    }

    function displayProfile(index) {
        currentStudent = allMatches[index];
        if (!currentStudent) return;
        document.getElementById('certSessionInput').value = currentStudent.session || '২০২৫-২০২৬';
        document.getElementById('certGpaInput').value = currentStudent.gpa ? bnNum(currentStudent.gpa) : '';
        if (currentStudent.remark) {
            document.getElementById('certRemarkInput').value = currentStudent.remark;
        }
        const linkBar = document.getElementById('hubStudentLinkBar');
        if (linkBar) {
            const rs = currentStudent.resultSummary;
            const meritTag = rs && rs.meritRank ? (' · মেধাক্রম: ' + bnNum(rs.meritRank) + (rs.isScience ? ' (বিজ্ঞান)' : '')) : '';
            const resText = rs
                ? ('রেজাল্ট সংযুক্ত (' + (rs.examName || 'পরীক্ষা') + ' · GPA: ' + bnNum(Number(rs.gpa || 0).toFixed(2)) + meritTag + ')')
                : 'শিক্ষার্থী তথ্য সংযুক্ত (রেজাল্ট শিট এখনো আপলোড হয়নি)';
            linkBar.innerHTML =
                '<span><strong>' + esc(currentStudent.displayName || currentStudent.name_bn) + '</strong> · শ্রেণি: ' + esc(currentStudent.class_name || '—') + ' · রোল: ' + esc(currentStudent.rollBn || '—') + '</span>' +
                '<span class="hub-link-meta">' + esc(resText) + '</span>';
        }
        document.getElementById('multiple-results').style.display = 'none';
        document.getElementById('searchCardSection').style.display = 'none';
        document.getElementById('print-preview-section').style.display = 'block';
        renderActiveDoc();
    }

    function resetStudentSearch() {
        document.getElementById('print-preview-section').style.display = 'none';
        document.getElementById('searchCardSection').style.display = 'block';
    }

    function isLandscapeDoc(tab) {
        return tab === 'attestation' || tab === 'testimonial';
    }

    function syncDocOrientation(tab) {
        const landscape = isLandscapeDoc(tab);
        const canvas = document.getElementById('docCanvas');
        if (canvas) {
            canvas.classList.toggle('is-landscape', landscape);
        }
        const styleEl = document.getElementById('dynamicPrintOrientationStyle');
        if (styleEl) {
            styleEl.textContent = landscape
                ? '@media print { @page { size: A4 landscape; margin: 0; } }'
                : '@media print { @page { size: A4 portrait; margin: 0; } }';
        }
    }

    function switchDocTab(tab) {
        activeDocTab = tab;
