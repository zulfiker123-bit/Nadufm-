            }
        }
        [rollInputEl, queryInputEl].forEach(function (inp) {
            if (!inp) return;
            inp.addEventListener('keydown', function (ev) {
                if (ev.key === 'Enter') {
                    ev.preventDefault();
                    searchStudent();
                }
            });
        });
        if (initRoll) {
            rollInputEl.value = initRoll;
            if (!classSelectEl.value && initCls && navigator.onLine) {
                const url = '/api/portal/student-record?class=' + encodeURIComponent(initCls) + '&roll=' + encodeURIComponent(initRoll);
                fetch(url).then((r) => r.json()).then((localData) => {
                    if (localData && localData.status === 'success' && Array.isArray(localData.matches) && localData.matches.length > 0) {
                        allMatches = localData.matches.map(normalizeRecord);
                        displayProfile(0);
                    } else {
                        searchStudent();
                    }
                }).catch(() => searchStudent());
            } else if (!classSelectEl.value && initCls && window.NadufmOffline) {
                window.NadufmOffline.findStudents({ classParam: initCls, rollParam: initRoll }).then((offData) => {
                    if (offData && offData.status === 'success' && Array.isArray(offData.matches) && offData.matches.length > 0) {
                        allMatches = offData.matches.map(normalizeRecord);
                        displayProfile(0);
                    } else {
                        searchStudent();
                    }
                });
            } else {
                searchStudent();
            }
        }
    });
</script>

