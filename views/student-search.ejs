<%- include('partials/header') %>

<style>
    .stu-hub-shell {
        max-width: 960px;
        margin: 22px auto 36px auto;
        padding: 0 16px;
    }

    .search-card {
        background: #ffffff;
        max-width: 620px;
        margin: 0 auto 20px auto;
        border-radius: 18px;
        border: 1px solid rgba(15, 23, 42, 0.09);
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    .search-card-head {
        background: linear-gradient(135deg, #14532d 0%, #15803d 100%);
        color: #ffffff;
        padding: 22px 20px;
        text-align: center;
    }

    .search-card-head h1 { font-size: 1.3rem; font-weight: 700; margin: 0; }
    .search-card-head p { font-size: 0.9rem; opacity: 0.92; margin-top: 4px; }

    .search-card-body { padding: 22px 24px 24px 24px; }

    .stu-field { margin-bottom: 15px; }
    .stu-field label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        font-size: 0.94rem;
        margin-bottom: 6px;
        color: #0f172a;
    }

    .search-input,
    .search-select {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        border-radius: 10px;
        background: #f8faf9;
        color: #0f172a;
        font-family: inherit;
        font-size: 0.95rem;
        outline: none;
    }
    .search-input:focus,
    .search-select:focus { border-color: #15803d; background: #ffffff; }

    .roll-auto-panel {
        margin-top: 10px;
        background: #f8faf9;
        border: 1px solid rgba(21, 128, 61, 0.22);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .roll-auto-title {
        font-size: 0.84rem;
        font-weight: 700;
        color: #14532d;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .roll-auto-select {
        height: 40px !important;
        background: #ffffff !important;
        margin-bottom: 8px;
        font-size: 0.9rem !important;
    }

    .roll-chips-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        max-height: 150px;
        overflow-y: auto;
    }

    .roll-chip-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 8px;
        border: 1px solid rgba(21, 128, 61, 0.28);
        background: #ffffff;
        color: #0f172a;
        font-family: inherit;
        font-size: 0.84rem;
        cursor: pointer;
    }
    .roll-chip-btn:hover,
    .roll-chip-btn.active { background: #15803d; color: #ffffff; border-color: #15803d; }

    .roll-empty-note { font-size: 0.83rem; color: #64748b; }

    .id-count-pill {
        font-size: 0.78rem;
        font-weight: 700;
        color: #15803d;
        background: #dcfce7;
        padding: 2px 8px;
        border-radius: 999px;
    }

    .search-or-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 600;
        margin: 14px 0;
    }
    .search-or-divider::before,
    .search-or-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: rgba(15, 23, 42, 0.1);
    }

    .search-btn {
        width: 100%;
        min-height: 46px;
        padding: 0 22px;
        border: none;
        border-radius: 10px;
        background: #15803d;
        color: #ffffff;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.98rem;
        cursor: pointer;
    }
    .search-btn:hover { background: #14532d; }

    #loading { display: none; margin-top: 12px; color: #15803d; font-weight: 600; text-align: center; }
    #searchMsg { display: none; margin-top: 12px; color: #b91c1c; font-weight: 600; text-align: center; }

    #multiple-results {
        display: none;
        background: #ffffff;
        padding: 20px;
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, 0.09);
        margin-bottom: 20px;
    }
    .res-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 0.92rem; }
    .res-table th, .res-table td { padding: 10px 12px; border-bottom: 1px solid rgba(15, 23, 42, 0.08); text-align: left; }
    .res-table th { background: #f8faf9; color: #14532d; }
    .view-btn { background: #15803d; color: #ffffff; border: none; padding: 6px 14px; border-radius: 8px; cursor: pointer; font-family: inherit; font-weight: 600; }

    #print-preview-section { display: none; }

    .hub-controls-card {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.09);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .hub-link-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        margin-bottom: 12px;
        border-radius: 10px;
        background: #f8faf9;
        border: 1px solid rgba(21, 128, 61, 0.16);
        font-size: 0.86rem;
        color: #1e293b;
    }
    .hub-link-summary strong { color: #14532d; }
    .hub-link-meta { font-weight: 600; color: #475569; }

    .doc-tabs-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        margin-bottom: 12px;
    }

    .doc-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 39px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid rgba(15, 23, 42, 0.12);
        background: #f8faf9;
        color: #0f172a;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
    }
    .doc-tab-btn.active {
        background: #14532d;
        color: #ffffff;
        border-color: #14532d;
    }

    .print-toolbar {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .tool-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 10px;
        border: none;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
    }
    .tool-green { background: #15803d; color: #ffffff; }
    .tool-rose { background: #be123c; color: #ffffff; }
    .tool-blue { background: #1d4ed8; color: #ffffff; }
    .tool-slate { background: #f1f5f9; color: #0f172a; border: 1px solid rgba(15, 23, 42, 0.12); }

    .cert-extra-bar {
        display: none;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px dashed rgba(15, 23, 42, 0.12);
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 10px;
    }
    .cert-extra-bar.visible { display: grid; }
    .cert-extra-bar input {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.88rem;
    }
    .cert-extra-bar label { display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 3px; }

    .print-scroll { overflow-x: auto; padding-bottom: 8px; }

    .a4-doc-sheet {
        background: #ffffff;
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 14mm 15mm;
        position: relative;
        border: 1px solid rgba(15, 23, 42, 0.16);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
        color: #0f172a;
    }
    .a4-doc-sheet * {
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    /* Profile Card Styles */
    .profile-frame { border: 2px solid #166534; padding: 16px; min-height: 266mm; display: flex; flex-direction: column; justify-content: space-between; }
    .header-wrapper { display: flex; align-items: center; border-bottom: 2px solid #166534; padding-bottom: 10px; margin-bottom: 14px; position: relative; min-height: 92px; }
    .logo-top { width: 68px; margin-right: 15px; }
    .header-text { padding-right: 105px; }
    .header-text h2 { color: #166534; margin: 0; font-size: 19px; font-weight: 800; }
    .header-text p { margin: 2px 0; font-size: 12px; color: #334155; font-weight: 600; }
    .photo-box { width: 92px; height: 108px; border: 1px solid #0f172a; position: absolute; top: 0; right: 0; display: flex; align-items: center; justify-content: center; background: #fff; overflow: hidden; }
    .photo-box img { width: 100%; height: 100%; object-fit: cover; }
    .form-title { text-align: center; margin: 8px 0 12px 0; font-weight: 700; font-size: 15.5px; color: #166534; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; }
    .section-title { background: #f0f7f2; padding: 4px 10px; font-weight: 700; margin-top: 10px; margin-bottom: 6px; font-size: 13px; color: #14532d; border: 1px solid #d1e7d9; }
    .doc-field { display: flex; align-items: flex-end; margin-bottom: 7px; }
    .doc-label { font-weight: 600; font-size: 13px; color: #1e293b; white-space: nowrap; }
    .dotted-line { border-bottom: 1px dotted #555; flex-grow: 1; margin-left: 6px; min-height: 18px; color: #000; font-weight: 700; padding-left: 5px; font-size: 13.5px; }
    .doc-row { display: flex; gap: 15px; }
    .doc-col { flex: 1; }
    .signature-area { margin-top: 44px; display: flex; justify-content: space-between; }
    .sig-box { border-top: 1.5px solid #333; width: 155px; text-align: center; font-size: 12.5px; padding-top: 4px; font-weight: 700; }

    /* Certificate / Attestation / Testimonial Frame */
    .cert-frame { border: 3px double #14532d; padding: 20px 24px; min-height: 266mm; display: flex; flex-direction: column; justify-content: space-between; }
    .cert-inst-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #166534; padding-bottom: 12px; margin-bottom: 16px; text-align: center; }
    .cert-doc-badge { text-align: center; font-size: 19px; font-weight: 700; color: #14532d; text-decoration: underline; margin: 16px 0 22px 0; }
    .cert-memo-row { display: flex; justify-content: space-between; font-weight: 700; font-size: 14px; margin-bottom: 10px; }
    .cert-body-text { font-size: 16px; line-height: 2; text-align: justify; }

    /* Marksheet Table */
    .ms-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13.5px; }
    .ms-table th, .ms-table td { border: 1px solid #166534; padding: 7px 6px; text-align: center; }
    .ms-table th { background: #166534; color: #ffffff; }
    .ms-summary { margin-top: 16px; border: 1.5px solid #166534; display: grid; grid-template-columns: repeat(4, 1fr); font-weight: 700; }
    .ms-summary div { padding: 8px 6px; border-right: 1px solid #166534; text-align: center; }
    .ms-summary div:last-child { border-right: none; }

    /* ID card pair inside A4 sheet */
    .id-pair { display: flex; justify-content: center; gap: 22px; flex-wrap: wrap; margin-top: 18px; }
    .id-card-box { width: 72mm; min-height: 112mm; border: 2px solid #14532d; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; background: #fff; }
    .id-card-top { background: #14532d; color: #fff; padding: 10px 8px 12px 8px; text-align: center; border-bottom: 3px solid #f59e0b; }

    @media print {
        @page { size: A4; margin: 0; }
        .no-print, .app-footer, .app-topbar, .mobile-bottom-nav { display: none !important; }
        body { background: #ffffff !important; padding: 0 !important; margin: 0 !important; }
        .stu-hub-shell { margin: 0 !important; max-width: 100% !important; padding: 0 !important; }
        #print-preview-section { display: block !important; }
        .a4-doc-sheet { border: none !important; box-shadow: none !important; }
    }
</style>

<div class="stu-hub-shell">
    <section class="search-card no-print" id="searchCardSection">
        <div class="search-card-head">
            <h1>শিক্ষার্থী তথ্য ও সকল ডকুমেন্ট পোর্টাল</h1>
            <p>শ্রেণি বাছাই করলে অটো রোল তালিকা প্রদর্শিত হবে · সরাসরি রোল বা নাম/আইডি দিয়েও খুঁজতে পারবেন</p>
        </div>
        <div class="search-card-body">
            <div class="stu-field">
                <label for="searchClass">শ্রেণি নির্বাচন করুন (Class)</label>
                <select id="searchClass" class="search-select">
                    <option value="">-- সকল শ্রেণি / শ্রেণি বাছাই করুন --</option>
                    <% if (typeof classMap !== 'undefined') { %>
                        <% Object.entries(classMap).forEach(function([k, v]) { %>
                            <option value="<%= k %>"><%= v.name %> শ্রেণি</option>
                        <% }); %>
                    <% } %>
                </select>
            </div>

            <div class="stu-field">
                <label for="searchRoll">
                    <span>রোল নম্বর</span>
                    <span id="searchRollCountBadge" class="id-count-pill"></span>
                </label>
                <input type="text" id="searchRoll" list="searchRollDatalist" class="search-input" placeholder="রোল লিখুন বা শ্রেণি বাছাই করে অটো তালিকা থেকে বেছে নিন">
                <datalist id="searchRollDatalist"></datalist>

                <div id="searchRollAutoWrap" class="roll-auto-panel" style="display:none;">
                    <div class="roll-auto-title">
                        <span><i class="fas fa-list-ol"></i> এই শ্রেণির অটো রোল তালিকা</span>
                        <span style="font-size:0.78rem; color:#475569;">ক্লিক করলে তথ্য ও ডকুমেন্টস খুলবে</span>
                    </div>
                    <select id="searchRollAutoSelect" class="search-select roll-auto-select"></select>
                    <div id="searchRollChips" class="roll-chips-list"></div>
                </div>
            </div>

            <div class="search-or-divider">অথবা নাম / আইডি / মোবাইল নম্বর দিয়ে খুঁজুন</div>

            <div class="stu-field">
                <input type="text" id="searchQuery" class="search-input" placeholder="আইডি / শিক্ষার্থীর নাম / মোবাইল / জন্ম নিবন্ধন">
            </div>

            <button type="button" onclick="searchStudent()" id="srchBtn" class="search-btn">
                <i class="fas fa-search"></i> শিক্ষার্থী ও ডকুমেন্টস খুঁজুন
            </button>
            <div id="loading">তথ্য খোঁজা হচ্ছে...</div>
            <div id="searchMsg"></div>
        </div>
    </section>

    <section id="multiple-results" class="no-print">
        <h3 style="font-size:1.05rem; color:#14532d;">একাধিক শিক্ষার্থী পাওয়া গেছে (<span id="multiCount"></span> জন)</h3>
        <div style="overflow-x:auto;">
            <table class="res-table">
                <thead>
                    <tr>
                        <th>রোল</th>
                        <th>শিক্ষার্থীর নাম</th>
                        <th>শ্রেণি</th>
                        <th>পিতার নাম</th>
                        <th>আইডি</th>
                        <th>অ্যাকশন</th>
                    </tr>
                </thead>
                <tbody id="result-list"></tbody>
            </table>
        </div>
    </section>

    <section id="print-preview-section">
        <div class="hub-controls-card no-print">
            <div class="hub-link-summary" id="hubStudentLinkBar"></div>
            <div class="doc-tabs-bar" role="tablist">
                <button type="button" class="doc-tab-btn active" data-doc="profile" onclick="switchDocTab('profile')">
                    <i class="fas fa-user-graduate"></i> <span>তথ্য কার্ড</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="idcard" onclick="switchDocTab('idcard')">
                    <i class="fas fa-id-badge"></i> <span>আইডি কার্ড</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="admit" onclick="switchDocTab('admit')">
                    <i class="fas fa-id-card"></i> <span>এডমিট কার্ড</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="marksheet" onclick="switchDocTab('marksheet')">
                    <i class="fas fa-poll"></i> <span>মার্কশিট</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="attestation" onclick="switchDocTab('attestation')">
                    <i class="fas fa-certificate"></i> <span>প্রত্যায়ন পত্র</span>
                </button>
                <button type="button" class="doc-tab-btn" data-doc="testimonial" onclick="switchDocTab('testimonial')">
                    <i class="fas fa-award"></i> <span>প্রশংসা পত্র</span>
                </button>
            </div>

            <div class="print-toolbar">
                <button type="button" onclick="window.print()" class="tool-btn tool-green">
                    <i class="fas fa-print"></i> <span>প্রিন্ট করুন (A4)</span>
                </button>
                <button type="button" onclick="downloadCurrentDocPdf()" class="tool-btn tool-rose">
                    <i class="fas fa-file-pdf"></i> <span>PDF ডাউনলোড</span>
                </button>
                <button type="button" onclick="downloadCurrentDocWord()" class="tool-btn tool-blue">
                    <i class="fas fa-file-word"></i> <span>Word (.doc)</span>
                </button>
                <button type="button" onclick="resetStudentSearch()" class="tool-btn tool-slate">
                    <i class="fas fa-redo"></i> <span>নতুন অনুসন্ধান</span>
                </button>
            </div>

            <div class="cert-extra-bar" id="certExtraBar">
                <div>
                    <label>স্মারক নং</label>
                    <input type="text" id="certMemoInput" value="নালতা/ফা.মা./২০২৬/০১" oninput="renderActiveDoc()">
                </div>
                <div>
                    <label>তারিখ</label>
                    <input type="text" id="certDateInput" oninput="renderActiveDoc()">
                </div>
                <div>
                    <label>শিক্ষাবর্ষ</label>
                    <input type="text" id="certSessionInput" value="২০২৫-২০২৬" oninput="renderActiveDoc()">
                </div>
                <div>
                    <label>জিপিএ / ফলাফল</label>
                    <input type="text" id="certGpaInput" placeholder="যেমন: ৫.০০" oninput="renderActiveDoc()">
                </div>
                <div style="grid-column: 1 / -1;">
                    <label>মন্তব্য / চরিত্র সনদ বাক্য</label>
                    <input type="text" id="certRemarkInput" value="আমার জানামতে সে একজন উত্তম চরিত্রের অধিকারী এবং মাদ্রাসার নিয়ম-শৃঙ্খলা মেনে চলে।" oninput="renderActiveDoc()">
                </div>
            </div>

            <div id="stuExportStatus" style="display:none; margin-top:10px; padding:9px 13px; border-radius:9px; font-size:0.86rem; font-weight:600; text-align:center;"></div>
        </div>

        <div class="print-scroll">
            <div class="a4-doc-sheet" id="docCanvas"></div>
        </div>
    </section>
</div>

<script src="/vendor/html2pdf.bundle.min.js" defer></script>
<script src="/doc-export.js" defer></script>
<script src="/student-picker.js"></script>
<script>
    const pickerLib = window.NadufmStudentPicker;
    const esc = pickerLib.escapeHtml;
    const bnNum = pickerLib.bnNum;
    const classSelectEl = document.getElementById('searchClass');
    const rollInputEl = document.getElementById('searchRoll');
    const queryInputEl = document.getElementById('searchQuery');
    document.getElementById('certDateInput').value = bnNum(new Date().toISOString().slice(0, 10));

    let allMatches = [];
    let currentStudent = null;
    let activeDocTab = 'profile';

    function isScienceGroupClient(raw) {
        const s = String(raw || '').trim().toLowerCase();
        if (!s) return false;
        return s.includes('বিজ্ঞান') || s.includes('science') || s === 'sci';
    }

    function formatStudentNameClient(name, isScience) {
        const clean = String(name || '').trim() || '—';
        if (!isScience) return clean;
        if (/\(?\s*(বিজ্ঞান|science)\s*\)?/i.test(clean)) return clean;
        return clean + ' (বিজ্ঞান)';
    }

    function normalizeRecord(raw) {
        const rs = raw.resultSummary || null;
        const groupText = raw.group || raw.groupLabel || (rs && rs.groupLabel) || '';
        const nameBnRaw = raw.name_bn || raw.name_en || '—';
        const isScience = Boolean(
            raw.isScience
            || (rs && rs.isScience)
            || isScienceGroupClient(groupText)
            || isScienceGroupClient(nameBnRaw)
        );
        const displayName = raw.displayName
            || (rs && rs.displayName)
            || formatStudentNameClient(nameBnRaw, isScience);
        return {
            roll: raw.roll || '',
            rollBn: raw.rollBn || (raw.roll ? bnNum(raw.roll) : ''),
            id: raw.id || raw.reg_no || '',
            reg_no: raw.reg_no || raw.id || raw.birth_reg || '',
            name_bn: nameBnRaw,
            displayName,
            isScience,
            group: groupText,
