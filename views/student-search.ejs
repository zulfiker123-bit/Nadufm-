            await window.NadufmExport.exportElementToA4Pdf({
                element: el,
                filename: `${activeDocTab}-${Date.now()}.pdf`,
                marginMm: 0,
                orientation,
                onStatus: setExportStatus
            });
        } catch (err) {
            setExportStatus(err?.message || 'PDF ডাউনলোড ব্যর্থ হয়েছে।', true);
        }
    }

