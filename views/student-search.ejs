                                স্থানীয় এক্সেল রেজাল্ট শিটে এই শিক্ষার্থীর বিষয়ভিত্তিক নম্বর এখনো যুক্ত করা হয়নি। অনলাইন বোর্ড/গুগল শিট থেকে সরাসরি মার্কশিট দেখতে নিচের বাটনে ক্লিক করুন:
                            </p>
                            <a href="/result.php?class=${qCls}&roll=${qRoll}${embedQ}" class="tool-btn tool-green" style="display:inline-flex;">
                                <i class="fas fa-poll"></i> <span>অনলাইন ফলাফল পোর্টালে মার্কশিট দেখুন</span>
                            </a>
                        </div>
                    </div>
                `;
                return;
            }

            canvas.innerHTML = `
                <div class="profile-frame">
                    <div>
                        <div class="cert-inst-header">
                            <img src="/logo.png" style="width:62px;" alt="Logo">
                            <div style="flex:1;">
                                <h2 style="margin:0; color:#14532d; font-size:20px;">নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</h2>
                                <p style="margin:2px 0; font-size:12.5px;">নলতা শরীফ, কালিগঞ্জ, সাতক্ষীরা · EIIN: ১১৮৭৭৮</p>
                                <p style="margin:2px 0; font-size:13.5px; color:#166534; font-weight:700;">${esc(rs.examName)} - ${esc(rs.year)} | একাডেমিক ট্রান্সক্রিপ্ট</p>
                            </div>
                            <table style="border-collapse:collapse; font-size:10px; border:1px solid #166534;">
                                <tr><th style="border:1px solid #166534; padding:1px 4px;">LG</th><th style="border:1px solid #166534; padding:1px 4px;">GP</th></tr>
                                <tr><td style="border:1px solid #166534; padding:1px 4px;">A+</td><td style="border:1px solid #166534; padding:1px 4px;">5.0</td></tr>
                                <tr><td style="border:1px solid #166534; padding:1px 4px;">A</td><td style="border:1px solid #166534; padding:1px 4px;">4.0</td></tr>
                                <tr><td style="border:1px solid #166534; padding:1px 4px;">A-</td><td style="border:1px solid #166534; padding:1px 4px;">3.5</td></tr>
                                <tr><td style="border:1px solid #166534; padding:1px 4px;">B</td><td style="border:1px solid #166534; padding:1px 4px;">3.0</td></tr>
                                <tr><td style="border:1px solid #166534; padding:1px 4px;">C</td><td style="border:1px solid #166534; padding:1px 4px;">2.0</td></tr>
                                <tr><td style="border:1px solid #166534; padding:1px 4px;">D</td><td style="border:1px solid #166534; padding:1px 4px;">1.0</td></tr>
                                <tr><td style="border:1px solid #166534; padding:1px 4px;">F</td><td style="border:1px solid #166534; padding:1px 4px;">0.0</td></tr>
                            </table>
                        </div>
                        <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; font-weight:700; border-bottom:1.5px solid #166534; padding:6px 4px; margin-bottom:10px;">
                            <span>নাম: ${esc(rs.displayName || st.displayName || st.name_bn)}</span>
                            ${st.father_bn ? `<span>পিতা: ${esc(st.father_bn)}</span>` : ''}
                            <span>শ্রেণি: ${esc(st.class_name || rs.className || '—')}</span>
                            <span>রোল: ${esc(st.rollBn || '—')}</span>
                        </div>
                        <table class="ms-table">
                            <thead>
                                <tr>
                                    <th style="width:7%;">নং</th>
                                    <th style="width:41%; text-align:left; padding-left:10px;">বিষয়ের নাম (পূর্ণমান)</th>
                                    <th style="width:12%;">পূর্ণমান</th>
                                    <th style="width:14%;">প্রাপ্ত নম্বর</th>
                                    <th style="width:13%;">লেটার গ্রেড</th>
                                    <th style="width:13%;">গ্রেড পয়েন্ট</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${rs.subjects.map((sub, i) => `
                                    <tr>
                                        <td>${bnNum(i + 1)}</td>
                                        <td style="text-align:left; padding-left:10px; font-weight:600;">${esc(sub.name)} (${bnNum(sub.fullMarks)})</td>
                                        <td>${bnNum(sub.fullMarks)}</td>
                                        <td style="font-weight:700;">${esc(sub.obtained === 'Abs' ? 'Abs' : bnNum(sub.obtained))}</td>
                                        <td style="font-weight:700; color:${sub.isFail ? '#b91c1c' : '#166534'};">${esc(sub.grade)}</td>
                                        <td>${bnNum(sub.gp)}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                        <div class="ms-summary">
                            <div>ফলাফল: <span style="color:${rs.isPromoted ? '#b45309' : (rs.failCount > 0 ? '#b91c1c' : '#15803d')};">${esc(rs.statusBn)}</span></div>
                            <div>মোট নম্বর: ${bnNum(rs.totalObtained)} / ${bnNum(rs.totalFullMarks)}</div>
                            <div>GPA: ${bnNum(Number(rs.gpa || 0).toFixed(2))}</div>
                            <div>মেধাক্রম: ${rs.meritRank ? (bnNum(rs.meritRank) + (rs.isScience ? ' (বিজ্ঞান)' : '')) : '—'}</div>
                        </div>
                    </div>
                    <div class="signature-area">
                        <div class="sig-box">শ্রেণি শিক্ষকের স্বাক্ষর</div>
                        <div class="sig-box">অভিভাবকের স্বাক্ষর</div>
                        <div class="sig-box">অধ্যক্ষের স্বাক্ষর</div>
                    </div>
                </div>
            `;
            return;
        }

        // Attestation or Testimonial
        const isTestimonial = activeDocTab === 'testimonial';
        const certTitle = isTestimonial
            ? 'প্রশংসা পত্র (TESTIMONIAL)'
            : 'প্রত্যায়ন পত্র (ATTESTATION CERTIFICATE)';
        const bodyParagraph = isTestimonial
            ? `এই মর্মে প্রত্যয়ন ও প্রশংসা করা যাচ্ছে যে, <strong>${esc(st.name_bn)}</strong>, পিতা: <strong>${esc(st.father_bn || '---')}</strong>, মাতা: <strong>${esc(st.mother_bn || '---')}</strong>, ঠিকানা: ${esc(st.address || 'নলতা শরীফ, কালিগঞ্জ, সাতক্ষীরা')} — অত্র <strong>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</strong>-এর একজন নিয়মিত শিক্ষার্থী ছিল। সে অত্র প্রতিষ্ঠান থেকে <strong>${esc(st.class_name || '---')}</strong> শ্রেণির পরীক্ষায় (শিক্ষাবর্ষ: ${esc(sessionStr)}, রোল নং: <strong>${esc(st.rollBn || '---')}</strong>, রেজিস্ট্রেশন/আইডি নং: ${esc(st.reg_no || st.id || '---')}) অংশগ্রহণ করে <strong>GPA ${esc(gpaStr)}</strong> অর্জনপূর্বক উত্তীর্ণ হয়েছে। নথিপত্র অনুযায়ী তার জন্ম তারিখ <strong>${esc(st.dob || '---')}</strong>।<br><br>${esc(remarkStr)}<br><br>আমি তার জীবনের সার্বিক মঙ্গল ও উজ্জ্বল ভবিষ্যৎ কামনা করি।`
            : `এই মর্মে প্রত্যয়ন করা যাচ্ছে যে, <strong>${esc(st.name_bn)}</strong>, পিতা: <strong>${esc(st.father_bn || '---')}</strong>, মাতা: <strong>${esc(st.mother_bn || '---')}</strong>, গ্রাম/ঠিকানা: ${esc(st.address || 'নলতা শরীফ, কালিগঞ্জ, সাতক্ষীরা')} — অত্র <strong>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</strong>-এর <strong>${esc(st.class_name || '---')}</strong> শ্রেণির (শিক্ষাবর্ষ: ${esc(sessionStr)}) একজন নিয়মিত শিক্ষার্থী। তার শ্রেণি রোল নম্বর <strong>${esc(st.rollBn || '---')}</strong> এবং রেজিস্ট্রেশন/আইডি নং <strong>${esc(st.reg_no || st.id || '---')}</strong>। প্রতিষ্ঠানের ভর্তি রেজিস্টার অনুযায়ী তার জন্ম তারিখ <strong>${esc(st.dob || '---')}</strong>।<br><br>${esc(remarkStr)}<br><br>উক্ত শিক্ষার্থীর চরিত্র ও নৈতিকতা সম্পর্কে আমাদের জানা মতে কোনো বিরূপ তথ্য নেই। আমি তার সর্বাঙ্গীণ উন্নতি কামনা করি।`;

        canvas.innerHTML = `
            <div class="cert-frame">
                <div>
                    <div class="cert-inst-header">
                        <img src="/logo.png" style="width:68px;" alt="Logo">
                        <div style="flex:1;">
                            <h2 style="margin:0; color:#14532d; font-size:21px;">নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</h2>
                            <p style="margin:2px 0; font-size:13px;">ডাকঘর: নলতা শরীফ, উপজেলা: কালিগঞ্জ, জেলা: সাতক্ষীরা</p>
                            <p style="margin:2px 0; font-size:12.5px;">স্থাপিত: ১৯৮০ খ্রি. · EIIN: ১১৮৭৭৮ · ওয়েবসাইট: nadufm.edu.bd</p>
                        </div>
                        <div style="width:68px;"></div>
                    </div>

                    <div class="cert-memo-row">
                        <span>স্মারক নং: ${esc(memo)}</span>
                        <span>তারিখ: ${esc(dateStr)}</span>
                    </div>

                    <div class="cert-doc-badge">${certTitle}</div>

                    <div class="cert-body-text">${bodyParagraph}</div>
                </div>

                <div class="signature-area" style="margin-top:64px;">
                    <div class="sig-box">প্রস্তুতকারীর স্বাক্ষর</div>
                    <div class="sig-box" style="width:210px;">অধ্যক্ষ<br>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</div>
                </div>
            </div>
        `;
    }

    function setExportStatus(msg, isErr) {
        const el = document.getElementById('stuExportStatus');
        el.style.display = 'block';
        el.textContent = msg;
        el.style.background = isErr ? '#fef2f2' : '#f0fdf4';
        el.style.color = isErr ? '#b91c1c' : '#15803d';
        el.style.border = isErr ? '1px solid #fecaca' : '1px solid #bbf7d0';
    }

    async function downloadCurrentDocPdf() {
        const el = document.getElementById('docCanvas');
        try {
            if (!window.NadufmExport) throw new Error('এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            await window.NadufmExport.exportElementToA4Pdf({
                element: el,
                filename: `${activeDocTab}-${Date.now()}.pdf`,
                marginMm: 0,
                onStatus: setExportStatus
            });
        } catch (err) {
            setExportStatus(err?.message || 'PDF ডাউনলোড ব্যর্থ হয়েছে।', true);
        }
    }

    async function downloadCurrentDocWord() {
        const el = document.getElementById('docCanvas');
        const cssText = '@page Section1 { size: 210mm 297mm; margin: 14mm 15mm; }' +
            'div.Section1 { page: Section1; font-family: "Nikosh", "Kalpurush", Arial, sans-serif; font-size: 14px; color: #0f172a; }' +
            '.cert-frame, .profile-frame { border: 2px solid #166534; padding: 18px; }' +
            'table { width: 100%; border-collapse: collapse; }' +
            'table.ms-table th, table.ms-table td { border: 1px solid #166534; padding: 6px; text-align: center; }' +
            'table.ms-table th { background-color: #166534; color: #ffffff; }';
        try {
            if (!window.NadufmExport) throw new Error('এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            await window.NadufmExport.exportElementToWord({
                element: el,
                filename: `${activeDocTab}-${Date.now()}.doc`,
                title: activeDocTab,
                cssText: cssText,
                onStatus: setExportStatus
            });
        } catch (err) {
            setExportStatus(err?.message || 'Word ডাউনলোড ব্যর্থ হয়েছে।', true);
        }
    }

    pickerLib.attachClassRollPicker({
        classSelect: classSelectEl,
        rollInput: rollInputEl,
        rollAutoSelect: document.getElementById('searchRollAutoSelect'),
        rollListWrap: document.getElementById('searchRollAutoWrap'),
        rollChipsContainer: document.getElementById('searchRollChips'),
        rollDatalist: document.getElementById('searchRollDatalist'),
        rollCountBadge: document.getElementById('searchRollCountBadge'),
        onRollPicked: function () {
            searchStudent();
        }
    }).then(function (ctrl) {
        const params = new URLSearchParams(window.location.search);
        const initCls = params.get('class');
        const initRoll = params.get('roll');
        const initDoc = params.get('doc');
        if (initDoc && ['profile', 'idcard', 'admit', 'marksheet', 'attestation', 'testimonial'].includes(initDoc)) {
            activeDocTab = initDoc;
            document.querySelectorAll('.doc-tab-btn').forEach((btn) => {
                btn.classList.toggle('active', btn.dataset.doc === initDoc);
            });
            document.getElementById('certExtraBar').classList.toggle('visible', initDoc === 'attestation' || initDoc === 'testimonial');
        }
        if (initCls) {
            classSelectEl.value = initCls;
            if (!classSelectEl.value) {
                const normInit = String(initCls).replace(/^excel:/i, '').trim().toLowerCase();
                for (let i = 0; i < classSelectEl.options.length; i++) {
                    const opt = classSelectEl.options[i];
                    const optTxt = String(opt.textContent || '').toLowerCase();
                    if (opt.value && (opt.value.toLowerCase() === normInit || (normInit && optTxt.includes(normInit)))) {
                        classSelectEl.value = opt.value;
                        break;
                    }
                }
            }
            if (ctrl && classSelectEl.value) ctrl.loadRollsForClass(classSelectEl.value);
        }
        if (initRoll) {
            rollInputEl.value = initRoll;
            if (!classSelectEl.value && initCls) {
                // Temporarily use initCls via direct fetch if option wasn't in dropdown
                const url = '/api/portal/student-record?class=' + encodeURIComponent(initCls) + '&roll=' + encodeURIComponent(initRoll);
                fetch(url).then((r) => r.json()).then((localData) => {
                    if (localData && localData.status === 'success' && Array.isArray(localData.matches) && localData.matches.length > 0) {
                        allMatches = localData.matches.map(normalizeRecord);
                        displayProfile(0);
                    } else {
                        searchStudent();
                    }
                }).catch(() => searchStudent());
            } else {
                searchStudent();
            }
        }
    });
</script>

