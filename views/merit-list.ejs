<%- include('partials/header') %>

<style>
    .merit-shell {
        max-width: 1020px;
        margin: 24px auto 36px auto;
        padding: 0 16px;
    }

    .merit-card {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.09);
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.07);
    }

    .merit-header {
        text-align: center;
        border-bottom: 1px solid rgba(15, 23, 42, 0.09);
        padding-bottom: 16px;
        margin-bottom: 20px;
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    .merit-header * {
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    .merit-header h1 {
        color: #14532d;
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
    }

    .merit-subtitle {
        color: #475569;
        font-size: 0.94rem;
        margin-top: 4px;
    }

    .merit-form {
        background: #f8faf9;
        border: 1px solid rgba(15, 23, 42, 0.08);
        padding: 16px;
        border-radius: 14px;
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .merit-select-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .merit-select-label {
        font-size: 0.92rem;
        font-weight: 700;
        color: #14532d;
        white-space: nowrap;
    }

    .merit-form select {
        height: 44px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        background: #ffffff;
        min-width: 260px;
        font-size: 0.95rem;
        color: #0f172a;
    }

    .merit-summary-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 10px;
        margin-bottom: 16px;
        font-variant-numeric: tabular-nums;
    }

    .merit-summary-item {
        background: #f8faf9;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 11px;
        padding: 10px 14px;
        text-align: center;
    }

    .merit-summary-lbl {
        display: block;
        font-size: 0.78rem;
        color: #475569;
        font-weight: 600;
    }

    .merit-summary-val {
        display: block;
        font-size: 1.05rem;
        font-weight: 700;
        color: #14532d;
        margin-top: 2px;
    }

    .merit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 11px;
        border: 1px solid #146c34;
        background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
        color: #ffffff;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3.5px 0 #0e5427, 0 6px 14px -3px rgba(21, 128, 61, 0.3);
        transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease;
    }

    .merit-btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
    .merit-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 #0e5427; }
    .merit-btn-blue { background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%); border-color: #1e40af; box-shadow: inset 0 1px 0 rgba(255,255,255,0.26), 0 3.5px 0 #172f82, 0 6px 14px -3px rgba(29,78,216,0.3); }
    .merit-btn-blue:active { box-shadow: 0 1px 0 #172f82; }
    .merit-btn-rose { background: linear-gradient(180deg, #e11d48 0%, #be123c 100%); border-color: #9f1239; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 3.5px 0 #881337, 0 6px 14px -3px rgba(190,18,60,0.3); }
    .merit-btn-rose:active { box-shadow: 0 1px 0 #881337; }

    .merit-btn-secondary {
        background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%);
        color: #0f172a;
        border: 1px solid rgba(15, 23, 42, 0.14);
        box-shadow: inset 0 1px 0 #ffffff, 0 3px 0 rgba(15, 23, 42, 0.1), 0 5px 10px -3px rgba(15, 23, 42, 0.08);
    }
    .merit-btn-secondary:active { box-shadow: 0 1px 0 rgba(15, 23, 42, 0.1); }

    .merit-table-wrap {
        overflow-x: auto;
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    .merit-table-wrap * {
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    table.merit-table {
        width: 100%;
        border-collapse: collapse;
        font-variant-numeric: tabular-nums;
    }

    table.merit-table th {
        background: #14532d;
        color: #ffffff;
        padding: 11px 10px;
        text-align: center;
        font-size: 0.9em;
        font-weight: 600;
    }

    table.merit-table td {
        padding: 10px;
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        text-align: center;
        font-size: 0.94em;
    }

    table.merit-table tr:nth-child(even) { background: #f8faf9; }
    .rank-num { font-weight: 700; color: #14532d; }
    .status-pass { color: #15803d; font-weight: 700; }
    .status-promoted { color: #b45309; font-weight: 700; }
    .status-fail { color: #b91c1c; font-weight: 700; }
    .status-abs { color: #64748b; }
    .absent-row { opacity: 0.78; }
    .merit-doc-links { display: inline-flex; align-items: center; justify-content: center; gap: 5px; flex-wrap: wrap; }
    .merit-doc-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid rgba(21, 128, 61, 0.25);
        background: #f0fdf4;
        color: #14532d;
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }
    .merit-doc-link:hover { background: #15803d; color: #ffffff; border-color: #15803d; }
    .merit-doc-link.alt { background: #f8fafc; color: #0f172a; border-color: rgba(15, 23, 42, 0.16); }
    .merit-doc-link.alt:hover { background: #1e293b; color: #ffffff; border-color: #1e293b; }

    .merit-group-tabs {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .merit-group-tab {
        min-height: 38px;
        padding: 0 14px;
        border-radius: 9px;
        border: 1px solid rgba(15, 23, 42, 0.12);
        background: #f8faf9;
        color: #0f172a;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
    }

    .merit-group-tab.active {
        background: #14532d;
        color: #ffffff;
        border-color: #14532d;
    }

    .merit-section-block {
        margin-bottom: 24px;
    }

    .merit-section-block:last-of-type {
        margin-bottom: 0;
    }

    .merit-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px 14px;
        margin-bottom: 12px;
        border-radius: 10px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #14532d;
        font-size: 1.02rem;
        font-weight: 700;
    }

    .merit-section-heading.science {
        background: #eff6ff;
        border-color: #bfdbfe;
        color: #1e3a8a;
    }

    .merit-section-heading.science + .merit-summary-bar + .merit-table-wrap table.merit-table th {
        background: #1e3a8a;
    }

    @page {
        size: A4 portrait;
        margin: 12mm;
    }

    @media print {
        .no-print, .app-footer, .app-topbar, .app-bottom-nav { display: none !important; }
        body { background: #ffffff !important; }
        .merit-shell { margin: 0; max-width: 100%; padding: 0; }
        .merit-card { box-shadow: none; border: none; padding: 0; }
        table.merit-table th, table.merit-table td { border: 1px solid #cbd5e1; }
    }
</style>

<div class="merit-shell">
    <div class="merit-card" id="meritPrintArea">
        <div class="merit-header">
            <h1>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</h1>
            <p class="merit-subtitle"><%= selectedExamTitle || ('শ্রেণি ভিত্তিক মেধা তালিকা' + (selectedName ? ' · শ্রেণি: ' + selectedName : '')) %></p>
        </div>

        <form method="GET" action="/merit-list.php" class="merit-form no-print" id="meritFilterForm">
            <% if (isEmbedded) { %><input type="hidden" name="embed" value="1"><% } %>
            <div class="merit-select-wrap">
                <label for="meritClassSelect" class="merit-select-label">শ্রেণি নির্বাচন:</label>
                <select id="meritClassSelect" name="class_id" required aria-label="শ্রেণি ভিত্তিক মেধা তালিকা নির্বাচন করুন" onchange="if (this.value) { if (!navigator.onLine && window.__renderOfflineMerit) { window.__renderOfflineMerit(this.value); } else { this.form.submit(); } }">
                    <option value="">শ্রেণি নির্বাচন করুন</option>
                    <% if (typeof uploadedExams !== 'undefined' && uploadedExams.length > 0) { %>
                        <optgroup label="শ্রেণি ভিত্তিক আপলোডকৃত মেধা তালিকা (Excel)">
                            <% uploadedExams.forEach(function(ex) { %>
                                <option value="excel:<%= ex.id %>" <%= (selectedClass === 'excel:' + ex.id || (!selectedClass && selectedExamId === ex.id)) ? 'selected' : '' %>><%= ex.dropdownLabel || ex.title %> (<%= convertToBengali(ex.rowCount) %> জন)</option>
                            <% }); %>
                        </optgroup>
                    <% } %>
                    <optgroup label="সকল শ্রেণি (শ্রেণি অনুযায়ী মেধা তালিকা)">
                        <% const _uploadedSet = new Set(typeof uploadedClassIds !== 'undefined' ? uploadedClassIds : []); %>
                        <% Object.entries(classMap).forEach(function([id, info]) {
                            const _cname = String(info.name || '').trim();
                            const _clsLabel = /(?:শ্রেণি|শ্রেণী|বর্ষ)$/.test(_cname) ? _cname : _cname + ' শ্রেণি';
                        %>
                            <option value="<%= id %>" <%= (selectedClass === id) ? 'selected' : '' %>><%= _clsLabel %><%= _uploadedSet.has(id) ? ' — ফলাফল সংরক্ষিত' : '' %></option>
                        <% }); %>
                    </optgroup>
                </select>
            </div>
            <button type="submit" class="merit-btn">
                <%- iconSvg('search', 'app-svg-icon', 17) %>
                <span>মেধাতালিকা দেখুন</span>
            </button>
            <a href="/result.php<%= isEmbedded ? '?embed=1' : '' %>" class="merit-btn merit-btn-secondary">
                <%- iconSvg('poll', 'app-svg-icon', 17) %>
                <span>ব্যক্তিগত ফলাফল</span>
            </a>
        </form>

        <%
            const _sciList = (typeof scienceMeritData !== 'undefined' && Array.isArray(scienceMeritData)) ? scienceMeritData : [];
            const _othList = (typeof otherMeritData !== 'undefined' && Array.isArray(otherMeritData)) ? otherMeritData : [];
            const _hasBothGroups = _sciList.length > 0 && _othList.length > 0;
            const _sections = [];
            if (_hasBothGroups) {
                _sections.push({ key: 'other', title: 'সাধারণ / অন্যান্য বিভাগের মেধা তালিকা', isScienceSection: false, rows: _othList });
                _sections.push({ key: 'science', title: 'বিজ্ঞান বিভাগের মেধা তালিকা', isScienceSection: true, rows: _sciList });
            } else if (_sciList.length > 0) {
                _sections.push({ key: 'science', title: 'বিজ্ঞান বিভাগের মেধা তালিকা', isScienceSection: true, rows: _sciList });
            } else if (meritData && meritData.length > 0) {
                _sections.push({ key: 'all', title: '', isScienceSection: false, rows: meritData });
            }
        %>
        <% if (_sections.length > 0) { %>
            <% if (_hasBothGroups) { %>
                <div class="merit-group-tabs no-print" role="tablist" aria-label="বিভাগ অনুযায়ী মেধা তালিকা">
                    <button type="button" class="merit-group-tab active" data-group-filter="all" onclick="filterMeritGroup('all')">উভয় তালিকা (পৃথক)</button>
                    <button type="button" class="merit-group-tab" data-group-filter="other" onclick="filterMeritGroup('other')">সাধারণ / অন্যান্য বিভাগ (<%= convertToBengali(_othList.length) %> জন)</button>
                    <button type="button" class="merit-group-tab" data-group-filter="science" onclick="filterMeritGroup('science')">বিজ্ঞান বিভাগ (<%= convertToBengali(_sciList.length) %> জন)</button>
                </div>
            <% } %>
            <% const _mEmbed = isEmbedded ? '&embed=1' : ''; %>
            <% const _mClsQuery = encodeURIComponent(selectedClass || (selectedExamId ? 'excel:' + selectedExamId : '') || selectedName || ''); %>
            <% const _mStuClsQuery = encodeURIComponent((typeof selectedClassKey !== 'undefined' && selectedClassKey) ? selectedClassKey : (selectedClass || (selectedExamId ? 'excel:' + selectedExamId : '') || selectedName || '')); %>
            <% _sections.forEach(function(sec) {
                const _totalStudents = sec.rows.length;
                const _passedStudents = sec.rows.filter(function(r) { return !r.absent && (r.fail === 0 || r.isPromoted); }).length;
                const _passPct = _totalStudents > 0 ? Math.round((_passedStudents / _totalStudents) * 1000) / 10 : 0;
            %>
            <div class="merit-section-block" data-merit-group="<%= sec.key %>">
                <% if (sec.title) { %>
                    <div class="merit-section-heading <%= sec.isScienceSection ? 'science' : '' %>">
                        <span style="display:inline-flex;align-items:center;gap:7px;"><%- iconSvg(sec.isScienceSection ? 'atom' : 'users', 'app-svg-icon', 18) %> <%= sec.title %></span>
                        <span style="font-size:0.86rem;">মোট <%= convertToBengali(_totalStudents) %> জন</span>
                    </div>
                <% } %>
                <div class="merit-summary-bar">
                    <div class="merit-summary-item">
                        <span class="merit-summary-lbl"><%= sec.isScienceSection ? 'বিভাগ' : 'শ্রেণি' %></span>
                        <span class="merit-summary-val"><%= sec.isScienceSection ? 'বিজ্ঞান (' + (selectedName || 'নির্ধারিত শ্রেণি') + ')' : (selectedName || 'নির্ধারিত শ্রেণি') %></span>
                    </div>
                    <div class="merit-summary-item">
                        <span class="merit-summary-lbl">মোট শিক্ষার্থী</span>
                        <span class="merit-summary-val"><%= convertToBengali(_totalStudents) %> জন</span>
                    </div>
                    <div class="merit-summary-item">
                        <span class="merit-summary-lbl">উত্তীর্ণ / প্রমোটেড</span>
                        <span class="merit-summary-val"><%= convertToBengali(_passedStudents) %> জন</span>
                    </div>
                    <div class="merit-summary-item">
                        <span class="merit-summary-lbl">পাসের হার</span>
                        <span class="merit-summary-val"><%= convertToBengali(_passPct) %>%</span>
                    </div>
                </div>
                <div class="merit-table-wrap">
                    <table class="merit-table">
                        <thead>
                            <tr>
                                <th>মেধাক্রম</th>
                                <th>রোল</th>
                                <th style="text-align: left;">শিক্ষার্থীর নাম</th>
                                <th>প্রাপ্ত নম্বর</th>
                                <th>GPA</th>
                                <th>গড় (%)</th>
                                <th>ফলাফল</th>
                                <th class="no-print">ডকুমেন্ট</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let rank = 1; sec.rows.forEach(function(row) {
                                const _mRoll = encodeURIComponent(row.roll || '');
                                const _dispName = row.displayName || (row.isScience ? (row.name + ' (বিজ্ঞান)') : row.name);
                            %>
                            <tr class="<%= row.absent ? 'absent-row' : '' %>">
                                <td class="rank-num"><%= row.absent ? '—' : convertToBengali(row.meritRank || rank++) %></td>
                                <td><%= convertToBengali(row.roll) %></td>
                                <td style="text-align: left; font-weight: 600;"><%= _dispName %></td>
                                <td style="font-weight: 700;"><%= row.absent ? 'Abs' : convertToBengali(row.total) %></td>
                                <td style="font-weight: 700;">
                                    <%= convertToBengali(Number(row.gpa || 0).toFixed(2)) %>
                                    <% if (row.hasOptionalSubject && row.gpa > 0) { %>
                                        <div style="font-size:0.74rem; font-weight:500; color:#64748b;">(৪র্থ ছাড়া: <%= convertToBengali(Number(row.gpaWithoutOptional || 0).toFixed(2)) %>)</div>
                                    <% } %>
                                </td>
                                <td><%= convertToBengali(Math.round(row.pct * 100) / 100) %>%</td>
                                <td>
                                    <% if (row.absent) { %>
                                        <span class="status-abs">Abs</span>
                                    <% } else if (row.isPromoted) { %>
                                        <span class="status-promoted"><%= row.statusBn || 'প্রমোটেড' %> (<%= convertToBengali(row.fail) %>টি)</span>
                                    <% } else if (row.fail > 0) { %>
                                        <span class="status-fail">অকৃতকার্য (<%= convertToBengali(row.fail) %>টি)</span>
                                    <% } else { %>
                                        <span class="status-pass">উত্তীর্ণ</span>
                                    <% } %>
                                </td>
                                <td class="no-print">
                                    <div class="merit-doc-links">
                                        <a href="/result.php?class=<%= _mClsQuery %>&roll=<%= _mRoll %><%= _mEmbed %>" class="merit-doc-link" title="মার্কশিট দেখুন">মার্কশিট</a>
                                        <a href="/student-search.php?class=<%= _mStuClsQuery %>&roll=<%= _mRoll %>&doc=attestation<%= _mEmbed %>" class="merit-doc-link alt" title="তথ্য, আইডি কার্ড, প্রত্যায়ন ও প্রশংসা পত্র">সনদ ও তথ্য</a>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% }); %>
        <div style="display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin-top: 20px;" class="no-print">
            <button type="button" onclick="window.print()" class="merit-btn">
                <%- iconSvg('printer', 'app-svg-icon', 17) %>
                <span>সরাসরি প্রিন্ট (A4)</span>
            </button>
            <button type="button" onclick="downloadMeritPdf()" class="merit-btn merit-btn-rose">
                <%- iconSvg('file-pdf', 'app-svg-icon', 17) %>
                <span>PDF ডাউনলোড</span>
            </button>
            <button type="button" onclick="downloadMeritWord()" class="merit-btn merit-btn-blue">
                <%- iconSvg('file-word', 'app-svg-icon', 17) %>
                <span>Word (.docx)</span>
            </button>
        </div>
        <div id="meritExportStatus" class="no-print" style="display:none; margin-top:12px; padding:9px 13px; border-radius:9px; font-size:0.88rem; font-weight:600; text-align:center;"></div>
        <% } else if (selectedClass !== '' || selectedExamId !== '') { %>
            <p id="meritOfflineMount" style="text-align: center; color: #b91c1c; font-weight: 600; padding: 24px;">নির্বাচিত শ্রেণির জন্য কোনো মেধা তালিকা পাওয়া যায়নি।</p>
        <% } else { %>
            <p id="meritOfflineMount" style="text-align: center; color: #475569; font-weight: 600; padding: 24px;">শ্রেণি ভিত্তিক মেধা তালিকা দেখতে উপরের ড্রপডাউন থেকে শ্রেণি নির্বাচন করুন।</p>
        <% } %>
    </div>
</div>

<script>
    function filterMeritGroup(groupKey) {
        document.querySelectorAll('.merit-group-tab').forEach(function(btn) {
            btn.classList.toggle('active', btn.getAttribute('data-group-filter') === groupKey);
        });
        document.querySelectorAll('.merit-section-block').forEach(function(sec) {
            var g = sec.getAttribute('data-merit-group');
            sec.style.display = (groupKey === 'all' || g === groupKey) ? 'block' : 'none';
        });
    }

    function setMeritStatus(msg, isErr) {
        var st = document.getElementById('meritExportStatus');
        if (!st) return;
        st.style.display = 'block';
        st.textContent = msg;
        st.style.background = isErr ? '#fef2f2' : '#f0fdf4';
        st.style.color = isErr ? '#b91c1c' : '#15803d';
        st.style.border = isErr ? '1px solid #fecaca' : '1px solid #bbf7d0';
    }

    async function downloadMeritPdf() {
        var el = document.getElementById('meritPrintArea');
        if (!el) return;
        try {
            if (!window.NadufmExport) throw new Error('এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            await window.NadufmExport.exportElementToA4Pdf({
                element: el,
                filename: 'merit-list.pdf',
                marginMm: [10, 10, 10, 10],
                onStatus: setMeritStatus
            });
        } catch (err) {
            setMeritStatus(err && err.message ? err.message : 'PDF ডাউনলোড ব্যর্থ হয়েছে।', true);
        }
    }

    async function downloadMeritWord() {
        var el = document.getElementById('meritPrintArea');
        if (!el) return;
        var cssText = '@page Section1 { size: 210mm 297mm; margin: 14mm; }' +
            'div.Section1 { page: Section1; font-family: "Nikosh", "Kalpurush", Arial, sans-serif; font-size: 13px; color: #0f172a; }' +
            'table { width: 100%; border-collapse: collapse; }' +
            'th, td { border: 1px solid #cbd5e1; padding: 6px; text-align: center; }' +
            'th { background: #14532d; color: #ffffff; }';
        try {
            if (!window.NadufmExport) throw new Error('এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            await window.NadufmExport.exportElementToWord({
                element: el,
                filename: 'merit-list.docx',
                title: 'Merit List',
                orientation: 'portrait',
                onStatus: setMeritStatus
            });
        } catch (err) {
            setMeritStatus(err && err.message ? err.message : 'Word ডাউনলোড ব্যর্থ হয়েছে।', true);
        }
    }

    (function () {
        var form = document.getElementById('meritFilterForm');
        var sel = document.getElementById('meritClassSelect');
        var isEmb = <%= isEmbedded ? 'true' : 'false' %>;

        function bn(v) {
            return window.NadufmOffline ? window.NadufmOffline.bnNum(v) : String(v);
        }
        function esc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (m) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
            });
        }

        function buildSectionHtml(sec, selectedName, clsVal, stuClsVal) {
            var total = sec.rows.length;
            var passed = sec.rows.filter(function (r) { return !r.absent && (r.fail === 0 || r.isPromoted); }).length;
            var passPct = total > 0 ? Math.round((passed / total) * 1000) / 10 : 0;
            var embQ = isEmb ? '&embed=1' : '';
            var clsQ = encodeURIComponent(clsVal || selectedName || '');
            var stuClsQ = encodeURIComponent(stuClsVal || clsVal || selectedName || '');
            var rank = 1;
            var body = sec.rows.map(function (row) {
                var dispName = row.displayName || (row.isScience ? (row.name + ' (বিজ্ঞান)') : row.name);
                var statusBadge = '';
                if (row.absent) statusBadge = '<span class="status-abs">Abs</span>';
                else if (row.isPromoted) statusBadge = '<span class="status-promoted">' + esc(row.statusBn || 'প্রমোটেড') + ' (' + bn(row.fail) + 'টি)</span>';
                else if (row.fail > 0) statusBadge = '<span class="status-fail">অকৃতকার্য (' + bn(row.fail) + 'টি)</span>';
                else statusBadge = '<span class="status-pass">উত্তীর্ণ</span>';

                var gpaHtml = bn(Number(row.gpa || 0).toFixed(2));
                if (row.hasOptionalSubject && Number(row.gpa || 0) > 0) {
                    gpaHtml += '<div style="font-size:0.74rem; font-weight:500; color:#64748b;">(৪র্থ ছাড়া: ' + bn(Number(row.gpaWithoutOptional || 0).toFixed(2)) + ')</div>';
                }

                var rollEnc = encodeURIComponent(row.roll || '');
                return '<tr class="' + (row.absent ? 'absent-row' : '') + '">' +
                    '<td class="rank-num">' + (row.absent ? '—' : bn(row.meritRank || rank++)) + '</td>' +
                    '<td>' + bn(row.roll) + '</td>' +
                    '<td style="text-align:left; font-weight:600;">' + esc(dispName) + '</td>' +
                    '<td style="font-weight:700;">' + (row.absent ? 'Abs' : bn(row.total)) + '</td>' +
                    '<td style="font-weight:700;">' + gpaHtml + '</td>' +
                    '<td>' + bn(Math.round(Number(row.pct || 0) * 100) / 100) + '%</td>' +
                    '<td>' + statusBadge + '</td>' +
                    '<td class="no-print"><div class="merit-doc-links">' +
                        '<a href="/result.php?class=' + clsQ + '&roll=' + rollEnc + embQ + '" class="merit-doc-link" title="মার্কশিট দেখুন">মার্কশিট</a>' +
                        '<a href="/student-search.php?class=' + stuClsQ + '&roll=' + rollEnc + '&doc=attestation' + embQ + '" class="merit-doc-link alt" title="তথ্য, আইডি কার্ড, প্রত্যায়ন ও প্রশংসা পত্র">সনদ ও তথ্য</a>' +
                    '</div></td>' +
                '</tr>';
            }).join('');

            var summaryName = sec.isScienceSection ? ('বিজ্ঞান (' + (selectedName || 'নির্ধারিত শ্রেণি') + ')') : (selectedName || 'নির্ধারিত শ্রেণি');
            return '<div class="merit-section-block" data-merit-group="' + sec.key + '">' +
                (sec.title ? '<div class="merit-section-heading ' + (sec.isScienceSection ? 'science' : '') + '"><span>' + esc(sec.title) + '</span><span style="font-size:0.86rem;">মোট ' + bn(total) + ' জন</span></div>' : '') +
                '<div class="merit-summary-bar">' +
                    '<div class="merit-summary-item"><span class="merit-summary-lbl">' + (sec.isScienceSection ? 'বিভাগ' : 'শ্রেণি') + '</span><span class="merit-summary-val">' + esc(summaryName) + '</span></div>' +
                    '<div class="merit-summary-item"><span class="merit-summary-lbl">মোট শিক্ষার্থী</span><span class="merit-summary-val">' + bn(total) + ' জন</span></div>' +
                    '<div class="merit-summary-item"><span class="merit-summary-lbl">উত্তীর্ণ / প্রমোটেড</span><span class="merit-summary-val">' + bn(passed) + ' জন</span></div>' +
                    '<div class="merit-summary-item"><span class="merit-summary-lbl">পাসের হার</span><span class="merit-summary-val">' + bn(passPct) + '%</span></div>' +
                '</div>' +
                '<div class="merit-table-wrap"><table class="merit-table"><thead><tr><th>মেধাক্রম</th><th>রোল</th><th style="text-align:left;">শিক্ষার্থীর নাম</th><th>প্রাপ্ত নম্বর</th><th>GPA</th><th>গড় (%)</th><th>ফলাফল</th><th class="no-print">ডকুমেন্ট</th></tr></thead><tbody>' + body + '</tbody></table></div>' +
            '</div>';
        }

        window.__renderOfflineMerit = async function (clsVal) {
            if (!window.NadufmOffline) return;
            var entry = await window.NadufmOffline.getMeritList(clsVal);
            var area = document.getElementById('meritPrintArea');
            if (!area) return;

            Array.from(area.children).forEach(function (ch) {
                if (!ch.classList.contains('merit-header') && !ch.classList.contains('merit-form')) {
                    ch.remove();
                }
            });

            var subEl = area.querySelector('.merit-subtitle');
            if (!entry || (!entry.meritData || !entry.meritData.length)) {
                if (subEl) subEl.textContent = 'শ্রেণি ভিত্তিক মেধা তালিকা';
                var p = document.createElement('p');
                p.style.cssText = 'text-align:center; color:#b91c1c; font-weight:600; padding:24px;';
                p.textContent = 'অফলাইনে এই শ্রেণির জন্য সংরক্ষিত মেধা তালিকা পাওয়া যায়নি।';
                area.appendChild(p);
                return;
            }

            if (subEl) subEl.textContent = entry.selectedExamTitle || ('শ্রেণি ভিত্তিক মেধা তালিকা · ' + entry.selectedName);
            var sci = entry.scienceMeritData || [];
            var oth = entry.otherMeritData || [];
            var hasBothGroups = sci.length > 0 && oth.length > 0;
            var sections = [];
            if (hasBothGroups) {
                sections.push({ key: 'other', title: 'সাধারণ / অন্যান্য বিভাগের মেধা তালিকা', isScienceSection: false, rows: oth });
                sections.push({ key: 'science', title: 'বিজ্ঞান বিভাগের মেধা তালিকা', isScienceSection: true, rows: sci });
            } else if (sci.length) {
                sections.push({ key: 'science', title: 'বিজ্ঞান বিভাগের মেধা তালিকা', isScienceSection: true, rows: sci });
            } else {
                sections.push({ key: 'all', title: '', isScienceSection: false, rows: entry.meritData });
            }

            var tabsHtml = hasBothGroups
                ? '<div class="merit-group-tabs no-print" role="tablist" aria-label="বিভাগ অনুযায়ী মেধা তালিকা">' +
                    '<button type="button" class="merit-group-tab active" data-group-filter="all" onclick="filterMeritGroup(\'all\')">উভয় তালিকা (পৃথক)</button>' +
                    '<button type="button" class="merit-group-tab" data-group-filter="other" onclick="filterMeritGroup(\'other\')">সাধারণ / অন্যান্য বিভাগ (' + bn(oth.length) + ' জন)</button>' +
                    '<button type="button" class="merit-group-tab" data-group-filter="science" onclick="filterMeritGroup(\'science\')">বিজ্ঞান বিভাগ (' + bn(sci.length) + ' জন)</button>' +
                  '</div>'
                : '';

            var stuClsVal = entry.selectedClassKey || clsVal;
            var wrap = document.createElement('div');
            wrap.innerHTML = tabsHtml +
                sections.map(function (s) { return buildSectionHtml(s, entry.selectedName, clsVal, stuClsVal); }).join('') +
                '<div style="display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin-top:20px;" class="no-print">' +
                    '<button type="button" onclick="window.print()" class="merit-btn"><span>সরাসরি প্রিন্ট (A4)</span></button>' +
                    '<button type="button" onclick="downloadMeritPdf()" class="merit-btn merit-btn-rose"><span>PDF ডাউনলোড</span></button>' +
                    '<button type="button" onclick="downloadMeritWord()" class="merit-btn merit-btn-blue"><span>Word (.doc)</span></button>' +
                '</div>' +
                '<div id="meritExportStatus" class="no-print" style="display:none; margin-top:12px; padding:9px 13px; border-radius:9px; font-size:0.88rem; font-weight:600; text-align:center;"></div>';
            area.appendChild(wrap);
        };

        if (form) {
            form.addEventListener('submit', function (e) {
                if (!navigator.onLine && sel && sel.value) {
                    e.preventDefault();
                    window.__renderOfflineMerit(sel.value);
                }
            });
        }
    })();
</script>

<%- include('partials/footer') %>

