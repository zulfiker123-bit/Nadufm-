<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#15803d">
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Hind Siliguri', sans-serif; background: #f4f7f5; color: #0f172a; padding: 20px; }
        .input-box {
            max-width: 860px;
            margin: 12px auto;
            background: #ffffff;
            padding: 26px;
            border-radius: 16px;
            border: 1px solid rgba(15, 23, 42, 0.09);
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
        }
        .form-title {
            text-align: center;
            margin-bottom: 22px;
            color: #14532d;
            font-size: 1.3rem;
            font-weight: 700;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        }
        .date-wrap { max-width: 280px; margin: 0 auto 22px auto; }
        .entry-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .col-card { background: #f8faf9; border: 1px solid rgba(15, 23, 42, 0.08); border-radius: 12px; padding: 18px; }
        .section-label { font-size: 1.05rem; font-weight: 700; margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid rgba(15, 23, 42, 0.08); }
        .income-label { color: #15803d; }
        .expense-label { color: #b91c1c; }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.9rem; color: #334155; }
        .form-group input {
            width: 100%;
            height: 42px;
            padding: 0 12px;
            border: 1px solid rgba(15, 23, 42, 0.14);
            border-radius: 10px;
            background: #ffffff;
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
        }
        .form-group input:focus { border-color: #15803d; }
        .btn-submit {
            width: 100%;
            min-height: 46px;
            background: #15803d;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-submit:hover { background: #14532d; }
        .nav-actions { display: flex; gap: 10px; margin-top: 14px; }
        .nav-actions a { flex: 1; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; min-height: 42px; border-radius: 10px; font-weight: 600; font-size: 0.92rem; }
        .btn-dash { background: #f1f5f9; color: #0f172a; border: 1px solid rgba(15, 23, 42, 0.1); }
        .btn-home { background: #ffffff; color: #475569; border: 1px solid rgba(15, 23, 42, 0.1); }
        #status { margin-top: 14px; padding: 10px 12px; text-align: center; border-radius: 10px; display: none; font-weight: 600; font-size: 0.92rem; }
        @media (max-width: 768px) { .entry-columns { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="input-box">
        <div class="form-title">দৈনিক আয়-ব্যয় এন্ট্রি ফর্ম</div>

        <form id="accounting-form">
            <div class="form-group date-wrap">
                <label for="date-input" style="text-align: center;">লেনদেনের তারিখ</label>
                <input type="date" name="date" id="date-input" required>
            </div>

            <div class="entry-columns">
                <div class="col-card">
                    <div class="section-label income-label">আয় (Credit)</div>
                    <div class="form-group">
                        <label>আয়ের উৎস</label>
                        <input type="text" name="income_source" placeholder="যেমন: অনুদান / বেতন">
                    </div>
                    <div class="form-group">
                        <label>আয়ের পরিমাণ (৳)</label>
                        <input type="number" name="income_amount" placeholder="0">
                    </div>
                </div>

                <div class="col-card">
                    <div class="section-label expense-label">ব্যয় (Debit)</div>
                    <div class="form-group">
                        <label>ব্যয়ের খাত</label>
                        <input type="text" name="expense_sector" placeholder="যেমন: বিদ্যুৎ বিল">
                    </div>
                    <div class="form-group">
                        <label>ব্যয়ের পরিমাণ (৳)</label>
                        <input type="number" name="expense_amount" placeholder="0">
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-submit" id="submit-btn">হিসাব সংরক্ষণ করুন</button>

            <% if (!isEmbedded) { %>
            <div class="nav-actions">
                <a href="/dashboard.php" target="_top" class="btn-dash">ড্যাশবোর্ডে ফিরুন</a>
                <a href="/index.php" target="_top" class="btn-home">মূল পাতা</a>
            </div>
            <% } %>

            <div id="status"></div>
        </form>
    </div>

    <script>
        document.getElementById('date-input').valueAsDate = new Date();
        const scriptURL = 'https://script.google.com/macros/s/AKfycbx3otv2ll9TfSrGJStOCPSK98FcvUyhkG_Ry00nu_hwO2gAWC9g7diWUZ_5MwVqqqnS/exec';
        const form = document.getElementById('accounting-form');
        const status = document.getElementById('status');
        const btn = document.getElementById('submit-btn');

        form.addEventListener('submit', e => {
            e.preventDefault();
            btn.disabled = true;
            btn.innerText = "তথ্য পাঠানো হচ্ছে...";
            status.style.display = "block";
            status.style.background = "#f1f5f9";
            status.style.color = "#334155";
            status.innerText = "অপেক্ষা করুন, তথ্য সংরক্ষণ করা হচ্ছে...";

            let formData = new FormData(form);
            if (!formData.get('income_amount')) formData.set('income_amount', '0');
            if (!formData.get('expense_amount')) formData.set('expense_amount', '0');

            fetch(scriptURL, { method: 'POST', body: formData })
                .then(() => {
                    btn.disabled = false;
                    btn.innerText = "হিসাব সংরক্ষণ করুন";
                    status.style.background = "#dcfce7";
                    status.style.color = "#166534";
                    status.innerText = "সফলভাবে সংরক্ষণ করা হয়েছে।";
                    form.reset();
                    document.getElementById('date-input').valueAsDate = new Date();
                    setTimeout(() => { status.style.display = "none"; }, 5000);
                })
                .catch(error => {
                    btn.disabled = false;
                    btn.innerText = "আবার চেষ্টা করুন";
                    status.style.background = "#fee2e2";
                    status.style.color = "#b91c1c";
                    status.innerText = "সংযোগ ত্রুটি হয়েছে। অনুগ্রহ করে পরে আবার চেষ্টা করুন।";
                    console.error('Error!', error.message);
                });
        });
    </script>
</body>
</html>
