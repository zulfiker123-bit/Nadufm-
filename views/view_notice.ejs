<%- include('partials/header', { pageTitle: subject + ' - নোটিশ' }) %>
<style>
    .notice-toolbar {
        display: flex;
        justify-content: center;
        gap: 12px;
        padding: 18px 16px 8px 16px;
    }
    .notice-print-btn {
        background: #15803d;
        color: #ffffff;
        padding: 10px 24px;
        border: none;
        border-radius: 999px;
        font-family: inherit;
        font-size: 0.96rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(21, 128, 61, 0.25);
    }
    .notice-print-btn:hover { background: #14532d; }
    .letterhead {
        background: #ffffff;
        max-width: 800px;
        margin: 14px auto 32px auto;
        padding: 48px;
        min-height: 920px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        border-top: 8px solid #059669;
        border-radius: 8px;
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }
    .letterhead * { font-family: 'Nikosh', 'Kalpurush', sans-serif; }
    .lh-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #065f46;
        padding-bottom: 18px;
        margin-bottom: 24px;
        gap: 12px;
    }
    .lh-header img { width: 72px; height: 72px; object-fit: cover; }
    .lh-center { text-align: center; flex: 1; }
    .lh-center h1 { font-size: 1.45rem; font-weight: 700; color: #064e3b; margin: 0; }
    .lh-center .en-sub { font-size: 0.72rem; font-weight: 600; color: #475569; letter-spacing: 0.08em; margin-top: 3px; }
    .lh-center .addr { font-size: 0.9rem; color: #047857; font-weight: 600; margin-top: 2px; }
    .lh-meta { display: flex; justify-content: space-between; margin-bottom: 28px; color: #334155; font-weight: 700; font-size: 0.98rem; }
    .lh-subject { text-align: center; margin-bottom: 28px; }
    .lh-subject h2 { font-size: 1.2rem; font-weight: 700; border-bottom: 2px solid #0f172a; display: inline-block; padding-bottom: 4px; margin: 0; }
    .details { line-height: 1.85; font-size: 1.1rem; text-align: justify; white-space: pre-line; margin-top: 24px; color: #1a1a1a; }
    .lh-sign { margin-top: 90px; text-align: right; }
    .lh-sign-box { display: inline-block; text-align: center; }
    .lh-sign-line { width: 190px; border-top: 1px solid #0f172a; margin-bottom: 6px; }
    @media (max-width: 640px) { .letterhead { padding: 24px 18px; margin: 12px; min-height: auto; } }
    @media print { .no-print, .app-topbar, .app-footer, .mobile-bottom-nav { display: none !important; } .letterhead { margin: 0; box-shadow: none; border-radius: 0; max-width: 100%; } }
</style>

<div class="no-print notice-toolbar">
    <button type="button" onclick="window.print()" class="notice-print-btn"><i class="fas fa-print"></i> প্রিন্ট / PDF ডাউনলোড</button>
</div>

<div class="letterhead">
    <div class="lh-header">
        <img src="/logo.png" alt="Logo">
        <div class="lh-center">
            <h1>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</h1>
            <p class="en-sub">NALTA AHSANIA DARUL ULUM FAZIL DEGREE MADRASAH</p>
            <p class="addr">নলতা শরীফ, কালিগঞ্জ, সাতক্ষীরা</p>
        </div>
        <div style="width:72px;"></div>
    </div>

    <div class="lh-meta">
        <span>স্মারক: NADUFM/<%= new Date().getFullYear() %>/<%= noticeId %></span>
        <span>তারিখ: <%= date %></span>
    </div>

    <div class="lh-subject">
        <h2>বিষয়: <%= subject %></h2>
    </div>

    <div class="details"><%= description %></div>

    <div class="lh-sign">
        <div class="lh-sign-box">
            <div class="lh-sign-line"></div>
            <p style="font-weight:700; font-size:1.05rem;">অধ্যক্ষ</p>
            <p style="font-size:0.88rem; color:#334155;">নলতা আহছানিয়া দারুল উলুম ফাজিল মাদ্রাসা</p>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
