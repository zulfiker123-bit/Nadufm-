<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>অ্যাডমিন প্যানেল ও ড্যাশবোর্ড প্রবেশ - নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</title>
    <link rel="shortcut icon" href="/logo.png" type="image/x-icon">
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#14532d">
    <link rel="stylesheet" href="/fonts.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            font-family: 'Kalpurush', sans-serif;
            background: #f4f7f5;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #ffffff;
            border: 1px solid rgba(15, 23, 42, 0.09);
            border-radius: 18px;
            box-shadow: 0 12px 30px -6px rgba(15, 23, 42, 0.1);
            overflow: hidden;
        }

        .login-head {
            background: linear-gradient(135deg, #14532d 0%, #15803d 100%);
            color: #ffffff;
            padding: 26px 22px 22px 22px;
            text-align: center;
        }

        .login-logo {
            width: 66px;
            height: 66px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, 0.75);
            background: #ffffff;
            margin-bottom: 10px;
        }

        .login-head h1 {
            font-size: 1.24rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .login-head p {
            font-size: 0.88rem;
            opacity: 0.92;
            line-height: 1.35;
        }

        .login-body {
            padding: 24px 22px 22px 22px;
        }

        .login-alert {
            padding: 10px 13px;
            border-radius: 10px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .login-field {
            margin-bottom: 16px;
        }

        .login-field label {
            display: block;
            font-size: 0.94rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .pw-wrap {
            position: relative;
        }

        .pw-input {
            width: 100%;
            height: 46px;
            padding: 0 44px 0 14px;
            border: 1px solid rgba(15, 23, 42, 0.16);
            border-radius: 11px;
            background: #f8faf9;
            color: #0f172a;
            font-family: inherit;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.15s ease, background-color 0.15s ease;
        }

        .pw-input:focus {
            border-color: #15803d;
            background: #ffffff;
        }

        .pw-toggle {
            position: absolute;
            top: 50%;
            right: 8px;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 8px;
            background: transparent;
            color: #475569;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }

        .pw-toggle:hover {
            background: rgba(15, 23, 42, 0.06);
        }

        .btn-login {
            width: 100%;
            min-height: 46px;
            border: 1px solid #146c34;
            border-radius: 11px;
            background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
            color: #ffffff;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3.5px 0 #0e5427, 0 6px 14px -3px rgba(21, 128, 61, 0.32);
            transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease;
        }

        .btn-login:hover {
            transform: translateY(-1px);
            filter: brightness(1.04);
        }

        .btn-login:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 #0e5427;
        }

        .login-footer {
            margin-top: 16px;
            text-align: center;
        }

        .back-home {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #334155;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 7px 14px;
            border-radius: 9px;
            border: 1px solid rgba(15, 23, 42, 0.1);
            background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%);
            box-shadow: inset 0 1px 0 #ffffff, 0 2px 0 rgba(15, 23, 42, 0.08);
            transition: transform 0.13s ease, box-shadow 0.13s ease, color 0.13s ease;
        }

        .back-home:hover {
            transform: translateY(-1px);
            color: #14532d;
            border-color: rgba(21, 128, 61, 0.26);
        }
        .back-home:active { transform: translateY(1px); box-shadow: 0 1px 0 rgba(15, 23, 42, 0.08); }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-head">
            <img src="/logo.png" alt="মাদ্রাসার লোগো" class="login-logo" referrerpolicy="no-referrer">
            <h1>অ্যাডমিন প্যানেল ও ড্যাশবোর্ড</h1>
            <p>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</p>
        </div>

        <div class="login-body">
            <% if (error) { %>
                <div class="login-alert" role="alert">
                    <%- iconSvg('alert-circle', 'app-svg-icon', 18) %>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form method="POST" action="/admin-login" autocomplete="off">
                <input type="hidden" name="next" value="<%= nextUrl %>">
                <div class="login-field">
                    <label for="adminPassword">অ্যাডমিন পাসওয়ার্ড</label>
                    <div class="pw-wrap">
                        <input
                            type="password"
                            id="adminPassword"
                            name="password"
                            class="pw-input"
                            placeholder="পাসওয়ার্ড লিখুন"
                            required
                        >
                        <button type="button" class="pw-toggle" onclick="togglePw()" aria-label="পাসওয়ার্ড দেখুন বা লুকান">
                            <span id="pwEyeOpen"><%- iconSvg('eye', 'app-svg-icon', 18) %></span>
                            <span id="pwEyeClosed" hidden><%- iconSvg('eye-off', 'app-svg-icon', 18) %></span>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-login">
                    <%- iconSvg('lock', 'app-svg-icon', 18) %>
                    <span>প্রবেশ করুন</span>
                </button>
            </form>

            <% if (!isEmbedded) { %>
            <div class="login-footer">
                <a href="/index.php" class="back-home" onclick="goBackSafely(event)">
                    <%- iconSvg('chevron-left', 'app-svg-icon', 17) %>
                    <span>পিছনে যান</span>
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <script>
        function togglePw() {
            var inp = document.getElementById('adminPassword');
            var openEl = document.getElementById('pwEyeOpen');
            var closedEl = document.getElementById('pwEyeClosed');
            if (!inp) return;
            if (inp.type === 'password') {
                inp.type = 'text';
                if (openEl) openEl.hidden = true;
                if (closedEl) closedEl.hidden = false;
            } else {
                inp.type = 'password';
                if (openEl) openEl.hidden = false;
                if (closedEl) closedEl.hidden = true;
            }
        }
        function goBackSafely(e) {
            try {
                if (window.history.length > 1 && document.referrer && new URL(document.referrer).origin === window.location.origin) {
                    e.preventDefault();
                    window.history.back();
                }
            } catch (err) {}
        }
    </script>
</body>
</html>
