<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ফটো গ্যালারি ব্যবস্থাপনা</title>
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#15803d">
    <link rel="stylesheet" href="/fonts.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Kalpurush', sans-serif; background: #f6f8f7; color: #0f172a; padding: 18px; }
        .wrap { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 350px 1fr; gap: 18px; align-items: start; }
        .card { background: #fff; border: 1px solid rgba(15,23,42,0.08); border-radius: 14px; padding: 20px; }
        .card h2 { font-size: 1.06rem; font-weight: 700; color: #14532d; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(15,23,42,0.08); }
        .field { margin-bottom: 12px; }
        .field label { display: block; font-size: 0.86rem; font-weight: 600; color: #334155; margin-bottom: 4px; }
        .field input, .field select, .field textarea {
            width: 100%; padding: 8px 12px; border: 1px solid rgba(15,23,42,0.14); border-radius: 9px;
            background: #f8faf9; font-family: inherit; font-size: 0.92rem; outline: none;
        }
        .field input, .field select { height: 40px; }
        .field textarea { min-height: 76px; resize: vertical; }
        .field input:focus, .field select:focus, .field textarea:focus { border-color: #15803d; background: #fff; }
        .check-row { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-size: 0.9rem; font-weight: 600; color: #1e293b; cursor: pointer; }
        .check-row input { width: 17px; height: 17px; accent-color: #15803d; cursor: pointer; }
        .btn { min-height: 42px; padding: 0 16px; border: 1px solid transparent; border-radius: 10px; font-family: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease; }
        .btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
        .btn:active { transform: translateY(2px); }
        .btn-primary { width: 100%; background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%); color: #fff; border-color: #146c34; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 3.5px 0 #0e5427, 0 6px 14px -3px rgba(21,128,61,0.3); }
        .btn-cancel { width: 100%; margin-top: 8px; background: linear-gradient(180deg, #ffffff 0%, #f1f5f3 100%); color: #475569; border-color: rgba(15,23,42,0.14); box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15,23,42,0.1); display: none; }
        .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
        .search-input { height: 38px; padding: 0 12px; border: 1px solid rgba(15,23,42,0.14); border-radius: 9px; min-width: 220px; font-family: inherit; }
        .gal-admin-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
        .gal-admin-card { border: 1px solid rgba(15,23,42,0.09); border-radius: 12px; overflow: hidden; background: #ffffff; display: flex; flex-direction: column; }
        .gal-admin-thumb { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #e2e8f0; display: block; }
        .gal-admin-body { padding: 12px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
        .gal-admin-meta { font-size: 0.78rem; color: #64748b; }
        .gal-admin-title { font-size: 0.94rem; font-weight: 700; color: #0f172a; line-height: 1.35; }
        .gal-admin-desc { font-size: 0.82rem; color: #475569; line-height: 1.4; }
        .gal-admin-actions { display: flex; gap: 6px; margin-top: auto; padding-top: 8px; }
        .act-btn { flex: 1; padding: 6px 10px; border-radius: 8px; border: 1px solid transparent; font-family: inherit; font-size: 0.82rem; font-weight: 600; cursor: pointer; }
        .act-edit { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
        .act-del { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
        .status-msg { padding: 9px 12px; border-radius: 9px; font-size: 0.88rem; font-weight: 600; margin-bottom: 12px; display: none; background: #dcfce7; color: #166534; }
        .status-msg.is-err { background: #fee2e2; color: #b91c1c; }
        .preview-box { width: 100%; aspect-ratio: 16 / 9; border-radius: 9px; overflow: hidden; border: 1px solid rgba(15,23,42,0.1); margin-bottom: 12px; background: #f1f5f9; display: none; }
        .preview-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
        @media (max-width: 920px) { .wrap { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="card">
            <h2 id="formHeading">নতুন ছবি গ্যালারিতে যুক্ত করুন</h2>
            <div id="statusMsg" class="status-msg"></div>
            <form id="galleryForm">
                <input type="hidden" id="itemId">
                <div class="field">
                    <label for="gTitle">ছবির শিরোনাম *</label>
                    <input type="text" id="gTitle" required placeholder="যেমন: বার্ষিক ক্রীড়া ও পুরস্কার বিতরণী">
                </div>
                <div class="field">
                    <label for="gCategory">বিভাগ</label>
                    <select id="gCategory">
                        <option value="campus">ক্যাম্পাস জীবন</option>
                        <option value="events">অনুষ্ঠান ও কার্যক্রম</option>
                        <option value="milestones">মাইলফলক ও অর্জন</option>
                    </select>
                </div>
                <div class="field">
                    <label for="gDate">তারিখ / সময়কাল</label>
                    <input type="text" id="gDate" placeholder="যেমন: ১৫ ফেব্রুয়ারি ২০২৬">
                </div>
                <div class="field">
                    <label for="gLocation">স্থান</label>
                    <input type="text" id="gLocation" placeholder="যেমন: মাদ্রাসা কেন্দ্রীয় প্রাঙ্গণ">
                </div>
                <div class="field">
                    <label for="gPhotoFile">ছবি আপলোড করুন (JPG/PNG/WebP)</label>
                    <input type="file" id="gPhotoFile" accept="image/jpeg,image/png,image/webp">
                </div>
                <div class="field">
                    <label for="gImageUrl">অথবা ছবির পাথ / লিংক</label>
                    <input type="text" id="gImageUrl" placeholder="/images/gallery/campus-aerial.jpg">
                </div>
                <div class="preview-box" id="gPreviewBox">
                    <img id="gPreviewImg" src="" alt="প্রিভিউ" referrerpolicy="no-referrer">
                </div>
                <div class="field">
                    <label for="gCaption">সংক্ষিপ্ত বিবরণ</label>
                    <textarea id="gCaption" placeholder="অনুষ্ঠান বা ছবির বিবরণ লিখুন..."></textarea>
                </div>
                <label class="check-row">
                    <input type="checkbox" id="gFeatured">
                    <span>বড় হাইলাইট কার্ড হিসেবে দেখান</span>
                </label>
                <button type="submit" class="btn btn-primary" id="saveBtn">সংরক্ষণ করুন</button>
                <button type="button" class="btn btn-cancel" id="cancelEditBtn" onclick="resetForm()">বাতিল করুন</button>
            </form>
        </div>

        <div class="card">
            <div class="toolbar">
                <h2 style="margin:0; border:none; padding:0;">গ্যালারি তালিকা (<span id="totalCount">০</span>)</h2>
                <input type="search" id="searchBox" class="search-input" placeholder="শিরোনাম বা বিভাগ খুঁজুন..." oninput="renderList()">
            </div>
            <div class="gal-admin-list" id="galleryList"></div>
        </div>
    </div>

    <script>
        const CAT_NAMES = {
            campus: 'ক্যাম্পাস জীবন',
            events: 'অনুষ্ঠান ও কার্যক্রম',
            milestones: 'মাইলফলক ও অর্জন',
        };
        let galleryItems = <%- JSON.stringify(galleryItems || []) %>;

        function bnNum(v) {
            const d = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
            return String(v).replace(/[0-9]/g, ch => d[Number(ch)]);
        }

        function esc(s) {
            return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
        }

        function showMsg(msg, isErr) {
            const el = document.getElementById('statusMsg');
            el.textContent = msg;
            el.classList.toggle('is-err', Boolean(isErr));
            el.style.display = 'block';
            setTimeout(() => { el.style.display = 'none'; }, 3500);
        }

        function updatePreview(src) {
            const box = document.getElementById('gPreviewBox');
            const img = document.getElementById('gPreviewImg');
            if (src) {
                img.src = src;
                box.style.display = 'block';
            } else {
                img.src = '';
                box.style.display = 'none';
            }
        }

        document.getElementById('gImageUrl').addEventListener('input', function () {
            updatePreview(this.value.trim());
        });

        document.getElementById('gPhotoFile').addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (ev) {
                if (ev.target && ev.target.result) {
                    updatePreview(String(ev.target.result));
                }
            };
            reader.readAsDataURL(file);
        });

        function renderList() {
            const q = document.getElementById('searchBox').value.trim().toLowerCase();
            const list = galleryItems.filter(item => {
                if (!q) return true;
                return [item.title, item.caption, item.location, item.date, CAT_NAMES[item.category]].join(' ').toLowerCase().includes(q);
            });
            document.getElementById('totalCount').textContent = bnNum(list.length);
            const container = document.getElementById('galleryList');
            container.innerHTML = list.map(item => `
                <article class="gal-admin-card">
                    <img class="gal-admin-thumb" src="${esc(item.imageUrl || '/header.jpg')}" alt="${esc(item.title)}" referrerpolicy="no-referrer">
                    <div class="gal-admin-body">
                        <div class="gal-admin-meta">${esc(CAT_NAMES[item.category] || 'ক্যাম্পাস জীবন')}${item.date ? ' · ' + esc(item.date) : ''}${item.featured ? ' · হাইলাইট' : ''}</div>
                        <div class="gal-admin-title">${esc(item.title)}</div>
                        ${item.caption ? `<div class="gal-admin-desc">${esc(item.caption)}</div>` : ''}
                        <div class="gal-admin-actions">
                            <button type="button" class="act-btn act-edit" onclick="editItem('${esc(item.id)}')">সম্পাদনা</button>
                            <button type="button" class="act-btn act-del" onclick="deleteItem('${esc(item.id)}')">মুছুন</button>
                        </div>
                    </div>
                </article>
            `).join('');
        }

        function editItem(id) {
            const item = galleryItems.find(g => g.id === id);
            if (!item) return;
            document.getElementById('itemId').value = item.id;
            document.getElementById('gTitle').value = item.title || '';
            document.getElementById('gCategory').value = item.category || 'campus';
            document.getElementById('gDate').value = item.date || '';
            document.getElementById('gLocation').value = item.location || '';
            document.getElementById('gImageUrl').value = item.imageUrl || '';
            document.getElementById('gCaption').value = item.caption || '';
            document.getElementById('gFeatured').checked = Boolean(item.featured);
            document.getElementById('gPhotoFile').value = '';
            updatePreview(item.imageUrl || '');
            document.getElementById('formHeading').textContent = 'ছবির তথ্য সম্পাদনা করুন';
            document.getElementById('cancelEditBtn').style.display = 'inline-flex';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            document.getElementById('galleryForm').reset();
            document.getElementById('itemId').value = '';
            document.getElementById('formHeading').textContent = 'নতুন ছবি গ্যালারিতে যুক্ত করুন';
            document.getElementById('cancelEditBtn').style.display = 'none';
            updatePreview('');
        }

        async function deleteItem(id) {
            if (!confirm('আপনি কি নিশ্চিতভাবে এই ছবিটি গ্যালারি থেকে মুছে ফেলতে চান?')) return;
            try {
                const res = await fetch('/api/portal/gallery/' + encodeURIComponent(id), { method: 'DELETE' });
                const data = await res.json();
                if (!res.ok) {
                    showMsg(data.error || 'মুছে ফেলা যায়নি।', true);
                    return;
                }
                galleryItems = data.gallery || [];
                renderList();
                showMsg('ছবিটি মুছে ফেলা হয়েছে।');
            } catch (e) {
                showMsg('সার্ভারের সাথে সংযোগ করতে সমস্যা হয়েছে।', true);
            }
        }

        document.getElementById('galleryForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const fd = new FormData();
            fd.append('id', document.getElementById('itemId').value);
            fd.append('title', document.getElementById('gTitle').value.trim());
            fd.append('category', document.getElementById('gCategory').value);
            fd.append('date', document.getElementById('gDate').value.trim());
            fd.append('location', document.getElementById('gLocation').value.trim());
            fd.append('imageUrl', document.getElementById('gImageUrl').value.trim());
            fd.append('caption', document.getElementById('gCaption').value.trim());
            fd.append('featured', document.getElementById('gFeatured').checked ? '1' : '0');

            const fileEl = document.getElementById('gPhotoFile');
            if (fileEl.files && fileEl.files[0]) {
                fd.append('photo', fileEl.files[0]);
            }

            try {
                const res = await fetch('/api/portal/gallery', {
                    method: 'POST',
                    body: fd,
                });
                const data = await res.json();
                if (!res.ok) {
                    showMsg(data.error || 'সংরক্ষণ করা যায়নি।', true);
                    return;
                }
                galleryItems = data.gallery || [];
                resetForm();
                renderList();
                showMsg('গ্যালারি তথ্য সফলভাবে সংরক্ষণ করা হয়েছে।');
            } catch (err) {
                showMsg('সার্ভারের সাথে সংযোগ করতে সমস্যা হয়েছে।', true);
            }
        });

        renderList();
    </script>
</body>
</html>
