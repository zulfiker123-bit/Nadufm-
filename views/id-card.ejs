<script>
    (function () {
        const pickerLib = window.NadufmStudentPicker;
        const classEl = document.getElementById('id_class');
        const rollEl = document.getElementById('id_roll');
        const errEl = document.getElementById('idErrorMsg');
        const btnEl = document.getElementById('idSearchBtn');

        async function fetchAndShowIdCard(clsVal, rollVal) {
            errEl.style.display = 'none';
            btnEl.disabled = true;
            btnEl.textContent = 'তথ্য লোড হচ্ছে...';

            try {
                const res = await fetch('/api/portal/student-record?class=' + encodeURIComponent(clsVal || '') + '&roll=' + encodeURIComponent(rollVal || ''));
                const data = await res.json();
                if (data.status === 'success' && data.student) {
                    renderIdCard(data.student, clsVal);
                } else {
                    errEl.textContent = 'দুঃখিত! এই শ্রেণি ও রোলের কোনো শিক্ষার্থীর তথ্য পাওয়া যায়নি।';
                    errEl.style.display = 'block';
                }
            } catch (e) {
                errEl.textContent = 'সার্ভারের সাথে সংযোগ ব্যর্থ হয়েছে।';
                errEl.style.display = 'block';
            } finally {
                btnEl.disabled = false;
                btnEl.textContent = 'আইডি কার্ড তৈরি করুন';
            }
        }

        function renderIdCard(st, clsVal) {
            document.getElementById('cardName').textContent = st.name_bn || st.name_en || '—';
            document.getElementById('cardNameEn').textContent = st.name_en && st.name_bn !== st.name_en ? st.name_en : '';
            document.getElementById('cardClass').textContent = st.class_name || '—';
            document.getElementById('cardRoll').textContent = st.rollBn || pickerLib.bnNum(st.roll || '—');
            document.getElementById('cardId').textContent = st.id || st.reg_no || ('STD-' + pickerLib.enNum(st.roll || '00'));
            document.getElementById('cardFather').textContent = st.father_bn || '—';
            document.getElementById('cardMother').textContent = st.mother_bn || '—';
            document.getElementById('cardDob').textContent = st.dob || '—';
            document.getElementById('cardBlood').textContent = st.blood || '—';
            document.getElementById('cardSession').textContent = st.session || '২০২৬';
            document.getElementById('cardMobile').textContent = st.mobile || '০১৩০৯-১১৮৭৭৮';
            document.getElementById('cardAddress').textContent = st.address || 'নলতা শরীফ, কালিগঞ্জ, সাতক্ষীরা';
            document.getElementById('cardBarcodeText').textContent = 'ID: ' + (st.id || st.reg_no || ('NADUFM-' + pickerLib.enNum(st.roll || '01')));

            const photoWrap = document.getElementById('cardPhotoWrap');
            photoWrap.innerHTML = '';
            const img = document.createElement('img');
            img.src = pickerLib.safePhotoUrl(st.photo);
            img.alt = st.name_bn || 'Student Photo';
            img.onerror = function () { this.src = '/logo.png'; };
            photoWrap.appendChild(img);

            const qCls = encodeURIComponent(st.classKey || clsVal || st.class_name || '');
            const qRoll = encodeURIComponent(st.roll || '');
            const embedSuffix = <%- isEmbedded ? "'&embed=1'" : "''" %>;
            document.getElementById('linkIdToAdmit').href = '/admit.php?class=' + qCls + '&roll=' + qRoll + embedSuffix;
            document.getElementById('linkIdToMarksheet').href = '/result.php?class=' + qCls + '&roll=' + qRoll + embedSuffix;
            document.getElementById('linkIdToProfile').href = '/student-search.php?class=' + qCls + '&roll=' + qRoll + '&doc=attestation' + embedSuffix;

            document.getElementById('idSearchCard').style.display = 'none';
            document.getElementById('idResultSection').style.display = 'block';
        }

        window.resetIdSearch = function () {
            document.getElementById('idResultSection').style.display = 'none';
            document.getElementById('idSearchCard').style.display = 'block';
        };

        window.downloadIdCardPdf = async function () {
            const sheet = document.getElementById('idCardPrintableSheet');
            const stEl = document.getElementById('idExportStatus');
            const setStatus = function (msg, isErr) {
                stEl.style.display = 'block';
                stEl.textContent = msg;
                stEl.style.background = isErr ? '#fef2f2' : '#f0fdf4';
                stEl.style.color = isErr ? '#b91c1c' : '#15803d';
                stEl.style.border = isErr ? '1px solid #fecaca' : '1px solid #bbf7d0';
            };
            try {
                if (!window.NadufmExport) throw new Error('এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
                await window.NadufmExport.exportElementToA4Pdf({
                    element: sheet,
                    filename: 'student-id-card-' + Date.now() + '.pdf',
                    marginMm: 6,
                    onStatus: setStatus,
                });
            } catch (err) {
                setStatus(err?.message || 'PDF ডাউনলোড ব্যর্থ হয়েছে।', true);
            }
        };

        document.getElementById('idCardSearchForm').addEventListener('submit', function (e) {
            e.preventDefault();
            fetchAndShowIdCard(classEl.value, rollEl.value.trim());
        });

        pickerLib.attachClassRollPicker({
            classSelect: classEl,
            rollInput: rollEl,
            rollAutoSelect: document.getElementById('idRollAutoSelect'),
            rollListWrap: document.getElementById('idRollAutoWrap'),
            rollChipsContainer: document.getElementById('idRollChips'),
            rollDatalist: document.getElementById('idRollDatalist'),
            rollCountBadge: document.getElementById('idRollCountBadge'),
            onRollPicked: function (picked) {
                fetchAndShowIdCard(classEl.value, picked.roll);
            },
        }).then(function (ctrl) {
            const params = new URLSearchParams(window.location.search);
            const initCls = params.get('class');
            const initRoll = params.get('roll');
            if (initCls) {
                classEl.value = initCls;
                if (ctrl) ctrl.loadRollsForClass(initCls);
            }
            if (initRoll) {
                rollEl.value = initRoll;
                fetchAndShowIdCard(initCls || classEl.value, initRoll);
            }
        });
    })();
</script>

<%- include('partials/footer') %>
