<%- include('partials/header') %>

<%
    const items = Array.isArray(galleryItems) ? galleryItems : [];
    const catLabels = typeof galleryCategories !== 'undefined' && galleryCategories ? galleryCategories : {
        campus: { id: 'campus', label: 'ক্যাম্পাস জীবন' },
        events: { id: 'events', label: 'অনুষ্ঠান ও কার্যক্রম' },
        milestones: { id: 'milestones', label: 'মাইলফলক ও অর্জন' },
    };
    const milestonesList = Array.isArray(milestones) ? milestones : [];
%>

<main class="gal-page-main">
    <div class="gal-shell">
        <header class="gal-hero-header">
            <div class="gal-hero-copy">
                <p class="gal-kicker">স্থিরচিত্র সংকলন · নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</p>
                <h1 class="gal-title">ক্যাম্পাস জীবন, অনুষ্ঠান ও মাইলফলক গ্যালারি</h1>
                <p class="gal-subtitle">মাদ্রাসার নিত্যদিনের শিক্ষাপরিবেশ, সাংস্কৃতিক ও পুরস্কার বিতরণী আয়োজন এবং ঐতিহাসিক অর্জনের নির্বাচিত স্থিরচিত্র।</p>
            </div>
            <div class="gal-summary-stat">
                <span class="gal-stat-label">প্রদর্শিত স্থিরচিত্র</span>
                <span class="gal-stat-value" id="galTotalCount"><%= convertToBengali(items.length) %></span>
            </div>
        </header>

        <section class="gal-toolbar" aria-label="গ্যালারি ফিল্টার ও অনুসন্ধান">
            <div class="gal-filter-tabs" role="tablist" aria-label="বিভাগ অনুযায়ী ছবি ফিল্টার">
                <button type="button" class="gal-filter-btn active" data-gal-cat="all" role="tab" aria-selected="true">সব ছবি</button>
                <button type="button" class="gal-filter-btn" data-gal-cat="campus" role="tab" aria-selected="false">ক্যাম্পাস জীবন</button>
                <button type="button" class="gal-filter-btn" data-gal-cat="events" role="tab" aria-selected="false">অনুষ্ঠান ও কার্যক্রম</button>
                <button type="button" class="gal-filter-btn" data-gal-cat="milestones" role="tab" aria-selected="false">মাইলফলক ও অর্জন</button>
            </div>
            <div class="gal-search-wrap">
                <%- iconSvg('search', 'app-svg-icon', 17) %>
                <input type="search" id="galSearchInput" class="gal-search-input" placeholder="শিরোনাম, স্থান বা তারিখ খুঁজুন..." aria-label="গ্যালারি ছবি খুঁজুন">
            </div>
        </section>

        <section aria-label="স্থিরচিত্র সম্ভার">
            <div class="gal-bento-grid" id="galGrid"></div>
            <div class="gal-empty-state" id="galEmptyState" hidden>
                <span class="gal-empty-ico" aria-hidden="true"><%- iconSvg('camera', 'app-svg-icon', 34) %></span>
                <p>নির্বাচিত বিভাগ বা অনুসন্ধানের সাথে মিল রেখে কোনো ছবি পাওয়া যায়নি।</p>
                <button type="button" class="gal-reset-btn" id="galResetFiltersBtn">সব ছবি দেখুন</button>
            </div>
        </section>

        <% if (milestonesList.length > 0) { %>
        <section class="gal-milestones-band" aria-label="প্রতিষ্ঠানের ঐতিহাসিক মাইলফলক">
            <div class="gal-section-head">
                <h2>প্রতিষ্ঠানের গৌরবময় মাইলফলক</h2>
                <p>১৯৮০ সালে প্রতিষ্ঠা থেকে ফাজিল (ডিগ্রী) স্তরে উন্নীত হওয়ার উল্লেখযোগ্য অধ্যায়</p>
            </div>
            <div class="gal-milestones-grid">
                <% milestonesList.forEach(function(ms) { %>
                    <article class="gal-milestone-item">
                        <span class="gal-milestone-year"><%= ms.year %></span>
                        <h3><%= ms.title %></h3>
                        <p><%= ms.detail %></p>
                    </article>
                <% }); %>
            </div>
        </section>
        <% } %>
    </div>
</main>

<div id="galLightbox" class="gal-lightbox" role="dialog" aria-modal="true" aria-labelledby="galLbTitle" hidden>
    <div class="gal-lb-backdrop" data-gal-close></div>
    <div class="gal-lb-dialog">
        <div class="gal-lb-topbar">
            <div class="gal-lb-counter" id="galLbCounter">১ / ১</div>
            <button type="button" class="gal-lb-close" id="galLbCloseBtn" aria-label="ছবি প্রদর্শনী বন্ধ করুন">
                <%- iconSvg('close', 'app-svg-icon', 20) %>
            </button>
        </div>

        <div class="gal-lb-stage">
            <button type="button" class="gal-lb-nav gal-lb-prev" id="galLbPrevBtn" aria-label="পূর্ববর্তী ছবি">
                <%- iconSvg('chevron-left', 'app-svg-icon', 22) %>
            </button>

            <figure class="gal-lb-figure">
                <div class="gal-lb-img-frame" id="galLbImgFrame">
                    <img id="galLbImg" src="" alt="" referrerpolicy="no-referrer">
                    <div class="gal-img-fallback" id="galLbFallback" hidden>
                        <%- iconSvg('camera', 'app-svg-icon', 40) %>
                        <span id="galLbFallbackTitle"></span>
                    </div>
                </div>
                <figcaption class="gal-lb-caption-box">
                    <p class="gal-lb-meta" id="galLbMeta"></p>
                    <h2 id="galLbTitle"></h2>
                    <p class="gal-lb-desc" id="galLbDesc"></p>
                </figcaption>
            </figure>

            <button type="button" class="gal-lb-nav gal-lb-next" id="galLbNextBtn" aria-label="পরবর্তী ছবি">
                <%- iconSvg('chevron-right', 'app-svg-icon', 22) %>
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        const CATEGORY_LABELS = <%- JSON.stringify({
            campus: (catLabels.campus && catLabels.campus.label) || 'ক্যাম্পাস জীবন',
            events: (catLabels.events && catLabels.events.label) || 'অনুষ্ঠান ও কার্যক্রম',
            milestones: (catLabels.milestones && catLabels.milestones.label) || 'মাইলফলক ও অর্জন',
        }) %>;

        let allItems = <%- JSON.stringify(items) %>;
        let activeCategory = 'all';
        let searchQuery = '';
        let filteredItems = allItems.slice();
        let activeLightboxIdx = -1;

        const gridEl = document.getElementById('galGrid');
        const emptyEl = document.getElementById('galEmptyState');
        const totalEl = document.getElementById('galTotalCount');
        const searchInput = document.getElementById('galSearchInput');
        const resetBtn = document.getElementById('galResetFiltersBtn');
        const filterBtns = document.querySelectorAll('[data-gal-cat]');

        const lbEl = document.getElementById('galLightbox');
        const lbImg = document.getElementById('galLbImg');
        const lbFallback = document.getElementById('galLbFallback');
        const lbFallbackTitle = document.getElementById('galLbFallbackTitle');
        const lbTitle = document.getElementById('galLbTitle');
        const lbMeta = document.getElementById('galLbMeta');
        const lbDesc = document.getElementById('galLbDesc');
        const lbCounter = document.getElementById('galLbCounter');
        const lbCloseBtn = document.getElementById('galLbCloseBtn');
        const lbPrevBtn = document.getElementById('galLbPrevBtn');
        const lbNextBtn = document.getElementById('galLbNextBtn');

        const cameraIconHtml = <%- JSON.stringify(iconSvg('camera', 'app-svg-icon', 32)) %>;

        function bnNum(val) {
            const digits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
            return String(val ?? '').replace(/[0-9]/g, function (d) { return digits[Number(d)]; });
        }

        function esc(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function safeUrl(url) {
            const val = String(url || '').trim();
            if (!val) return '';
            if (val.startsWith('/') || val.startsWith('https://') || val.startsWith('http://') || val.startsWith('data:image/')) {
                return val;
            }
            return '/' + val.replace(/^\/+/, '');
        }

        function getCategoryLabel(cat) {
            return CATEGORY_LABELS[cat] || 'ক্যাম্পাস জীবন';
        }

        function applyFilter() {
            const q = searchQuery.trim().toLowerCase();
            filteredItems = allItems.filter(function (item) {
                const catOk = activeCategory === 'all' || item.category === activeCategory;
                if (!catOk) return false;
                if (!q) return true;
                const haystack = [
                    item.title,
                    item.caption,
                    item.location,
                    item.date,
                    getCategoryLabel(item.category),
                ].join(' ').toLowerCase();
                return haystack.indexOf(q) !== -1;
            });

            if (totalEl) {
                totalEl.textContent = bnNum(filteredItems.length);
            }
            renderGrid();
        }

        function renderGrid() {
            if (!gridEl) return;
            gridEl.innerHTML = '';

            if (!filteredItems.length) {
                if (emptyEl) emptyEl.hidden = false;
                return;
            }
            if (emptyEl) emptyEl.hidden = true;

            const allowWide = activeCategory === 'all' && !searchQuery.trim();

            filteredItems.forEach(function (item, idx) {
                const isWide = allowWide && Boolean(item.featured);
                const imgSrc = safeUrl(item.imageUrl);
                const catLabel = getCategoryLabel(item.category);
                const metaParts = [catLabel];
                if (item.date) metaParts.push(item.date);
                if (item.location) metaParts.push(item.location);

                const card = document.createElement('button');
                card.type = 'button';
                card.className = 'gal-card' + (isWide ? ' is-wide' : '');
                card.setAttribute('aria-label', item.title + ' — বড় করে দেখতে ক্লিক করুন');

                card.innerHTML =
                    '<div class="gal-card-media">' +
                        (imgSrc
                            ? '<img src="' + esc(imgSrc) + '" alt="' + esc(item.title) + '" loading="lazy" referrerpolicy="no-referrer">'
                            : '') +
                        '<div class="gal-img-fallback"' + (imgSrc ? ' hidden' : '') + '>' +
                            cameraIconHtml +
                            '<span>' + esc(item.title) + '</span>' +
                        '</div>' +
                    '</div>' +
                    '<div class="gal-card-body">' +
                        '<p class="gal-card-meta">' + esc(metaParts.join(' · ')) + '</p>' +
                        '<h3 class="gal-card-title">' + esc(item.title) + '</h3>' +
                        (item.caption ? '<p class="gal-card-caption">' + esc(item.caption) + '</p>' : '') +
                    '</div>';

                const imgEl = card.querySelector('img');
                const fbEl = card.querySelector('.gal-img-fallback');
                if (imgEl && fbEl) {
                    imgEl.addEventListener('error', function () {
                        imgEl.hidden = true;
                        fbEl.hidden = false;
                    });
                }

                card.addEventListener('click', function () {
                    openLightbox(idx);
                });

                gridEl.appendChild(card);
            });
        }

        function updateLightboxContent() {
            if (activeLightboxIdx < 0 || activeLightboxIdx >= filteredItems.length) return;
            const item = filteredItems[activeLightboxIdx];
            const imgSrc = safeUrl(item.imageUrl);
            const catLabel = getCategoryLabel(item.category);
            const metaParts = [catLabel];
            if (item.date) metaParts.push(item.date);
            if (item.location) metaParts.push(item.location);

            lbMeta.textContent = metaParts.join(' · ');
            lbTitle.textContent = item.title || '';
            lbDesc.textContent = item.caption || '';
            lbCounter.textContent = bnNum(activeLightboxIdx + 1) + ' / ' + bnNum(filteredItems.length);

            if (imgSrc) {
                lbImg.hidden = false;
                lbFallback.hidden = true;
                lbImg.src = imgSrc;
                lbImg.alt = item.title || 'গ্যালারি স্থিরচিত্র';
            } else {
                lbImg.hidden = true;
                lbImg.src = '';
                lbFallback.hidden = false;
                lbFallbackTitle.textContent = item.title || '';
            }

            const multi = filteredItems.length > 1;
            lbPrevBtn.disabled = !multi;
            lbNextBtn.disabled = !multi;
        }

        function openLightbox(idx) {
            if (!filteredItems.length) return;
            activeLightboxIdx = idx;
            updateLightboxContent();
            lbEl.hidden = false;
            document.body.style.overflow = 'hidden';
            if (lbCloseBtn) lbCloseBtn.focus();
        }

        function closeLightbox() {
            if (lbEl.hidden) return;
            lbEl.hidden = true;
            document.body.style.overflow = '';
            activeLightboxIdx = -1;
        }

        function stepLightbox(delta) {
            if (filteredItems.length <= 1 || activeLightboxIdx < 0) return;
            activeLightboxIdx = (activeLightboxIdx + delta + filteredItems.length) % filteredItems.length;
            updateLightboxContent();
        }

        if (lbImg) {
            lbImg.addEventListener('error', function () {
                lbImg.hidden = true;
                lbFallback.hidden = false;
                const item = filteredItems[activeLightboxIdx];
                lbFallbackTitle.textContent = item ? item.title : '';
            });
        }

        filterBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                activeCategory = btn.getAttribute('data-gal-cat') || 'all';
                filterBtns.forEach(function (b) {
                    const isAct = b === btn;
                    b.classList.toggle('active', isAct);
                    b.setAttribute('aria-selected', isAct ? 'true' : 'false');
                });
                applyFilter();
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                searchQuery = searchInput.value || '';
                applyFilter();
            });
        }

        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                activeCategory = 'all';
                searchQuery = '';
                if (searchInput) searchInput.value = '';
                filterBtns.forEach(function (b) {
                    const isAct = b.getAttribute('data-gal-cat') === 'all';
                    b.classList.toggle('active', isAct);
                    b.setAttribute('aria-selected', isAct ? 'true' : 'false');
                });
                applyFilter();
            });
        }

        if (lbCloseBtn) lbCloseBtn.addEventListener('click', closeLightbox);
        if (lbPrevBtn) lbPrevBtn.addEventListener('click', function () { stepLightbox(-1); });
        if (lbNextBtn) lbNextBtn.addEventListener('click', function () { stepLightbox(1); });

        lbEl.addEventListener('click', function (e) {
            if (e.target && e.target.hasAttribute('data-gal-close')) {
                closeLightbox();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (lbEl.hidden) return;
            if (e.key === 'Escape') closeLightbox();
            else if (e.key === 'ArrowLeft') stepLightbox(-1);
            else if (e.key === 'ArrowRight') stepLightbox(1);
        });

        document.addEventListener('DOMContentLoaded', function () {
            applyFilter();
            if (window.NadufmOffline) {
                window.NadufmOffline.getSnapshot('bootstrap').then(function (snap) {
                    if (snap && Array.isArray(snap.gallery) && snap.gallery.length) {
                        allItems = snap.gallery;
                        applyFilter();
                    }
                });
            }
        });
    })();
</script>

<%- include('partials/footer') %>
