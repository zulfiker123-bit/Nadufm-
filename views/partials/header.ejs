    <script>
        (function () {
            var isDashFrame = false;
            try {
                if (window.name === 'nadufm-dashboard-frame') {
                    isDashFrame = true;
                } else if (window.frameElement && (window.frameElement.id === 'workspaceFrame' || window.frameElement.name === 'nadufm-dashboard-frame')) {
                    isDashFrame = true;
                } else if (new URLSearchParams(window.location.search).get('embed') === '1') {
                    isDashFrame = true;
                }
            } catch (e) {}
            if (isDashFrame) {
                document.documentElement.classList.add('is-iframe-embed');
            }
        })();
        function nadufmGoBack() {
            if (window.history.length > 1 && document.referrer && document.referrer.indexOf(window.location.host) !== -1) {
                window.history.back();
            } else {
                window.location.href = '/index.php';
            }
        }
    </script>
</head>

<body>
<% const _cp = typeof currentPath !== 'undefined' ? String(currentPath) : '/'; %>
<% const _isHomePage = (_cp === '/' || _cp === '/index.php'); %>
<% if (!isEmbedded) { %>
    <div id="nadufmTopProgress" class="nadufm-top-progress" aria-hidden="true"></div>
    <header class="app-topbar">
        <div class="app-topbar-inner">
            <a href="/index.php" class="app-brand">
                <img src="/logo.png" alt="মাদ্রাসার লোগো" class="app-brand-logo" referrerpolicy="no-referrer">
