<%- include('partials/header') %>

<style>
    .admit-shell {
        max-width: 860px;
        margin: 24px auto 32px auto;
        padding: 0 16px;
    }

    .admit-search-card {
        max-width: 540px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.09);
        border-radius: 18px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    .admit-search-head {
        background: linear-gradient(135deg, #14532d 0%, #15803d 100%);
        color: #ffffff;
        padding: 24px 20px;
        text-align: center;
    }

    .admit-search-head h1 { font-size: 1.3rem; font-weight: 700; margin: 0; }
    .admit-search-head p { font-size: 0.9rem; opacity: 0.9; margin-top: 4px; }

    .admit-search-body { padding: 24px; }

    .input-group { margin-bottom: 16px; }
    .input-group label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
        font-size: 0.94rem;
        margin-bottom: 6px;
        color: #0f172a;
    }
    .input-group input,
    .input-group select {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        border-radius: 10px;
        background: #f8faf9;
        color: #0f172a;
        font-family: inherit;
        font-size: 0.95rem;
        outline: none;
    }
    .input-group input:focus,
    .input-group select:focus { border-color: #15803d; background: #ffffff; }

    .roll-auto-panel {
        margin-top: 10px;
        background: #f8faf9;
        border: 1px solid rgba(21, 128, 61, 0.22);
        border-radius: 12px;
        padding: 10px 12px;
    }

    .roll-auto-title {
        font-size: 0.84rem;
        font-weight: 700;
        color: #14532d;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .roll-auto-select {
        height: 40px !important;
        background: #ffffff !important;
        margin-bottom: 8px;
        font-size: 0.9rem !important;
    }

    .roll-chips-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        max-height: 150px;
        overflow-y: auto;
    }

    .roll-chip-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 8px;
        border: 1px solid rgba(21, 128, 61, 0.28);
        background: #ffffff;
        color: #0f172a;
        font-family: inherit;
        font-size: 0.84rem;
        cursor: pointer;
    }
    .roll-chip-btn:hover,
    .roll-chip-btn.active { background: #15803d; color: #ffffff; border-color: #15803d; }

    .roll-empty-note { font-size: 0.83rem; color: #64748b; }

    .id-count-pill {
        font-size: 0.78rem;
        font-weight: 700;
        color: #15803d;
        background: #dcfce7;
        padding: 2px 8px;
        border-radius: 999px;
    }

    .btn-search {
        width: 100%;
        min-height: 46px;
        background: #15803d;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-weight: 700;
        cursor: pointer;
        font-size: 1rem;
    }
    .btn-search:hover { background: #14532d; }

    #admit-card-result { display: none; }

    .admit-toolbar {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .btn-admit-action {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-print-admit { background: #15803d; color: #ffffff; }
    .btn-pdf-admit { background: #be123c; color: #ffffff; }
    .btn-link-admit { background: #1d4ed8; color: #ffffff; }
    .btn-reset-admit { background: #f1f5f9; color: #0f172a; border: 1px solid rgba(15, 23, 42, 0.12); }

    .admit-scroll-wrap { overflow-x: auto; }

    .admit-card {
        width: 180mm;
        margin: 0 auto;
        border: 2px solid #166534;
        padding: 20px;
        background: #ffffff;
        border-radius: 8px;
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    .admit-card * {
        font-family: 'Nikosh', 'Kalpurush', sans-serif;
    }

    .admit-header {
        display: flex;
        align-items: center;
        border-bottom: 2px solid #166534;
        padding-bottom: 12px;
        margin-bottom: 16px;
    }

    .admit-header img { width: 60px; margin-right: 14px; }
    .admit-title { text-align: center; flex-grow: 1; }
    .admit-title h2 { font-size: 18px; margin: 0; color: #14532d; }
    .admit-title p { font-size: 12px; margin: 2px 0; color: #475569; }
    .admit-doc-label { font-size: 13px; font-weight: 700; color: #166534; margin-top: 4px; }

    .admit-body { display: flex; gap: 20px; }
    .student-info { flex-grow: 1; }
    .info-row { display: flex; margin-bottom: 10px; border-bottom: 1px dotted #cbd5e1; padding-bottom: 3px; }
    .info-label { width: 125px; font-weight: 700; font-size: 14px; color: #0f172a; }
    .info-value { flex-grow: 1; font-size: 14px; color: #1e293b; font-variant-numeric: tabular-nums; }

    .student-photo { width: 100px; height: 112px; border: 1px solid #0f172a; overflow: hidden; flex-shrink: 0; }
    .student-photo img { width: 100%; height: 100%; object-fit: cover; }

    .admit-footer { margin-top: 46px; display: flex; justify-content: space-between; padding: 0 20px; }
    .sig { border-top: 1px solid #0f172a; width: 130px; text-align: center; font-size: 12px; font-weight: 700; padding-top: 4px; }

    @media print {
        .no-print, .app-footer, .app-topbar, .mobile-bottom-nav { display: none !important; }
        body { background: #ffffff; }
        .admit-shell { margin: 0; max-width: 100%; padding: 0; }
        #admit-card-result { display: block !important; }
        .admit-card { width: 100%; border: 1.5px solid #000; border-radius: 0; }
    }
</style>

<div class="admit-shell">
    <div class="admit-search-card no-print" id="admitSearchCard">
        <div class="admit-search-head">
            <h1>এডমিট কার্ড ডাউনলোড</h1>
            <p>শ্রেণি বাছাই করে অটো তালিকা থেকে রোল বেছে নিন অথবা রোল নম্বর লিখুন</p>
        </div>
        <div class="admit-search-body">
            <form id="searchForm">
                <div class="input-group">
                    <label for="search_class">শ্রেণি (Class)</label>
                    <select id="search_class" required>
                        <option value="">-- শ্রেণি নির্বাচন করুন --</option>
                        <% if (typeof classMap !== 'undefined') { %>
                            <% Object.entries(classMap).forEach(function([k, v]) { %>
                                <option value="<%= k %>"><%= v.name %> শ্রেণি</option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="input-group">
                    <label for="search_roll">
                        <span>রোল নম্বর (Roll)</span>
                        <span id="admitRollCountBadge" class="id-count-pill"></span>
                    </label>
                    <input type="text" id="search_roll" list="admitRollDatalist" placeholder="রোল নম্বর লিখুন (যেমন: 1 বা ১) অথবা তালিকা থেকে বেছে নিন" required>
                    <datalist id="admitRollDatalist"></datalist>

                    <div id="admitRollAutoWrap" class="roll-auto-panel" style="display:none;">
                        <div class="roll-auto-title">
                            <span><i class="fas fa-list-ol"></i> শ্রেণিভিত্তিক অটো রোল তালিকা</span>
                            <span style="font-size:0.78rem; color:#475569;">রোল নির্বাচন করুন</span>
                        </div>
                        <select id="admitRollAutoSelect" class="roll-auto-select"></select>
                        <div id="admitRollChips" class="roll-chips-list"></div>
                    </div>
                </div>
                <button type="submit" class="btn-search" id="searchBtn">প্রবেশপত্র খুঁজুন</button>
            </form>
            <p id="error-msg" style="color:#b91c1c; font-weight:600; text-align:center; display:none; margin-top:14px;">দুঃখিত! কোনো তথ্য পাওয়া যায়নি।</p>
        </div>
    </div>

    <div id="admit-card-result">
        <div class="admit-toolbar no-print">
            <button type="button" class="btn-admit-action btn-print-admit" onclick="window.print()">
                <i class="fas fa-print" aria-hidden="true"></i>
                <span>প্রিন্ট করুন</span>
            </button>
            <button type="button" class="btn-admit-action btn-pdf-admit" onclick="downloadAdmitPdf()">
                <i class="fas fa-file-pdf" aria-hidden="true"></i>
                <span>PDF ডাউনলোড</span>
            </button>
            <a id="linkAdmitToId" href="/id-card.php" class="btn-admit-action btn-link-admit">
                <i class="fas fa-id-badge" aria-hidden="true"></i>
                <span>আইডি কার্ড</span>
            </a>
            <a id="linkAdmitToResult" href="/result.php" class="btn-admit-action btn-link-admit">
                <i class="fas fa-poll" aria-hidden="true"></i>
                <span>মার্কশিট</span>
            </a>
            <a id="linkAdmitToProfile" href="/student-search.php" class="btn-admit-action btn-reset-admit">
                <i class="fas fa-certificate" aria-hidden="true"></i>
                <span>প্রত্যায়ন / প্রশংসা পত্র</span>
            </a>
            <button type="button" class="btn-admit-action btn-reset-admit" onclick="resetAdmitSearch()">
                <i class="fas fa-redo" aria-hidden="true"></i>
                <span>আবার খুঁজুন</span>
            </button>
        </div>

        <div id="admitExportStatus" class="no-print" style="display:none; max-width:540px; margin:0 auto 14px auto; padding:9px 13px; border-radius:9px; font-size:0.88rem; font-weight:600; text-align:center;"></div>

        <div class="admit-scroll-wrap">
            <div class="admit-card" id="admitCardPrintable">
                <div class="admit-header">
                    <img src="/logo.png" alt="Logo" referrerpolicy="no-referrer">
                    <div class="admit-title">
                        <h2>নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</h2>
                        <p>ডাকঘর: নলতা মোবারকনগর, কালিগঞ্জ, সাতক্ষীরা · EIIN: ১১৮৭৭৮</p>
                        <div class="admit-doc-label">প্রবেশপত্র (Admit Card)</div>
                    </div>
                </div>

                <div class="admit-body">
                    <div class="student-info">
                        <div class="info-row"><span class="info-label">শিক্ষার্থীর নাম:</span><span class="info-value" id="res_name"></span></div>
                        <div class="info-row"><span class="info-label">পিতার নাম:</span><span class="info-value" id="res_father"></span></div>
                        <div class="info-row"><span class="info-label">মাতার নাম:</span><span class="info-value" id="res_mother"></span></div>
                        <div class="info-row"><span class="info-label">শ্রেণি:</span><span class="info-value" id="res_class"></span></div>
                        <div class="info-row"><span class="info-label">রোল নম্বর:</span><span class="info-value" id="res_roll"></span></div>
                        <div class="info-row"><span class="info-label">আইডি / রেজিঃ নং:</span><span class="info-value" id="res_id"></span></div>
                    </div>
                    <div class="student-photo" id="res_photo"></div>
                </div>

                <div class="admit-footer">
                    <div class="sig">শিক্ষার্থীর স্বাক্ষর</div>
                    <div class="sig">পরীক্ষা নিয়ন্ত্রক</div>
                    <div class="sig">অধ্যক্ষের স্বাক্ষর</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/vendor/html2pdf.bundle.min.js" defer></script>
<script src="/doc-export.js" defer></script>
<script src="/student-picker.js"></script>
<script>
    const scriptURL = 'https://script.google.com/macros/s/AKfycbxZR0c6PLITftRWpUKe0usjXg-orylIVmTxQ0lYwolDKx1G84wIb_sg8RxDqAoVg7Wh1g/exec';
    const pickerLib = window.NadufmStudentPicker;
    const admitClassEl = document.getElementById('search_class');
    const admitRollEl = document.getElementById('search_roll');

    function resetAdmitSearch() {
        document.getElementById('admit-card-result').style.display = 'none';
        document.getElementById('admitSearchCard').style.display = 'block';
        const btn = document.getElementById('searchBtn');
        btn.disabled = false;
        btn.innerText = "প্রবেশপত্র খুঁজুন";
    }

    function showAdmitData(data, rawClass) {
        document.getElementById('res_name').innerText = data.name || '—';
        document.getElementById('res_father').innerText = data.father || '—';
        document.getElementById('res_mother').innerText = data.mother || '—';
        document.getElementById('res_class').innerText = data.class || '—';
        document.getElementById('res_roll').innerText = pickerLib.bnNum(data.roll || '—');
        document.getElementById('res_id').innerText = data.id || '—';

        const photoBox = document.getElementById('res_photo');
        photoBox.innerHTML = '';
        const img = document.createElement('img');
        img.src = pickerLib.safePhotoUrl(data.photo);
        img.alt = 'শিক্ষার্থীর ছবি';
        img.onerror = function () { this.src = '/logo.png'; };
        photoBox.appendChild(img);

        const qCls = encodeURIComponent(data.classKey || rawClass || data.class || '');
        const qRoll = encodeURIComponent(data.roll || '');
        const embedSuffix = <%- isEmbedded ? "'&embed=1'" : "''" %>;
        document.getElementById('linkAdmitToId').href = '/id-card.php?class=' + qCls + '&roll=' + qRoll + embedSuffix;
        document.getElementById('linkAdmitToResult').href = '/result.php?class=' + qCls + '&roll=' + qRoll + embedSuffix;
        document.getElementById('linkAdmitToProfile').href = '/student-search.php?class=' + qCls + '&roll=' + qRoll + '&doc=attestation' + embedSuffix;

        document.getElementById('admitSearchCard').style.display = 'none';
        document.getElementById('admit-card-result').style.display = 'block';
    }

    async function performAdmitLookup(sClass, roll) {
        const btn = document.getElementById('searchBtn');
        const errorMsg = document.getElementById('error-msg');
        if (!roll) return;

        btn.disabled = true;
        btn.innerText = "খোঁজা হচ্ছে...";
        errorMsg.style.display = "none";

        try {
            const localRes = await fetch('/api/portal/admit-lookup?roll=' + encodeURIComponent(roll) + '&class=' + encodeURIComponent(sClass || ''));
            if (localRes.ok) {
                const localData = await localRes.json();
                if (localData && localData.status === 'success') {
                    showAdmitData(localData, sClass);
                    return;
                }
            }
            const response = await fetch(`${scriptURL}?action=getStudent&roll=${encodeURIComponent(roll)}&class=${encodeURIComponent(sClass)}`);
            const data = await response.json();
            if (data.status === "success") {
                showAdmitData(data, sClass);
            } else {
                errorMsg.innerText = "দুঃখিত! কোনো তথ্য পাওয়া যায়নি।";
                errorMsg.style.display = "block";
            }
        } catch (err) {
            errorMsg.innerText = "দুঃখিত! তথ্য খুঁজে পাওয়া যায়নি বা সার্ভার সমস্যা হয়েছে।";
            errorMsg.style.display = "block";
        } finally {
            btn.disabled = false;
            btn.innerText = "প্রবেশপত্র খুঁজুন";
        }
    }

    async function downloadAdmitPdf() {
        const card = document.getElementById('admitCardPrintable');
        const stEl = document.getElementById('admitExportStatus');
        const setSt = function (msg, isErr) {
            stEl.style.display = 'block';
            stEl.textContent = msg;
            stEl.style.background = isErr ? '#fef2f2' : '#f0fdf4';
            stEl.style.color = isErr ? '#b91c1c' : '#15803d';
            stEl.style.border = isErr ? '1px solid #fecaca' : '1px solid #bbf7d0';
        };
        try {
            if (!window.NadufmExport) throw new Error('এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            await window.NadufmExport.exportElementToA4Pdf({
                element: card,
                filename: 'admit-card-' + Date.now() + '.pdf',
                marginMm: 10,
                onStatus: setSt
            });
        } catch (err) {
            setSt(err?.message || 'PDF ডাউনলোড ব্যর্থ হয়েছে।', true);
        }
    }

    document.getElementById('searchForm').addEventListener('submit', function(e) {
        e.preventDefault();
        performAdmitLookup(admitClassEl.value, admitRollEl.value.trim());
    });

    pickerLib.attachClassRollPicker({
        classSelect: admitClassEl,
        rollInput: admitRollEl,
        rollAutoSelect: document.getElementById('admitRollAutoSelect'),
        rollListWrap: document.getElementById('admitRollAutoWrap'),
        rollChipsContainer: document.getElementById('admitRollChips'),
        rollDatalist: document.getElementById('admitRollDatalist'),
        rollCountBadge: document.getElementById('admitRollCountBadge'),
        onRollPicked: function (picked) {
            performAdmitLookup(admitClassEl.value, picked.roll);
        }
    }).then(function (ctrl) {
        const params = new URLSearchParams(window.location.search);
        const initCls = params.get('class');
        const initRoll = params.get('roll');
        if (initCls) {
            admitClassEl.value = initCls;
            if (ctrl) ctrl.loadRollsForClass(initCls);
        }
        if (initRoll) {
            admitRollEl.value = initRoll;
            performAdmitLookup(initCls || admitClassEl.value, initRoll);
        }
    });
</script>

<%- include('partials/footer') %>
