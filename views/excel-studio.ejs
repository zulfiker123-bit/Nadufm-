    function onDocConfigChange() {
        const docType = document.getElementById('docTypeSelect').value;
        syncQuickSwitcherUI(docType);
        const isBatch = document.getElementById('docBatchMode').value === 'batch';
        const singleWrap = document.getElementById('singleRecordWrap');
        if (singleWrap) singleWrap.classList.toggle('hidden', isBatch);
        renderA4Document();
