            table.a4-ms-table th { background-color: #166534; color: #ffffff; }
            .a4-summary-grid { border: 1px solid #166534; padding: 8px; margin-top: 12px; font-weight: bold; }
            .a4-sign-row { margin-top: 40px; text-align: center; }
        `;
        if (btn) btn.disabled = true;
        try {
            if (!window.NadufmExport) {
                throw new Error('ডকুমেন্ট এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            }
            await window.NadufmExport.exportElementToWord({
                element: container,
                filename,
                title: docType,
                cssText,
                onStatus: (msg, isErr) => {
                    setDocExportStatus(msg, isErr);
                    showToast(msg, isErr);
                },
            });
        } catch (err) {
            const msg = err?.message || 'Word ফাইল তৈরি করতে সমস্যা হয়েছে।';
            setDocExportStatus(msg, true);
            showToast(msg, true);
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    function renderAll() {
        renderStudentsSection();
        renderResultsSection();
        renderDocumentsSection();
        populateDocRecordPicker();
    }

    initDropZones();
    document.getElementById('docDateText').value = bnNum(new Date().toISOString().slice(0, 10));
    renderAll();
    const initialTab = <%- JSON.stringify(initialTab || 'students') %>;
    if (initialTab && initialTab !== 'students' && typeof switchTab === 'function') {
        switchTab(initialTab);
    }
</script>
</body>
</html>
