                        <input type="number" min="5" max="500" value="${Number(col.fullMarks) || 100}" onchange="updateResultColFM(${idx}, this.value)" onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();}" aria-label="${esc(col.label)} পূর্ণমান">
                        <label style="display:inline-flex; align-items:center; gap:3px; font-size:0.74rem; color:#475569; cursor:pointer; margin-left:2px; white-space:nowrap;" title="৪র্থ / ঐচ্ছিক বিষয় হিসেবে চিহ্নিত করুন">
