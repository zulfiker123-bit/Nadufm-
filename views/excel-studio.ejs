        const classEntries = Object.entries(state.classMap || {});

        gridEl.innerHTML = classEntries.map(([cid, info]) => {
            const ex = getExamForClass(cid);
            const clsLabel = formatClassLabelClient(info.name, cid);
            const rowCount = (ex?.rows || []).length;
            const isSelected = activeCid === String(cid);
            let metaText = 'এখনো Excel আপলোড হয়নি';
            if (rowCount > 0) {
                const computed = recomputeExamClient(ex);
                metaText = `${bnNum(rowCount)} জন শিক্ষার্থী · পাস ${bnNum(computed.stats.passRate)}%`;
            }
            return `
                <div class="class-upload-row ${isSelected ? 'is-selected' : ''}" data-class-id="${esc(cid)}" onclick="selectClassResult('${esc(cid)}')">
                    <div class="class-upload-top">
                        <span class="class-upload-title">${esc(clsLabel)}</span>
                        <span class="class-upload-meta">${rowCount > 0 ? bnNum(rowCount) + ' জন' : 'খালি'}</span>
                    </div>
                    <div class="class-upload-meta">${esc(metaText)}</div>
                    <div class="class-upload-actions" onclick="event.stopPropagation()">
                        <label id="classUploadBtn_${esc(cid)}" class="btn btn-primary btn-sm upload-btn-wrap" onclick="event.stopPropagation()">
                            <span class="upload-btn-label"><i class="fas fa-upload" aria-hidden="true"></i> ${rowCount > 0 ? 'নতুন Excel' : 'Excel আপলোড'}</span>
                            <input type="file" id="classResultFile_${esc(cid)}" class="upload-overlay-input" accept=".xlsx,.xls,.xlsm,.xlsb,.csv,.tsv,.ods,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,text/plain" onclick="event.stopPropagation()" onchange="uploadClassResultExcel('${esc(cid)}', this.files && this.files[0], this)">
                        </label>
                        ${rowCount > 0 ? `
                            <button type="button" class="btn btn-outline btn-sm" onclick="event.stopPropagation(); selectClassResult('${esc(cid)}')">দেখুন</button>
                            <button type="button" class="btn btn-danger-outline btn-sm" onclick="clearClassResult('${esc(cid)}', event)" title="এই শ্রেণির রেজাল্ট মুছুন"><i class="fas fa-trash" aria-hidden="true"></i></button>
                        ` : ''}
                    </div>
                </div>
            `;
        }).join('');

        gridEl.querySelectorAll('.class-upload-row').forEach((card) => {
