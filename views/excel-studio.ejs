<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#14532d">
    <link rel="stylesheet" href="/fonts.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="/vendor/html2pdf.bundle.min.js" defer></script>
    <script src="/doc-export.js" defer></script>
    <style>
        :root {
            --brand: #14532d;
            --brand-dark: #14532d;
            --brand-strong: #15803d;
            --brand-tint: #f0fdf4;
            --bg: #f6f8f7;
            --surface: #ffffff;
            --surface-subtle: #f8faf9;
            --border: rgba(15, 23, 42, 0.09);
            --border-strong: rgba(15, 23, 42, 0.16);
            --text: #0f172a;
            --muted: #475569;
            --danger: #b91c1c;
            --amber: #b45309;
            --blue: #1d4ed8;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Kalpurush', sans-serif;
            background: var(--bg);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }

        button, input, select, textarea {
            font-family: inherit;
        }

        :focus-visible {
            outline: 2px solid var(--brand-strong);
            outline-offset: 2px;
        }

        .studio-topbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .studio-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .studio-brand img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--border);
        }

        .studio-brand h1 {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand);
            line-height: 1.2;
        }

        .studio-brand p {
            margin: 0;
            font-size: 0.78rem;
            color: var(--muted);
        }

        .studio-top-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .studio-container {
            max-width: 1360px;
            margin: 16px auto 40px auto;
            padding: 0 18px;
        }

        .studio-tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            background: linear-gradient(180deg, #e9efec 0%, #f4f7f5 100%);
            padding: 7px;
            border: 1px solid rgba(15, 23, 42, 0.1);
            border-radius: 14px;
            box-shadow: inset 0 2px 5px rgba(15, 23, 42, 0.08), 0 1px 0 rgba(255, 255, 255, 0.9);
            margin-bottom: 16px;
        }

        .studio-tab {
            flex: 1 1 180px;
            min-height: 43px;
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: 10px;
            background: linear-gradient(180deg, #ffffff 0%, #f3f6f4 100%);
            color: var(--muted);
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 6px 14px;
            white-space: nowrap;
            box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15, 23, 42, 0.08), 0 4px 8px -3px rgba(15, 23, 42, 0.08);
            transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, background 0.14s ease, color 0.14s ease;
        }

        .studio-tab:hover {
            transform: translateY(-1px);
            background: linear-gradient(180deg, #ffffff 0%, #ebf7ef 100%);
            color: var(--brand);
            box-shadow: inset 0 1px 0 #ffffff, 0 3.5px 0 rgba(21, 128, 61, 0.18), 0 6px 12px -3px rgba(21, 128, 61, 0.15);
        }

        .studio-tab:active {
            transform: translateY(1.5px);
            box-shadow: 0 1px 0 rgba(15, 23, 42, 0.09);
        }

        .studio-tab.active {
            background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
            border-color: #146c34;
            color: #ffffff;
            font-weight: 700;
            transform: translateY(-1px);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3.5px 0 #0e5427, 0 7px 15px -3px rgba(21, 128, 61, 0.36);
        }

        .studio-tab.active:hover {
            color: #ffffff;
            filter: brightness(1.03);
        }

        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* Flat single-elevation surfaces */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 14px;
        }

        .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .card-title {
            margin: 0;
            font-size: 1.04rem;
            font-weight: 700;
            color: var(--brand);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-sub {
            margin: 2px 0 0 0;
            font-size: 0.84rem;
            color: var(--muted);
        }

        .dirty-note {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--amber);
            display: none;
            align-items: center;
            gap: 5px;
        }

        .dirty-note.show {
            display: inline-flex;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 40px;
            padding: 0 15px;
            border-radius: 10px;
            border: 1px solid transparent;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            white-space: nowrap;
            flex-shrink: 0;
            transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.14s ease, filter 0.14s ease, border-color 0.14s ease;
        }

        .btn:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.03); }
        .btn:active:not(:disabled) { transform: translateY(2px); }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-sm { min-height: 36px; padding: 0 12px; font-size: 0.82rem; border-radius: 9px; }

        .btn-primary {
            background: linear-gradient(180deg, #1ea34d 0%, #15803d 100%);
            color: #ffffff;
            border-color: #146c34;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3px 0 #0e5427, 0 5px 12px -3px rgba(21, 128, 61, 0.3);
        }
        .btn-primary:active:not(:disabled) { box-shadow: 0 1px 0 #0e5427; }

        .btn-dark {
            background: linear-gradient(180deg, #334155 0%, #1e293b 100%);
            color: #ffffff;
            border-color: #0f172a;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 3px 0 #090e1a, 0 5px 12px -3px rgba(15, 23, 42, 0.32);
        }
        .btn-dark:active:not(:disabled) { box-shadow: 0 1px 0 #090e1a; }

        .btn-blue {
            background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff;
            border-color: #1e40af;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), 0 3px 0 #172f82, 0 5px 12px -3px rgba(29, 78, 216, 0.3);
        }
        .btn-blue:active:not(:disabled) { box-shadow: 0 1px 0 #172f82; }

        .btn-rose {
            background: linear-gradient(180deg, #e11d48 0%, #be123c 100%);
            color: #ffffff;
            border-color: #9f1239;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 3px 0 #881337, 0 5px 12px -3px rgba(190, 18, 60, 0.3);
        }
        .btn-rose:active:not(:disabled) { box-shadow: 0 1px 0 #881337; }

        .btn-amber {
            background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            border-color: #b45309;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 3px 0 #92400e, 0 5px 12px -3px rgba(217, 119, 6, 0.3);
        }
        .btn-amber:active:not(:disabled) { box-shadow: 0 1px 0 #92400e; }

        .btn-outline {
            background: linear-gradient(180deg, #ffffff 0%, #f2f6f4 100%);
            color: var(--text);
            border-color: rgba(15, 23, 42, 0.14);
            box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 rgba(15, 23, 42, 0.1), 0 4px 8px -3px rgba(15, 23, 42, 0.08);
        }
        .btn-outline:active:not(:disabled) { box-shadow: 0 1px 0 rgba(15, 23, 42, 0.1); }

        .btn-danger-outline {
            background: linear-gradient(180deg, #ffffff 0%, #fff1f2 100%);
            color: var(--danger);
            border-color: #fca5a5;
            box-shadow: inset 0 1px 0 #ffffff, 0 2.5px 0 #fca5a5, 0 4px 8px -3px rgba(185, 28, 28, 0.12);
        }
        .btn-danger-outline:active:not(:disabled) { box-shadow: 0 1px 0 #fca5a5; }

        .btn-group {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
        .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 12px; }

        .field label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .field input[type="text"],
        .field input[type="number"],
        .field input[type="date"],
        .field input[type="search"],
        .field select,
        .field textarea {
            width: 100%;
            min-height: 40px;
            padding: 7px 11px;
            border: 1px solid var(--border-strong);
            border-radius: 9px;
            font-size: 0.9rem;
            background: var(--surface-subtle);
            color: var(--text);
            outline: none;
        }

        .field input:focus,
        .field select:focus,
        .field textarea:focus {
            border-color: var(--brand-strong);
            background: var(--surface);
        }

        /* Clean Dropzone Upload Area */
        .upload-zone {
            border: 1.5px dashed rgba(21, 128, 61, 0.42);
            background: #f9fcf9;
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        .upload-zone.is-dragover {
            background: #ecfdf3;
            border-color: var(--brand-strong);
        }

        .upload-zone-info {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .upload-zone-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #dcfce7;
            color: var(--brand);
            display: grid;
            place-items: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .upload-file-input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .upload-btn-wrap {
            position: relative;
            overflow: hidden;
            margin: 0;
            cursor: pointer;
        }

        .upload-overlay-input {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            z-index: 2;
            font-size: 0;
        }

        .upload-status-box {
            display: none;
            margin-top: 10px;
            padding: 10px 13px;
            border-radius: 9px;
            font-size: 0.87rem;
            font-weight: 600;
        }

        /* Class-wise Segmented Filter Bar */
        .class-filter-wrap {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            padding: 10px 0 12px 0;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .class-filter-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            font-variant-numeric: tabular-nums;
        }

        .class-filter-label {
            font-size: 0.84rem;
            font-weight: 700;
            color: var(--muted);
            margin-right: 4px;
            white-space: nowrap;
        }

        .class-seg-btn {
            min-height: 36px;
            padding: 0 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface-subtle);
            color: var(--text);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }

        .class-seg-btn:hover {
            background: var(--brand-tint);
            border-color: rgba(21, 128, 61, 0.35);
            color: var(--brand-dark);
        }

        .class-seg-btn.active {
            background: var(--brand-strong);
            border-color: var(--brand-strong);
            color: #ffffff;
        }

        .search-toolbar-input {
            height: 38px;
            padding: 0 12px;
            border: 1px solid var(--border-strong);
            border-radius: 9px;
            background: var(--surface-subtle);
            color: var(--text);
            font-size: 0.88rem;
            min-width: 220px;
            outline: none;
        }

        .search-toolbar-input:focus {
            border-color: var(--brand-strong);
            background: var(--surface);
        }

        /* Collapsible Advanced Mapping / Subject Full-marks (no add-column option) */
        .adv-details {
            margin-top: 12px;
            border-top: 1px solid var(--border);
            padding-top: 10px;
        }

        .adv-details summary {
            cursor: pointer;
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--muted);
            user-select: none;
            list-style: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 4px 0;
        }

        .adv-details summary::-webkit-details-marker { display: none; }
        .adv-details summary:hover { color: var(--brand); }
        .adv-details[open] summary { color: var(--brand); margin-bottom: 12px; }

        .result-guide-box {
            background: linear-gradient(180deg, #f7fcf8 0%, #ffffff 100%);
            border: 1px solid rgba(21, 128, 61, 0.22);
            border-radius: 14px;
            padding: 14px 18px;
            margin-bottom: 14px;
        }

        .result-guide-summary {
            cursor: pointer;
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            user-select: none;
        }

        .result-guide-summary::-webkit-details-marker { display: none; }

        .result-guide-title {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            font-size: 1.02rem;
            font-weight: 700;
            color: var(--brand);
        }

        .result-guide-title i {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: #dcfce7;
            color: var(--brand);
            display: inline-grid;
            place-items: center;
            font-size: 0.92rem;
            flex-shrink: 0;
        }

        .result-guide-toggle {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--muted);
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .result-guide-box[open] .result-guide-toggle i {
            transform: rotate(180deg);
        }

        .result-guide-toggle i {
            transition: transform 0.16s ease;
        }

        .result-guide-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 10px;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid rgba(21, 128, 61, 0.14);
        }

        .result-guide-item {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px 12px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .result-guide-num {
            width: 24px;
            height: 24px;
            border-radius: 7px;
            background: #dcfce7;
            color: var(--brand);
            font-size: 0.82rem;
            font-weight: 700;
            display: inline-grid;
            place-items: center;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .result-guide-body h3 {
            margin: 0 0 3px 0;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text);
        }

        .result-guide-body p {
            margin: 0;
            font-size: 0.83rem;
            line-height: 1.5;
            color: var(--muted);
        }

        .result-guide-code {
            display: inline-block;
            padding: 0 5px;
            border-radius: 5px;
            background: #f1f5f9;
            border: 1px solid rgba(15, 23, 42, 0.08);
            color: var(--text);
            font-weight: 600;
            font-size: 0.8rem;
        }

        .subject-marks-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
            gap: 10px;
            margin-bottom: 12px;
        }

        .subject-mark-item {
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 8px 10px;
            background: var(--surface-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .subject-mark-item .sub-name-input {
            flex: 1;
            min-width: 105px;
            height: 32px;
            padding: 3px 7px;
            border: 1px solid var(--border-strong);
            border-radius: 6px;
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--text);
            background: var(--surface);
            font-family: inherit;
        }

        .subject-mark-item .sub-name-input:focus {
            outline: none;
            border-color: var(--brand-strong);
        }

        .subject-mark-item input[type="number"] {
            width: 64px;
            height: 32px;
            padding: 2px 6px;
            border: 1px solid var(--border-strong);
            border-radius: 6px;
            text-align: center;
            font-size: 0.84rem;
            background: var(--surface);
        }

        .th-col-edit {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            min-width: 108px;
        }

        .th-label-input {
            width: 100%;
            min-width: 96px;
            padding: 4px 6px;
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            font-size: 0.84rem;
            font-weight: 600;
            text-align: center;
            font-family: inherit;
        }

        .th-label-input:focus {
            outline: none;
            background: #ffffff;
            color: #0f172a;
            border-color: #ffffff;
        }

        .th-sub-controls {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            flex-wrap: wrap;
        }

        .th-fm-wrap {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 0.72rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.92);
        }

        .th-fm-input {
            width: 48px;
            height: 22px;
            padding: 0 3px;
            border: 1px solid rgba(255, 255, 255, 0.34);
            border-radius: 5px;
            background: rgba(255, 255, 255, 0.14);
            color: #ffffff;
            font-size: 0.74rem;
            font-weight: 700;
            text-align: center;
            font-variant-numeric: tabular-nums;
            font-family: inherit;
        }

        .th-fm-input:focus {
            outline: none;
            background: #ffffff;
            color: #0f172a;
            border-color: #ffffff;
        }

        .th-chip-btn {
            border: 1px solid rgba(255, 255, 255, 0.32);
            background: rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.92);
            border-radius: 5px;
            font-size: 0.69rem;
            font-weight: 700;
            padding: 1px 6px;
            height: 22px;
            cursor: pointer;
            line-height: 1;
            font-family: inherit;
        }

        .th-chip-btn:hover {
            background: rgba(255, 255, 255, 0.24);
            color: #ffffff;
        }

        .th-chip-btn.is-opt {
            background: #facc15;
            color: #713f12;
            border-color: #fde047;
        }

        /* High-Density Data Table */
        .table-wrap {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--surface);
        }

        table.sheet-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            font-variant-numeric: tabular-nums;
        }

        table.sheet-table th {
            background: #14532d;
            color: #ffffff;
            padding: 10px 8px;
            text-align: center;
            font-weight: 600;
            white-space: nowrap;
            border-right: 1px solid rgba(255, 255, 255, 0.14);
        }

        table.sheet-table td {
            border-bottom: 1px solid rgba(15, 23, 42, 0.07);
            border-right: 1px solid rgba(15, 23, 42, 0.05);
            padding: 4px 6px;
            text-align: center;
            vertical-align: middle;
        }

        table.sheet-table tr:nth-child(even) td { background: #f9fbfa; }
        table.sheet-table tbody tr:hover td { background: #f0fdf4; }

        .cell-input {
            width: 100%;
            min-width: 72px;
            padding: 6px 8px;
            border: 1px solid transparent;
            border-radius: 6px;
            background: transparent;
            font-size: 0.88rem;
            color: var(--text);
            text-align: inherit;
        }

        .cell-input:focus {
            outline: none;
            border-color: var(--brand-strong);
            background: #ffffff;
