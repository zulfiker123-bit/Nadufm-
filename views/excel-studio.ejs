                                        </div>
                                        ${customRemarkHtml}
                                        <div class="trad-para-wish">
                                            আমি তাহার জীবনের সর্বাঙ্গীন উন্নতি ও খায়েরিয়াত কামনা করি।
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="trad-sign-footer">
                                <div class="trad-sign-left">
                                    <div class="trad-sign-line-row">
                                        <span>লেখক</span>
                                        <span class="trad-fill-inline" style="min-width:165px;" contenteditable="true"></span>
                                    </div>
                                    <div class="trad-sign-line-row">
                                        <span>তারিখ :</span>
                                        <span class="trad-fill-inline" style="min-width:155px;" contenteditable="true">${esc(dateText)}</span>
                                    </div>
                                </div>
                                <div class="trad-sign-right">
                                    <div class="trad-sign-rule">${signLabel}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    function renderA4Document() {
        const container = document.getElementById('a4PagesContainer');
        const docType = document.getElementById('docTypeSelect').value;
        const batchMode = document.getElementById('docBatchMode').value === 'batch';
        const style = getDocStyle();
        const filterClsKey = document.getElementById('docClassFilter')?.value || '';

        const memoNo = document.getElementById('docMemoNo').value;
        const dateText = document.getElementById('docDateText').value;
        const fName = document.getElementById('fName').value || 'মোঃ আব্দুল্লাহ আল মামুন';
        const fRoll = document.getElementById('fRoll').value || '০১';
        const fFather = document.getElementById('fFather').value || 'মোঃ আব্দুর রহমান';
        const fMother = document.getElementById('fMother').value || 'মোছাঃ আমেনা বেগম';
        const fClass = document.getElementById('fClass').value || 'ষষ্ঠ';
        const fSession = document.getElementById('fSession').value || '২০২৫-২০২৬';
        const fDob = document.getElementById('fDob').value || '২০১০-০৫-১২';
        const fReg = document.getElementById('fReg').value || '—';
        const fGpa = document.getElementById('fGpa').value || '৫.০০';
        const fAddress = document.getElementById('fAddress').value || 'নলতা শরীফ, কালিগঞ্জ, সাতক্ষীরা';
        const fPrincipal = document.getElementById('fPrincipalLabel').value || 'অধ্যক্ষ';
        const fRemark = document.getElementById('fRemark').value || '';

        const filteredPool = unifiedPoolCache.filter((u) => !filterClsKey || u.clsKey === filterClsKey);

        if (docType === 'marksheet') {
            if (batchMode) {
                const withRes = filteredPool.filter((u) => u.hasResultInfo && u.ev && u.exam);
                if (!withRes.length) {
                    const exam = getActiveExam();
                    const computed = recomputeExamClient(exam);
                    if (!computed.evaluatedRows.length) {
                        container.innerHTML = `<div class="a4-page" style="padding:20mm;"><p>রেজাল্ট শিটে কোনো শিক্ষার্থী পাওয়া যায়নি। প্রথমে "২. রেজাল্ট শিট আপলোড" ট্যাব থেকে শিট আপলোড করুন।</p></div>`;
                        return;
                    }
                    container.innerHTML = computed.evaluatedRows.map((ev) => buildMarksheetPageHtml(ev, exam, style)).join('');
                    return;
                }
                container.innerHTML = withRes.map((u) => buildMarksheetPageHtml(u.ev, u.exam, style, u.name, u.roll, u.father, u.cls)).join('');
                return;
            }

            let activeExamForSheet = currentStudioRecord?.exam || getActiveExam();
            let ev = currentStudioRecord?.ev || null;

            if (!ev) {
                const subCols = (activeExamForSheet?.columns || []).filter((c) => c.isSubject);
                container.innerHTML = `
                    <div class="a4-page" style="padding:${style.mTop}mm ${style.mRight}mm ${style.mBottom}mm ${style.mLeft}mm; font-size:${style.fontSize}px;">
                        <div class="a4-frame" style="justify-content:center; align-items:center; text-align:center;">
                            <div>
                                <img src="/logo.png" alt="Logo" style="width:68px; height:68px; margin-bottom:10px;">
                                <h3 style="color:#14532d; margin-bottom:6px;">${esc(fName)} (শ্রেণি: ${esc(fClass)}, রোল: ${bnNum(fRoll)})</h3>
                                <p style="color:#475569; max-width:440px; margin:0 auto;">
                                    এই শিক্ষার্থীর জন্য এখনো কোনো রেজাল্ট শিট আপলোড করা হয়নি। "২. রেজাল্ট শিট আপলোড" ট্যাবে রেজাল্ট শিট আপলোড করলে এখানে স্বয়ংক্রিয়ভাবে মার্কশিট তৈরি হবে; অথবা আইডি কার্ড, প্রত্যায়ন পত্র ও প্রশংসা পত্র প্রিন্ট করতে পারবেন।
                                </p>
                            </div>
                        </div>
                    </div>
                `;
                return;
            }
            container.innerHTML = buildMarksheetPageHtml(ev, activeExamForSheet, style, fName, fRoll, fFather, fClass);
            return;
        }

        if (docType === 'admit' || docType === 'idcard') {
            const records = batchMode
                ? filteredPool.map((u) => ({
                    name: u.name,
                    roll: u.roll,
                    father: u.father,
                    mother: u.mother,
                    cls: u.cls,
                    session: u.session || fSession,
                    reg: u.reg || u.id,
                    dob: u.dob,
                    mobile: u.mobile,
                    blood: u.blood,
                    address: u.address || fAddress,
                    photo: u.photo || '/logo.png',
                }))
                : [{
                    name: fName,
                    roll: fRoll,
                    father: fFather,
                    mother: fMother,
                    cls: fClass,
                    session: fSession,
                    reg: fReg,
                    dob: fDob,
                    mobile: currentStudioRecord?.mobile || '',
                    blood: currentStudioRecord?.blood || '',
                    address: fAddress,
                    photo: currentStudioRecord?.photo || '/logo.png',
                }];

            if (!records.length) {
                container.innerHTML = `<div class="a4-page" style="padding:20mm;"><p>ব্যাচ প্রিন্টের জন্য কোনো শিক্ষার্থী পাওয়া যায়নি।</p></div>`;
                return;
            }

            if (docType === 'admit') {
                const buildAdmitCard = (st) => `
                    <div style="border:2px solid #166534; padding:16px 18px; border-radius:6px; margin-bottom:14mm; background:#fff;">
                        <div class="a4-inst-header" style="margin-bottom:10px; padding-bottom:8px;">
                            <img src="/logo.png" alt="Logo" style="width:54px; height:54px;">
                            <div class="a4-inst-title">
                                <h2 style="font-size:1.18em;">নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</h2>
                                <p>নলতা শরীফ, কালিগঞ্জ, সাতক্ষীরা · EIIN: ১১৮৭৭৮</p>
                                <p style="color:#14532d; font-weight:700; text-decoration:underline;">প্রবেশপত্র (ADMIT CARD)</p>
                            </div>
                            <img src="${esc(st.photo || '/logo.png')}" alt="Photo" onerror="this.src='/logo.png'" style="width:54px; height:62px; object-fit:cover; border:1px solid #166534; border-radius:4px;">
                        </div>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px 14px; font-size:0.95em;">
                            <div><strong>শিক্ষার্থীর নাম:</strong> ${esc(st.name || '—')}</div>
                            <div><strong>রোল নম্বর:</strong> ${bnNum(st.roll || '—')}</div>
                            <div><strong>পিতার নাম:</strong> ${esc(st.father || '—')}</div>
                            <div><strong>মাতার নাম:</strong> ${esc(st.mother || '—')}</div>
                            <div><strong>শ্রেণি:</strong> ${esc(st.cls || '—')}</div>
                            <div><strong>আইডি / রেজিঃ:</strong> ${esc(st.reg || '—')}</div>
                        </div>
                        <div class="a4-sign-row" style="margin-top:34px;">
                            <div class="a4-sign-box"><div class="a4-sign-line">শিক্ষার্থীর স্বাক্ষর</div></div>
                            <div class="a4-sign-box"><div class="a4-sign-line">পরীক্ষা নিয়ন্ত্রক</div></div>
                            <div class="a4-sign-box"><div class="a4-sign-line">${esc(fPrincipal.split(',')[0] || 'অধ্যক্ষের স্বাক্ষর')}</div></div>
                        </div>
                    </div>
                `;
                const pages = [];
                for (let i = 0; i < records.length; i += 2) {
                    const pair = records.slice(i, i + 2).map(buildAdmitCard).join('');
                    pages.push(`<div class="a4-page" style="padding:${style.mTop}mm ${style.mRight}mm ${style.mBottom}mm ${style.mLeft}mm; font-size:${style.fontSize}px;">${pair}</div>`);
                }
                container.innerHTML = pages.join('');
                return;
            }

            const buildStudioIdCard = (st) => `
                <div style="width:74mm; min-height:112mm; border:2px solid #14532d; border-radius:8px; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; background:#fff; break-inside:avoid;">
                    <div>
                        <div style="background:#14532d; color:#fff; padding:8px; text-align:center; border-bottom:3px solid #f59e0b;">
                            <div style="display:flex; align-items:center; justify-content:center; gap:6px;">
                                <img src="/logo.png" style="width:26px; height:26px; border-radius:50%; background:#fff; padding:2px;" alt="Logo">
                                <strong style="font-size:11px; line-height:1.2;">নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা</strong>
                            </div>
                            <div style="font-size:9.5px; color:#fef3c7; margin-top:2px;">শিক্ষার্থী পরিচয়পত্র · EIIN: ১১৮৭৭৮</div>
                        </div>
                        <div style="padding:9px 10px; font-size:11.4px; line-height:1.48;">
                            <div style="width:52px; height:58px; margin:0 auto 5px auto; border:1.5px solid #14532d; border-radius:6px; overflow:hidden;">
                                <img src="${esc(st.photo || '/logo.png')}" onerror="this.src='/logo.png'" style="width:100%; height:100%; object-fit:cover;" alt="Photo">
                            </div>
                            <div style="text-align:center; font-size:13.8px; font-weight:700; color:#14532d; margin-bottom:4px;">${esc(st.name || '—')}</div>
                            <div><strong>শ্রেণি:</strong> ${esc(st.cls || '—')} · <strong>রোল:</strong> ${bnNum(st.roll || '—')}</div>
                            <div><strong>আইডি / রেজিঃ:</strong> ${esc(st.reg || '—')}</div>
                            <div><strong>পিতার নাম:</strong> ${esc(st.father || '—')}</div>
                            <div><strong>মাতার নাম:</strong> ${esc(st.mother || '—')}</div>
                            <div><strong>জন্ম তারিখ:</strong> ${esc(st.dob || '—')}${st.blood ? ' · <strong>রক্ত:</strong> ' + esc(st.blood) : ''}</div>
                            ${st.mobile ? `<div><strong>মোবাইল:</strong> ${esc(st.mobile)}</div>` : ''}
                            <div><strong>ঠিকানা:</strong> ${esc(st.address || 'নলতা, সাতক্ষীরা')}</div>
                        </div>
                    </div>
                    <div style="background:#f0fdf4; border-top:1px solid #bbf7d0; padding:6px 10px; display:flex; justify-content:space-between; font-size:10.5px;">
                        <span>শিক্ষাবর্ষ: <strong>${esc(st.session || fSession)}</strong></span>
                        <span style="border-top:1px solid #14532d; padding-top:2px; font-weight:700;">অধ্যক্ষের স্বাক্ষর</span>
                    </div>
                </div>
            `;
            const idPages = [];
            for (let i = 0; i < records.length; i += 4) {
                const chunk = records.slice(i, i + 4).map(buildStudioIdCard).join('');
                idPages.push(`<div class="a4-page" style="padding:${style.mTop}mm ${style.mRight}mm ${style.mBottom}mm ${style.mLeft}mm; font-size:${style.fontSize}px;"><div style="display:grid; grid-template-columns:1fr 1fr; gap:10mm; justify-items:center;">${chunk}</div></div>`);
            }
            container.innerHTML = idPages.join('');
            return;
        }

        // Attestation or Testimonial (single or batch)
        if (batchMode) {
            if (!filteredPool.length) {
                container.innerHTML = `<div class="a4-page" style="padding:20mm;"><p>ব্যাচ প্রিন্টের জন্য কোনো শিক্ষার্থী পাওয়া যায়নি।</p></div>`;
                return;
            }
            container.innerHTML = filteredPool.map((u) => buildCertificatePageHtml(docType, u, style, memoNo, dateText, fPrincipal, fRemark)).join('');
            return;
        }

        container.innerHTML = buildCertificatePageHtml(docType, {
            name: fName,
            roll: fRoll,
            father: fFather,
            mother: fMother,
            cls: fClass,
            session: fSession,
            dob: fDob,
            reg: fReg,
            gpa: fGpa,
            address: fAddress,
            remark: fRemark,
        }, style, memoNo, dateText, fPrincipal, fRemark);
    }

    function setDocExportStatus(msg, isErr) {
        const el = document.getElementById('docExportStatus');
        if (!el) return;
        if (!msg) {
            el.style.display = 'none';
            return;
        }
        el.style.display = 'block';
        el.textContent = msg;
        el.style.background = isErr ? '#fef2f2' : '#f0fdf4';
        el.style.color = isErr ? '#b91c1c' : '#15803d';
        el.style.border = isErr ? '1px solid #fecaca' : '1px solid #bbf7d0';
    }

    function printA4() {
        try {
            window.focus();
            window.print();
        } catch (err) {
            setDocExportStatus('সরাসরি প্রিন্ট ডায়ালগ খোলা যায়নি, অনুগ্রহ করে PDF ডাউনলোড ব্যবহার করুন।', true);
        }
    }

    async function downloadA4Pdf() {
        const container = document.getElementById('a4PagesContainer');
        const btn = document.getElementById('btnDownloadA4Pdf');
        if (!container) return;
        const docType = document.getElementById('docTypeSelect').value;
        const filename = `${docType}-a4-${Date.now()}.pdf`;
        if (btn) btn.disabled = true;
        try {
            if (!window.NadufmExport) {
                throw new Error('ডকুমেন্ট এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            }
            await window.NadufmExport.exportElementToA4Pdf({
                element: container,
                filename,
                marginMm: 0,
                onStatus: (msg, isErr) => {
                    setDocExportStatus(msg, isErr);
                    showToast(msg, isErr);
                },
            });
        } catch (err) {
            const msg = err?.message || 'PDF তৈরি করতে সমস্যা হয়েছে।';
            setDocExportStatus(msg, true);
            showToast(msg, true);
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function downloadA4Word() {
        const container = document.getElementById('a4PagesContainer');
        const btn = document.getElementById('btnDownloadA4Word');
        if (!container) return;
        const style = getDocStyle();
        const docType = document.getElementById('docTypeSelect').value;
        const filename = `${docType}-a4-${Date.now()}.doc`;
        const cssText = `
            @page Section1 {
                size: 210mm 297mm;
                margin: ${style.mTop}mm ${style.mRight}mm ${style.mBottom}mm ${style.mLeft}mm;
            }
            div.Section1 {
                page: Section1;
                font-family: "Nikosh", "Kalpurush", Arial, sans-serif;
                font-size: ${style.fontSize}px;
                color: #0f172a;
            }
            .a4-frame { border: 2px solid #166534; padding: 14px 18px; }
            .cert-frame { border: 3px double #14532d; padding: 20px 24px; }
            .a4-inst-header { border-bottom: 2px solid #166534; padding-bottom: 8px; margin-bottom: 12px; text-align: center; }
            .a4-doc-badge { text-align: center; font-size: 1.18em; font-weight: bold; color: #14532d; text-decoration: underline; margin: 12px 0; }
            .a4-memo-row { display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 12px; }
            .a4-body-text { line-height: 1.85; text-align: justify; }
            table.a4-ms-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
            table.a4-ms-table th, table.a4-ms-table td { border: 1px solid #166534; padding: 6px; text-align: center; }
            table.a4-ms-table th { background-color: #166534; color: #ffffff; }
            .a4-summary-grid { border: 1px solid #166534; padding: 8px; margin-top: 12px; font-weight: bold; }
            .a4-sign-row { margin-top: 40px; text-align: center; }
        `;
        if (btn) btn.disabled = true;
        try {
            if (!window.NadufmExport) {
                throw new Error('ডকুমেন্ট এক্সপোর্ট স্ক্রিপ্ট লোড হয়নি।');
            }
            await window.NadufmExport.exportElementToWord({
                element: container,
                filename,
                title: docType,
                cssText,
                onStatus: (msg, isErr) => {
                    setDocExportStatus(msg, isErr);
                    showToast(msg, isErr);
                },
            });
        } catch (err) {
            const msg = err?.message || 'Word ফাইল তৈরি করতে সমস্যা হয়েছে।';
            setDocExportStatus(msg, true);
            showToast(msg, true);
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    function renderAll() {
        renderStudentsSection();
        renderResultsSection();
        renderDocumentsSection();
        populateDocRecordPicker();
    }

    initDropZones();
    document.getElementById('docDateText').value = bnNum(new Date().toISOString().slice(0, 10));
    renderAll();
    const initialTab = <%- JSON.stringify(initialTab || 'students') %>;
    if (initialTab && initialTab !== 'students' && typeof switchTab === 'function') {
        switchTab(initialTab);
    }

    async function hydrateOfflineExcelState() {
        if (!window.NadufmOffline) return;
        const queue = await window.NadufmOffline.getQueue();
        const hasPendingExcel = queue.some(q => q.url && q.url.indexOf('/api/excel/') !== -1);
        if (!navigator.onLine || hasPendingExcel) {
            const saved = await window.NadufmOffline.getSnapshot('excelState');
            if (saved) {
                applyState(saved);
            }
        } else {
            persistLocalExcelState();
        }
    }

    window.addEventListener('nadufm:sync-status', function (ev) {
        if (ev && ev.detail && ev.detail.type === 'BOOTSTRAP_REFRESHED') {
            hydrateOfflineExcelState();
        }
    });

    hydrateOfflineExcelState();
</script>
<script src="/pwa.js" defer></script>
</body>
</html>
