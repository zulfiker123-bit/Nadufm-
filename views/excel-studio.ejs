    // ============ EXPORT EXCEL ============
    async function exportSheetExcel(type) {
        const sheet = state[type];
        const headers = sheet.columns.map((c) => c.label);
        const rows = sheet.rows.map((r) => sheet.columns.map((c) => r[c.key] ?? ''));
        await downloadExportedXlsx(headers, rows, `${type}-export.xlsx`, type);
    }

    async function exportComputedResultsExcel() {
        const exam = getActiveExam();
        const computed = recomputeExamClient(exam);
        const headers = [...exam.columns.map((c) => c.label), 'মোট প্রাপ্ত নম্বর', 'পূর্ণমান', 'শতকরা (%)', 'GPA', 'ফেল বিষয়', 'মেধাক্রম', 'ফলাফল'];
        const rows = computed.meritList.map((m) => [
            ...exam.columns.map((c) => m.raw[c.key] ?? ''),
            m.totalObtained,
            m.totalFullMarks,
            m.percentage,
            m.gpa.toFixed(2),
            m.failCount,
            m.meritRank ?? '',
            m.statusBn,
        ]);
        await downloadExportedXlsx(headers, rows, `${exam.id}-gpa-merit.xlsx`, 'Result_Merit');
    }

    async function downloadExportedXlsx(headers, rows, filename, sheetName) {
        try {
            if (window.NadufmExport && typeof window.NadufmExport.postDownloadForm === 'function') {
                window.NadufmExport.postDownloadForm('/api/excel/export', {
                    payload: JSON.stringify({ headers, rows, filename, sheetName }),
                });
                showToast('Excel ফাইল ডাউনলোড শুরু হয়েছে।');
                return;
            }
            const res = await fetch('/api/excel/export', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ headers, rows, filename, sheetName }),
            });
            if (!res.ok) throw new Error('এক্সপোর্ট ব্যর্থ হয়েছে');
            const blob = await res.blob();
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            setTimeout(() => {
                if (a.parentNode) a.parentNode.removeChild(a);
                URL.revokeObjectURL(url);
            }, 30000);
        } catch (err) {
            showToast(err.message || 'এক্সপোর্ট ব্যর্থ হয়েছে', true);
        }
    }

    // ============ TAB 4: A4 DOCUMENT STUDIO ============
    function getMappedField(row, mapping, candidateKeys) {
        for (const mk of candidateKeys) {
            const colKey = mapping?.[mk];
            if (colKey && row[colKey] !== undefined && String(row[colKey]).trim() !== '') {
                return String(row[colKey]).trim();
            }
        }
        return '';
    }

    function normalizeRollClient(v) {
        return enNum(String(v ?? '').trim()).replace(/^0+(?=\d)/, '').toLowerCase();
    }

    function normalizeClassClient(v) {
        return enNum(String(v ?? '').replace(/শ্রেণি|শ্রেণী|class/gi, '').replace(/\s+/g, ' ').trim()).toLowerCase();
    }

    function findMatchedStudentRow(clsName, rollVal) {
        const sheet = state.students || { rows: [], mapping: {} };
        const m = sheet.mapping || {};
        const rNorm = normalizeRollClient(rollVal);
        const cNorm = normalizeClassClient(clsName);
        if (!rNorm) return null;
        return (sheet.rows || []).find((row) => {
            const rl = normalizeRollClient(getMappedField(row, m, ['roll', 'id']));
            if (rl !== rNorm) return false;
            if (!cNorm) return true;
            const cl = normalizeClassClient(getMappedField(row, m, ['class_name']));
            return !cl || cl === cNorm || cl.includes(cNorm) || cNorm.includes(cl);
        }) || null;
    }

    function findMatchedExamResult(clsName, rollVal) {
        const rNorm = normalizeRollClient(rollVal);
        const cNorm = normalizeClassClient(clsName);
        if (!rNorm) return null;
        const exams = Object.values(state.results?.exams || {});
        for (const exam of exams) {
            if (!Array.isArray(exam.rows) || exam.rows.length === 0) continue;
            const exCls = normalizeClassClient(exam.className || (state.classMap?.[exam.classId]?.name || ''));
            if (cNorm && exCls && exCls !== cNorm && !exCls.includes(cNorm) && !cNorm.includes(exCls)) continue;
            const computed = recomputeExamClient(exam);
            const ev = computed.evaluatedRows.find((r) => normalizeRollClient(r.roll) === rNorm);
            if (ev) return { exam, ev };
        }
        return null;
    }

    function openInDocStudio(source, rowIndex, docType) {
        switchTab('docstudio');
        document.getElementById('docTypeSelect').value = docType;
        document.getElementById('docBatchMode').value = 'single';
        document.getElementById('docSourceSelect').value = source;
        const clsFilterEl = document.getElementById('docClassFilter');
        if (clsFilterEl) clsFilterEl.value = '';
        populateDocRecordPicker();
        document.getElementById('docRecordSelect').value = String(rowIndex);
        loadSelectedRecordIntoForm();
        onDocConfigChange();
    }

    function openBatchMarksheets() {
        const exam = getActiveExam();
        if (!exam.rows || exam.rows.length === 0) {
            showToast('প্রথমে রেজাল্ট শিটে শিক্ষার্থী আপলোড বা যোগ করুন।', true);
            return;
        }
        switchTab('docstudio');
        document.getElementById('docTypeSelect').value = 'marksheet';
        document.getElementById('docBatchMode').value = 'batch';
        document.getElementById('docSourceSelect').value = 'results';
        populateDocRecordPicker();
        onDocConfigChange();
    }

    function onDocConfigChange() {
        const docType = document.getElementById('docTypeSelect').value;
        const batchWrap = document.getElementById('batchToggleWrap');
        const singleWrap = document.getElementById('singleRecordWrap');
        if (docType === 'marksheet' || docType === 'admit' || docType === 'idcard') {
            batchWrap.classList.remove('hidden');
            const isBatch = document.getElementById('docBatchMode').value === 'batch';
            singleWrap.classList.toggle('hidden', isBatch);
        } else {
            batchWrap.classList.add('hidden');
            document.getElementById('docBatchMode').value = 'single';
            singleWrap.classList.remove('hidden');
        }
        renderA4Document();
    }

    function populateDocClassFilter() {
        const source = document.getElementById('docSourceSelect').value;
        const clsSelect = document.getElementById('docClassFilter');
        if (!clsSelect) return;
        const prev = clsSelect.value;
        const classSet = new Set();

        if (source === 'results') {
            const exam = getActiveExam();
            if (exam?.className) classSet.add(exam.className);
        } else {
            const sheet = state[source] || { rows: [], mapping: {} };
            const m = sheet.mapping || {};
            (sheet.rows || []).forEach((r) => {
                const cl = getMappedField(r, m, ['class_name']);
                if (cl) classSet.add(cl);
            });
        }

        clsSelect.innerHTML = '<option value="">-- সকল শ্রেণি --</option>' +
            Array.from(classSet).map((c) => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
        if (prev && classSet.has(prev)) clsSelect.value = prev;
    }

    function onDocClassFilterChange() {
        populateDocRecordPicker(true);
    }

    function jumpToDocRoll(rawRoll) {
        const target = normalizeRollClient(rawRoll);
        if (!target) return;
        const select = document.getElementById('docRecordSelect');
        const opts = Array.from(select.options);
        const foundOpt = opts.find((o) => {
            const r = normalizeRollClient(o.getAttribute('data-roll') || '');
            return r === target || o.textContent.toLowerCase().includes(rawRoll.trim().toLowerCase());
        });
        if (foundOpt && foundOpt.value !== '') {
            select.value = foundOpt.value;
            loadSelectedRecordIntoForm();
        }
    }

    function populateDocRecordPicker(preserveClassFilter) {
        if (!preserveClassFilter) {
            populateDocClassFilter();
        }
        const source = document.getElementById('docSourceSelect').value;
        const select = document.getElementById('docRecordSelect');
        const filterCls = normalizeClassClient(document.getElementById('docClassFilter')?.value || '');

        if (source === 'results') {
            const exam = getActiveExam();
            const computed = recomputeExamClient(exam);
            const exCls = normalizeClassClient(exam.className || '');
            const filtered = computed.evaluatedRows
                .map((r, i) => ({ r, i }))
                .filter(() => !filterCls || !exCls || exCls === filterCls);
            select.innerHTML = filtered.length
                ? filtered.map(({ r, i }) => `<option value="${i}" data-roll="${esc(r.roll)}">রোল ${bnNum(r.roll)} - ${esc(r.name || 'নাম নেই')}</option>`).join('')
                : '<option value="">-- কোনো শিক্ষার্থী নেই --</option>';
        } else {
            const sheet = state[source];
            const m = sheet.mapping || {};
            const filtered = sheet.rows
                .map((r, i) => ({ r, i }))
                .filter(({ r }) => {
                    if (!filterCls) return true;
                    const cl = normalizeClassClient(getMappedField(r, m, ['class_name']));
                    return cl === filterCls;
                });
            select.innerHTML = filtered.length
                ? filtered.map(({ r, i }) => {
                    const nm = getMappedField(r, m, ['name_bn', 'name_en']) || Object.values(r).find((v) => v && !String(v).startsWith('row_')) || `সারি ${i + 1}`;
                    const rl = getMappedField(r, m, ['roll', 'id']);
                    const cl = getMappedField(r, m, ['class_name']);
                    return `<option value="${i}" data-roll="${esc(rl)}">${rl ? 'রোল ' + bnNum(rl) + ' - ' : ''}${esc(nm)}${cl ? ' (' + esc(cl) + ')' : ''}</option>`;
                }).join('')
                : '<option value="">-- কোনো তথ্য নেই --</option>';
        }
        loadSelectedRecordIntoForm();
    }

    function loadSelectedRecordIntoForm() {
        const source = document.getElementById('docSourceSelect').value;
        const idx = parseInt(document.getElementById('docRecordSelect').value, 10);
        if (Number.isNaN(idx)) {
            renderA4Document();
            return;
        }

        if (source === 'results') {
            const exam = getActiveExam();
            const computed = recomputeExamClient(exam);
            const ev = computed.evaluatedRows[idx];
            if (!ev) return;
            const stuRow = findMatchedStudentRow(exam.className || '', ev.roll);
            const sm = state.students?.mapping || {};
            document.getElementById('fName').value = ev.name || (stuRow ? getMappedField(stuRow, sm, ['name_bn', 'name_en']) : '') || '';
            document.getElementById('fRoll').value = ev.roll || '';
            document.getElementById('fFather').value = ev.father || (stuRow ? getMappedField(stuRow, sm, ['father_bn']) : '') || '';
            document.getElementById('fMother').value = stuRow ? getMappedField(stuRow, sm, ['mother_bn']) : '';
            document.getElementById('fClass').value = exam.className || (stuRow ? getMappedField(stuRow, sm, ['class_name']) : '') || '';
            document.getElementById('fSession').value = exam.year || '২০২৬';
            if (stuRow) {
                document.getElementById('fDob').value = getMappedField(stuRow, sm, ['dob']);
                document.getElementById('fReg').value = getMappedField(stuRow, sm, ['reg_no', 'id']);
                document.getElementById('fAddress').value = getMappedField(stuRow, sm, ['address']);
            }
            document.getElementById('fGpa').value = ev.gpa ? ev.gpa.toFixed(2) : ev.statusBn;
        } else {
            const sheet = state[source];
            const row = sheet.rows[idx];
            if (!row) return;
            const m = sheet.mapping || {};
            const clsVal = getMappedField(row, m, ['class_name']);
            const rollVal = getMappedField(row, m, ['roll', 'id']);
            const matchedRes = findMatchedExamResult(clsVal, rollVal);

            document.getElementById('fName').value = getMappedField(row, m, ['name_bn', 'name_en']);
            document.getElementById('fRoll').value = rollVal;
            document.getElementById('fFather').value = getMappedField(row, m, ['father_bn']) || (matchedRes?.ev?.father || '');
            document.getElementById('fMother').value = getMappedField(row, m, ['mother_bn']);
            document.getElementById('fClass').value = clsVal;
            document.getElementById('fSession').value = getMappedField(row, m, ['session']) || '২০২৫-২০২৬';
            document.getElementById('fDob').value = getMappedField(row, m, ['dob']);
            document.getElementById('fReg').value = getMappedField(row, m, ['reg_no', 'id']);
            document.getElementById('fGpa').value = getMappedField(row, m, ['gpa']) || (matchedRes?.ev ? matchedRes.ev.gpa.toFixed(2) : '');
            document.getElementById('fAddress').value = getMappedField(row, m, ['address']);
            const rem = getMappedField(row, m, ['remark']);
            if (rem) document.getElementById('fRemark').value = rem;
        }
        renderA4Document();
    }

