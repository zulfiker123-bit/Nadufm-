    function switchActiveExam(examId) {
        state.results.activeExamId = examId;
        renderResultsSection();
    }

    function updateExamMeta() {
        const exam = getActiveExam();
        const cid = document.getElementById('examClassId').value;
        exam.classId = cid;
        if (state.classMap && state.classMap[cid]) {
            exam.className = state.classMap[cid].name;
        }
