    function renderSimpleTable(type, searchInputId, containerId, countId) {
        const sheet = state[type];
        const q = String(document.getElementById(searchInputId)?.value || '').trim().toLowerCase();
        document.getElementById(countId).textContent = bnNum(sheet.rows.length);
        const container = document.getElementById(containerId);

        if (sheet.rows.length === 0) {
            container.innerHTML = `<div class="empty-state"><i class="fas fa-table"></i><p>এখনো কোনো সারি নেই। উপরে Excel আপলোড করুন অথবা <strong>নতুন সারি</strong> বাটনে ক্লিক করুন।</p></div>`;
            return;
        }

        const indexedRows = sheet.rows
            .map((r, i) => ({ r, i }))
            .filter(({ r }) => !q || sheet.columns.some((c) => String(r[c.key] || '').toLowerCase().includes(q)));

        container.innerHTML = `
            <div class="table-wrap">
                <table class="sheet-table">
                    <thead>
                        <tr>
                            <th style="width:46px;">নং</th>
                            ${sheet.columns.map((c) => `<th>${esc(c.label)}</th>`).join('')}
                            <th style="width:${type === 'students' ? '290px' : '175px'};">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${indexedRows.map(({ r, i }, sl) => `
                            <tr>
                                <td>${bnNum(sl + 1)}</td>
                                ${sheet.columns.map((c) => `
                                    <td><input class="cell-input" value="${esc(r[c.key] ?? '')}" onchange="updateSimpleCell('${type}', ${i}, '${esc(c.key)}', this.value)"></td>
                                `).join('')}
                                <td style="white-space:nowrap;">
                                    ${type === 'students' ? `
                                        <button type="button" class="btn btn-outline btn-sm" onclick="openInDocStudio('students', ${i}, 'admit')" title="এডমিট কার্ড">এডমিট</button>
                                        <button type="button" class="btn btn-outline btn-sm" onclick="openInDocStudio('students', ${i}, 'marksheet')" title="মার্কশিট">মার্কশিট</button>
                                        <button type="button" class="btn btn-outline btn-sm" onclick="openInDocStudio('students', ${i}, 'idcard')" title="আইডি কার্ড">আইডি</button>
                                    ` : ''}
                                    <button type="button" class="btn btn-outline btn-sm" onclick="openInDocStudio('${type}', ${i}, 'attestation')" title="প্রত্যায়ন পত্র">প্রত্যায়ন</button>
                                    <button type="button" class="btn btn-outline btn-sm" onclick="openInDocStudio('${type}', ${i}, 'testimonial')" title="প্রশংসা পত্র">প্রশংসা</button>
                                    <button type="button" class="btn btn-danger-outline btn-sm" onclick="deleteSimpleRow('${type}', ${i})" title="মুছুন"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
            </div>
        `;
    }

