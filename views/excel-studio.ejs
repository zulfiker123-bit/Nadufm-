                    <button type="button" id="documentsSaveBtnBottom" class="btn btn-primary btn-sm" onclick="saveDocumentsSheet()"><i class="fas fa-save" aria-hidden="true"></i> সংরক্ষণ করুন</button>
                </div>
            </div>

            <div class="class-filter-wrap">
                <div class="class-filter-bar" id="documentsClassBar" role="tablist" aria-label="শ্রেণি অনুযায়ী ডকুমেন্ট ফিল্টার"></div>
