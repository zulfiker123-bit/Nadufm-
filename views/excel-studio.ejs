    function formatSubjectColLabelClient(baseTitle, fullMarks, isOptional) {
        const clean = String(baseTitle || '').trim();
        if (!clean) return '';
        const fm = Number(fullMarks) > 0 ? Number(fullMarks) : 100;
        return `${clean} (${fm})${isOptional ? ' (4th)' : ''}`;
    }

    let pendingThFocusTarget = null;

    function trackResultHeadPointer(event) {
        const el = event.target && event.target.closest ? event.target.closest('[data-th-col][data-th-field]') : null;
        if (el && el.dataset) {
            pendingThFocusTarget = { colIdx: el.dataset.thCol, field: el.dataset.thField };
        } else {
            pendingThFocusTarget = null;
        }
    }

    function getActiveTableHeadFocus() {
        if (pendingThFocusTarget) {
            return pendingThFocusTarget;
        }
        const activeEl = document.activeElement;
        if (activeEl && activeEl.dataset && activeEl.dataset.thCol !== undefined && activeEl.dataset.thField) {
            return { colIdx: activeEl.dataset.thCol, field: activeEl.dataset.thField };
        }
        return null;
    }

    function syncResultColumnUpdate(nextFocus) {
        const focusToRestore = pendingThFocusTarget || nextFocus;
        pendingThFocusTarget = null;
        markDirty('results', true);
        renderClassResultUploadGrid();
        renderResultSubjectsAndMapping();
        renderResultsTableAndStats();
        if (focusToRestore) {
            const target = document.querySelector(`#resultsTableContainer [data-th-col="${focusToRestore.colIdx}"][data-th-field="${focusToRestore.field}"]`);
            if (target) target.focus();
        }
    }

    function applyColLabelMut(col, rawVal) {
        if (!col) return false;
        const trimmed = String(rawVal ?? '').trim();
        if (!trimmed) return false;
        if (!col.isSubject) {
            col.label = trimmed;
        } else {
            const fmMatch = enNum(trimmed).match(/\((\d+(?:\.\d+)?)\)/);
            if (fmMatch) {
                const parsedFm = parseFloat(fmMatch[1]);
                if (parsedFm >= 5 && parsedFm <= 500) col.fullMarks = parsedFm;
            }
            if (/\(\s*(?:4th|৪র্থ|ঐচ্ছিক|optional|opt|অতিরিক্ত|extra)\s*\)/i.test(trimmed)) {
                col.isOptional = true;
            }
            const baseTitle = trimmed.replace(/\s*\([^)]*\)/g, '').trim() || cleanSubTitle(col.label) || trimmed;
            col.fullMarks = Number(col.fullMarks) > 0 ? Number(col.fullMarks) : 100;
            col.label = formatSubjectColLabelClient(baseTitle, col.fullMarks, col.isOptional);
        }
        return true;
    }

    function applyColFmMut(col, val) {
        if (!col) return;
        const parsed = parseFloat(enNum(String(val ?? '')));
        const fm = (!Number.isNaN(parsed) && parsed >= 5 && parsed <= 500) ? parsed : 100;
        col.fullMarks = fm;
        if (col.isSubject) {
            const baseTitle = String(col.label || '').replace(/\s*\([^)]*\)/g, '').trim() || cleanSubTitle(col.label) || col.label;
            col.label = formatSubjectColLabelClient(baseTitle, fm, col.isOptional);
        }
    }

    function preserveThChipClick(e) {
        const ae = document.activeElement;
        if (ae && ae.dataset && ae.dataset.thCol !== undefined && ae.dataset.thField) {
            e.preventDefault();
        }
    }

    function flushPendingThInput() {
        const ae = document.activeElement;
        if (!ae || !ae.dataset || ae.dataset.thCol === undefined || !ae.dataset.thField) return;
        const exam = getActiveExam();
        const cIdx = Number(ae.dataset.thCol);
        const col = exam?.columns?.[cIdx];
        if (!col) return;
        if (ae.dataset.thField === 'label') {
            applyColLabelMut(col, ae.value);
        } else if (ae.dataset.thField === 'fm') {
            applyColFmMut(col, ae.value);
        }
        ae.dataset.flushed = '1';
    }

    function updateResultColLabel(idx, rawVal, el) {
        if (el && el.dataset && el.dataset.flushed === '1') {
            delete el.dataset.flushed;
            return;
        }
        const exam = getActiveExam();
        const col = exam.columns[idx];
        if (!col) return;
        const nextFocus = getActiveTableHeadFocus();
        if (!applyColLabelMut(col, rawVal)) {
            renderResultSubjectsAndMapping();
            renderResultsTableAndStats();
            return;
        }
        syncResultColumnUpdate(nextFocus);
    }

    function updateResultColFM(idx, val, el) {
        if (el && el.dataset && el.dataset.flushed === '1') {
            delete el.dataset.flushed;
            return;
        }
        const exam = getActiveExam();
        const col = exam.columns[idx];
        if (!col) return;
        const nextFocus = getActiveTableHeadFocus();
        applyColFmMut(col, val);
        syncResultColumnUpdate(nextFocus);
    }

    function toggleResultColOptional(idx, checked) {
        flushPendingThInput();
        const exam = getActiveExam();
        const col = exam.columns[idx];
        if (!col) return;
        const nextFocus = getActiveTableHeadFocus();
        col.isOptional = Boolean(checked);
        if (col.isSubject) {
            const baseTitle = String(col.label || '').replace(/\s*\([^)]*\)/g, '').trim() || cleanSubTitle(col.label) || col.label;
            col.label = formatSubjectColLabelClient(baseTitle, col.fullMarks, col.isOptional);
        }
        syncResultColumnUpdate(nextFocus);
    }

    function toggleResultColSubject(idx) {
        flushPendingThInput();
        const exam = getActiveExam();
        const col = exam.columns[idx];
        if (!col) return;
        col.isSubject = !col.isSubject;
        if (col.isSubject) {
            const matchFm = enNum(String(col.label || '')).match(/\((\d+(?:\.\d+)?)\)/);
            const fallbackFm = matchFm ? parseFloat(matchFm[1]) : 100;
            col.fullMarks = Number(col.fullMarks) > 0 ? Number(col.fullMarks) : (fallbackFm >= 5 && fallbackFm <= 500 ? fallbackFm : 100);
            const baseTitle = String(col.label || '').replace(/\s*\([^)]*\)/g, '').trim() || col.label;
            col.label = formatSubjectColLabelClient(baseTitle, col.fullMarks, col.isOptional);
            if (exam.mapping) {
                Object.keys(exam.mapping).forEach((mk) => {
                    if (exam.mapping[mk] === col.key) exam.mapping[mk] = '';
                });
            }
        } else {
            col.fullMarks = 0;
            col.isOptional = false;
            col.label = cleanSubTitle(col.label) || col.label;
        }
        syncResultColumnUpdate(null);
    }

    function updateResultMapping(fieldKey, colKey) {
        const exam = getActiveExam();
        if (!exam.mapping) exam.mapping = {};
        exam.mapping[fieldKey] = colKey;
        markDirty('results', true);
        renderResultsTableAndStats();
    }

