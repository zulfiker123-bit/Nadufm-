                        </div>
                        <div class="btn-group">
                            <% if (hideTabs && initialTab !== 'docstudio') { %>
                                <button type="button" class="btn btn-outline btn-sm" onclick="switchTab(initialTab)"><i class="fas fa-arrow-left" aria-hidden="true"></i> শিটে ফিরুন</button>
