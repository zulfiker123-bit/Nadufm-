    function renderResultColumns() {
        const exam = getActiveExam();
        const colListEl = document.getElementById('resultsColList');
        const mapGridEl = document.getElementById('resultsMappingGrid');

        colListEl.innerHTML = exam.columns.map((col, idx) => `
            <div class="col-chip">
                <div class="col-chip-top">
                    <input type="text" value="${esc(col.label)}" onchange="renameResultColumn(${idx}, this.value)">
                    <button type="button" class="btn btn-danger-outline btn-sm" onclick="removeResultColumn(${idx})" title="কলাম মুছুন"><i class="fas fa-times"></i></button>
                </div>
                <div class="col-chip-meta">
                    <label style="display:inline-flex; align-items:center; gap:4px; cursor:pointer;">
                        <input type="checkbox" ${col.isSubject ? 'checked' : ''} onchange="toggleResultColSubject(${idx}, this.checked)">
                        <span>বিষয়</span>
                    </label>
                    ${col.isSubject ? `<label style="display:inline-flex; align-items:center; gap:4px;">পূর্ণমান: <input type="number" min="5" max="500" value="${Number(col.fullMarks) || 100}" onchange="updateResultColFM(${idx}, this.value)"></label>` : '<span>তথ্য কলাম</span>'}
                </div>
            </div>
        `).join('');

        mapGridEl.innerHTML = RESULT_MAP_FIELDS.map((mf) => `
            <div class="field">
                <label>${mf.label}</label>
                <select onchange="updateResultMapping('${mf.key}', this.value)">
                    <option value="">-- নেই --</option>
                    ${exam.columns.map((c) => `<option value="${esc(c.key)}" ${exam.mapping?.[mf.key] === c.key ? 'selected' : ''}>${esc(c.label)}</option>`).join('')}
                </select>
            </div>
        `).join('');
    }

    function addResultColumn() {
        const exam = getActiveExam();
        const labelEl = document.getElementById('newResultColLabel');
        const fmEl = document.getElementById('newResultColFM');
        const typeEl = document.getElementById('newResultColType');
        const rawLabel = String(labelEl.value || '').trim();
        if (!rawLabel) {
            showToast('কলাম বা বিষয়ের নাম লিখুন।', true);
            return;
        }
        const isSubject = typeEl.value === 'subject';
        const fm = isSubject ? (Number(fmEl.value) || 100) : 0;
        const label = isSubject && !/\(\d+\)/.test(rawLabel) ? `${rawLabel} (${fm})` : rawLabel;
        const key = 'col_' + Date.now();
        exam.columns.push({ key, label, isSubject, fullMarks: fm });
        exam.rows.forEach((r) => { r[key] = ''; });
        labelEl.value = '';
        renderResultsSection();
        showToast('নতুন কলাম যোগ করা হয়েছে।');
    }

    function renameResultColumn(idx, val) {
        const exam = getActiveExam();
        exam.columns[idx].label = String(val || '').trim() || `কলাম ${idx + 1}`;
        renderResultsTableAndStats();
    }

    function toggleResultColSubject(idx, checked) {
        const exam = getActiveExam();
        exam.columns[idx].isSubject = checked;
        if (checked && (!exam.columns[idx].fullMarks || exam.columns[idx].fullMarks <= 0)) {
            exam.columns[idx].fullMarks = 100;
        }
        renderResultsSection();
    }

    function updateResultColFM(idx, val) {
        const exam = getActiveExam();
        exam.columns[idx].fullMarks = Number(val) > 0 ? Number(val) : 100;
        renderResultsTableAndStats();
    }

    function removeResultColumn(idx) {
        const exam = getActiveExam();
        if (exam.columns.length <= 1) {
            showToast('অন্তত ১টি কলাম থাকতে হবে।', true);
            return;
        }
        const removed = exam.columns.splice(idx, 1)[0];
        exam.rows.forEach((r) => { delete r[removed.key]; });
        renderResultsSection();
    }

    function updateResultMapping(fieldKey, colKey) {
        const exam = getActiveExam();
        if (!exam.mapping) exam.mapping = {};
        exam.mapping[fieldKey] = colKey;
        renderResultsTableAndStats();
    }

    function addResultRow() {
        const exam = getActiveExam();
        const row = { _id: `r_${Date.now()}` };
        exam.columns.forEach((c) => { row[c.key] = ''; });
        exam.rows.push(row);
        renderResultsTableAndStats();
    }

    function deleteResultRow(rowIndex) {
        const exam = getActiveExam();
        exam.rows.splice(rowIndex, 1);
        renderResultsTableAndStats();
    }

    function updateResultCell(rowIndex, colKey, val) {
        const exam = getActiveExam();
        exam.rows[rowIndex][colKey] = val;
        renderResultsTableAndStats();
    }

