<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="icon" href="/pwa-192x192.png" type="image/png" sizes="192x192">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#14532d">
    <link rel="stylesheet" href="/fonts.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="/vendor/html2pdf.bundle.min.js" defer></script>
    <script src="/doc-export.js" defer></script>
    <style>
        :root {
            --brand: #14532d;
            --brand-dark: #14532d;
            --brand-strong: #15803d;
            --brand-tint: #f0fdf4;
            --bg: #f6f8f7;
            --surface: #ffffff;
            --surface-subtle: #f8faf9;
            --border: rgba(15, 23, 42, 0.09);
            --border-strong: rgba(15, 23, 42, 0.16);
            --text: #0f172a;
            --muted: #475569;
            --danger: #b91c1c;
            --amber: #b45309;
            --blue: #1d4ed8;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Kalpurush', sans-serif;
            background: var(--bg);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }

        button, input, select, textarea {
            font-family: inherit;
        }

        :focus-visible {
            outline: 2px solid var(--brand-strong);
            outline-offset: 2px;
        }

        .studio-topbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .studio-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .studio-brand img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--border);
        }

        .studio-brand h1 {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand);
            line-height: 1.2;
        }

        .studio-brand p {
            margin: 0;
            font-size: 0.78rem;
            color: var(--muted);
        }

        .studio-top-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .studio-container {
            max-width: 1360px;
            margin: 16px auto 40px auto;
            padding: 0 18px;
        }

        .studio-tabs {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            background: var(--surface);
            padding: 6px;
            border: 1px solid var(--border);
            border-radius: 12px;
            margin-bottom: 16px;
        }

        .studio-tab {
            flex: 1 1 180px;
            min-height: 42px;
            border: none;
            border-radius: 8px;
            background: transparent;
            color: var(--muted);
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 6px 14px;
            white-space: nowrap;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        .studio-tab:hover {
            background: #f1f5f9;
            color: var(--text);
        }

        .studio-tab.active {
            background: var(--brand);
            color: #ffffff;
        }

        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* Flat single-elevation surfaces */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 14px;
        }

        .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .card-title {
            margin: 0;
            font-size: 1.04rem;
            font-weight: 700;
            color: var(--brand);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-sub {
            margin: 2px 0 0 0;
            font-size: 0.84rem;
            color: var(--muted);
        }

        .dirty-note {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--amber);
            display: none;
            align-items: center;
            gap: 5px;
        }

        .dirty-note.show {
            display: inline-flex;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 40px;
            padding: 0 14px;
            border-radius: 9px;
            border: 1px solid transparent;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            white-space: nowrap;
            flex-shrink: 0;
            transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
        }

        .btn:active { transform: scale(0.985); }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-sm { min-height: 36px; padding: 0 11px; font-size: 0.82rem; border-radius: 8px; }
        .btn-primary { background: var(--brand-strong); color: #ffffff; }
        .btn-primary:hover { background: var(--brand); }
        .btn-dark { background: #1e293b; color: #ffffff; }
        .btn-dark:hover { background: #0f172a; }
        .btn-blue { background: var(--blue); color: #ffffff; }
        .btn-blue:hover { background: #1e40af; }
        .btn-rose { background: #be123c; color: #ffffff; }
        .btn-rose:hover { background: #9f1239; }
        .btn-amber { background: #d97706; color: #ffffff; }
        .btn-amber:hover { background: #b45309; }
        .btn-outline { background: var(--surface); color: var(--text); border-color: var(--border-strong); }
        .btn-outline:hover { background: var(--surface-subtle); }
        .btn-danger-outline { background: var(--surface); color: var(--danger); border-color: #fecaca; }
        .btn-danger-outline:hover { background: #fef2f2; }

        .btn-group {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
        .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 12px; }

        .field label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .field input[type="text"],
        .field input[type="number"],
        .field input[type="date"],
        .field input[type="search"],
        .field select,
        .field textarea {
            width: 100%;
            min-height: 40px;
            padding: 7px 11px;
            border: 1px solid var(--border-strong);
            border-radius: 9px;
            font-size: 0.9rem;
            background: var(--surface-subtle);
            color: var(--text);
            outline: none;
        }

        .field input:focus,
        .field select:focus,
        .field textarea:focus {
            border-color: var(--brand-strong);
            background: var(--surface);
        }

        /* Clean Dropzone Upload Area */
        .upload-zone {
            border: 1.5px dashed rgba(21, 128, 61, 0.42);
            background: #f9fcf9;
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        .upload-zone.is-dragover {
            background: #ecfdf3;
            border-color: var(--brand-strong);
        }

        .upload-zone-info {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .upload-zone-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #dcfce7;
            color: var(--brand);
            display: grid;
            place-items: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .upload-file-input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .upload-status-box {
            display: none;
            margin-top: 10px;
            padding: 10px 13px;
            border-radius: 9px;
            font-size: 0.87rem;
            font-weight: 600;
        }

        /* Class-wise Segmented Filter Bar */
        .class-filter-wrap {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            padding: 10px 0 12px 0;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .class-filter-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            font-variant-numeric: tabular-nums;
        }

        .class-filter-label {
            font-size: 0.84rem;
            font-weight: 700;
            color: var(--muted);
            margin-right: 4px;
            white-space: nowrap;
        }

        .class-seg-btn {
            min-height: 36px;
            padding: 0 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface-subtle);
            color: var(--text);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }

        .class-seg-btn:hover {
            background: var(--brand-tint);
            border-color: rgba(21, 128, 61, 0.35);
            color: var(--brand-dark);
        }

        .class-seg-btn.active {
            background: var(--brand-strong);
            border-color: var(--brand-strong);
            color: #ffffff;
        }

        .search-toolbar-input {
            height: 38px;
            padding: 0 12px;
            border: 1px solid var(--border-strong);
            border-radius: 9px;
            background: var(--surface-subtle);
            color: var(--text);
            font-size: 0.88rem;
            min-width: 220px;
            outline: none;
        }

        .search-toolbar-input:focus {
            border-color: var(--brand-strong);
            background: var(--surface);
        }

        /* Collapsible Advanced Mapping / Subject Full-marks (no add-column option) */
        .adv-details {
            margin-top: 12px;
            border-top: 1px solid var(--border);
            padding-top: 10px;
        }

        .adv-details summary {
            cursor: pointer;
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--muted);
            user-select: none;
            list-style: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 4px 0;
        }

        .adv-details summary::-webkit-details-marker { display: none; }
        .adv-details summary:hover { color: var(--brand); }
        .adv-details[open] summary { color: var(--brand); margin-bottom: 12px; }

        .subject-marks-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 10px;
            margin-bottom: 12px;
        }

        .subject-mark-item {
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 9px 11px;
            background: var(--surface-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .subject-mark-item span {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .subject-mark-item input[type="number"] {
            width: 68px;
            height: 32px;
            padding: 2px 6px;
            border: 1px solid var(--border-strong);
            border-radius: 6px;
            text-align: center;
            font-size: 0.84rem;
            background: var(--surface);
        }

        /* High-Density Data Table */
        .table-wrap {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--surface);
        }

        table.sheet-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            font-variant-numeric: tabular-nums;
        }

        table.sheet-table th {
            background: #14532d;
            color: #ffffff;
            padding: 10px 8px;
            text-align: center;
            font-weight: 600;
            white-space: nowrap;
            border-right: 1px solid rgba(255, 255, 255, 0.14);
        }

        table.sheet-table td {
            border-bottom: 1px solid rgba(15, 23, 42, 0.07);
            border-right: 1px solid rgba(15, 23, 42, 0.05);
            padding: 4px 6px;
            text-align: center;
            vertical-align: middle;
        }

        table.sheet-table tr:nth-child(even) td { background: #f9fbfa; }
        table.sheet-table tbody tr:hover td { background: #f0fdf4; }

        .cell-input {
            width: 100%;
            min-width: 72px;
            padding: 6px 8px;
            border: 1px solid transparent;
            border-radius: 6px;
            background: transparent;
            font-size: 0.88rem;
            color: var(--text);
            text-align: inherit;
        }

        .cell-input:focus {
            outline: none;
            border-color: var(--brand-strong);
            background: #ffffff;
        }

        /* Stats Strip */
        .stats-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 10px;
            margin-bottom: 14px;
            font-variant-numeric: tabular-nums;
        }

        .stat-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 14px;
        }

        .stat-box-label { font-size: 0.8rem; color: var(--muted); font-weight: 600; }
        .stat-box-val { font-size: 1.35rem; font-weight: 700; color: var(--text); margin-top: 2px; }

        .status-pass { color: #15803d; font-weight: 700; }
        .status-promoted { color: #b45309; font-weight: 700; }
        .status-fail { color: #b91c1c; font-weight: 700; }
        .status-abs { color: #64748b; font-weight: 600; }

        /* Per-Class Result Upload Grid */
        .class-upload-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 10px;
            margin-bottom: 10px;
        }

        .class-upload-row {
            background: var(--surface-subtle);
            border: 1px solid var(--border);
            border-radius: 11px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            gap: 9px;
            cursor: pointer;
            transition: border-color 0.15s ease, background-color 0.15s ease;
        }

        .class-upload-row:hover {
            border-color: rgba(21, 128, 61, 0.35);
            background: #f4fbf6;
        }

        .class-upload-row.is-selected {
            background: var(--brand-tint);
            border-color: var(--brand-strong);
        }

        .class-upload-row.is-dragover {
            background: #ecfdf3;
            border-color: var(--brand-strong);
            border-style: dashed;
        }

        .class-upload-top {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 8px;
        }

        .class-upload-title {
            font-size: 0.96rem;
            font-weight: 700;
            color: var(--text);
        }

        .class-upload-row.is-selected .class-upload-title {
            color: var(--brand-dark);
        }

        .class-upload-meta {
            font-size: 0.8rem;
            color: var(--muted);
            font-variant-numeric: tabular-nums;
            line-height: 1.35;
        }

        .class-upload-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .stats-section-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 8px;
            font-variant-numeric: tabular-nums;
        }

        .stats-section-title {
            margin: 0;
            font-size: 0.96rem;
            font-weight: 700;
            color: var(--brand);
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .stats-overall-meta {
            font-size: 0.82rem;
            color: var(--muted);
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 36px 20px;
            color: var(--muted);
        }

        .empty-state i {
            font-size: 2rem;
            color: #94a3b8;
            margin-bottom: 10px;
        }

        .toast-banner {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 90;
            background: #0f172a;
            color: #ffffff;
            padding: 12px 18px;
            border-radius: 11px;
            font-size: 0.9rem;
            font-weight: 600;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.22);
            display: none;
            max-width: 380px;
        }

        /* Segmented Control */
        .seg-group {
            display: inline-flex;
            background: #f1f5f9;
            padding: 3px;
            border-radius: 9px;
            gap: 3px;
        }

        .seg-btn {
            min-height: 34px;
            padding: 0 12px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: var(--muted);
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }

        .seg-btn.active {
            background: var(--surface);
            color: var(--brand-dark);
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
        }

        /* Tab 4: A4 Document Studio */
        .doc-studio-grid {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 16px;
            align-items: start;
        }

        @media (max-width: 1060px) {
            .doc-studio-grid {
                grid-template-columns: 1fr;
            }
        }

        .doc-preview-panel {
            background: #cbd5e1;
            border-radius: 14px;
            padding: 18px;
            overflow-x: auto;
        }

        .a4-pages-stack {
            display: flex;
            flex-direction: column;
            gap: 18px;
            align-items: center;
        }

        .a4-page {
            width: 210mm;
            min-height: 297mm;
            background: #ffffff;
            color: #0f172a;
            font-family: 'Nikosh', 'Kalpurush', sans-serif;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
            box-sizing: border-box;
            position: relative;
            display: flex;
            flex-direction: column;
            page-break-after: always;
            break-after: page;
        }

        .a4-page * {
            font-family: 'Nikosh', 'Kalpurush', sans-serif;
        }

        .a4-page:last-child {
            page-break-after: auto;
            break-after: auto;
        }

        .a4-frame {
            border: 2px solid #166534;
            padding: 16px 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .cert-frame {
            border: 3px double #14532d;
            padding: 22px 26px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .a4-inst-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-bottom: 2px solid #166534;
            padding-bottom: 10px;
            margin-bottom: 12px;
        }

        .a4-inst-title {
            text-align: center;
            flex: 1;
        }

        .a4-inst-title h2 {
            margin: 0;
            color: #14532d;
            font-size: 1.38em;
            line-height: 1.25;
        }

        .a4-inst-title p {
            margin: 2px 0;
            font-size: 0.9em;
            color: #334155;
        }

        .a4-doc-badge {
            text-align: center;
            font-size: 1.18em;
            font-weight: 700;
            color: #14532d;
            text-decoration: underline;
            text-underline-offset: 4px;
            margin: 8px 0 14px 0;
        }

        .a4-memo-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.92em;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .a4-body-text {
            line-height: 1.85;
            text-align: justify;
            font-size: 1em;
        }

        .a4-ms-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.92em;
            font-variant-numeric: tabular-nums;
            margin-top: 10px;
        }

        .a4-ms-table th, .a4-ms-table td {
            border: 1px solid #166534;
            padding: 6px 6px;
            text-align: center;
        }

        .a4-ms-table th {
            background: #166534;
            color: #ffffff;
        }

        .a4-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border: 1px solid #166534;
            margin-top: 14px;
            font-weight: 700;
            font-size: 0.92em;
            font-variant-numeric: tabular-nums;
        }

        .a4-summary-grid div {
            padding: 8px 6px;
            text-align: center;
            border-right: 1px solid #166534;
        }

        .a4-summary-grid div:last-child { border-right: none; }

        .a4-sign-row {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            margin-top: 48px;
            font-size: 0.9em;
            font-weight: 700;
            color: #14532d;
        }

        .a4-sign-box {
            text-align: center;
            min-width: 140px;
        }

        .a4-sign-line {
            border-top: 1px solid #14532d;
            padding-top: 5px;
            margin-top: 32px;
        }

        .hidden { display: none !important; }

        @page {
            size: A4 portrait;
            margin: 0;
        }

        @media (max-width: 640px) {
            .studio-container { padding: 0 12px; }
            .card { padding: 14px; }
            .search-toolbar-input { min-width: 100%; }
        }

        @media print {
            .no-print { display: none !important; }
            body { background: #ffffff !important; margin: 0 !important; padding: 0 !important; }
            .studio-container { max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
            .tab-panel { display: none !important; }
