        { key: '12', label: 'আলিম ২য় বর্ষ', aliases: ['12', '১২', 'আলিম ২য়', 'আলিম ২য় বর্ষ', 'আলিম ২য় বর্ষ'] },
        { key: 'fazil_1', label: 'ফাজিল ১ম বর্ষ', aliases: ['ফাজিল ১ম', 'ফাজিল ১ম বর্ষ'] },
        { key: 'fazil_2', label: 'ফাজিল ২য় বর্ষ', aliases: ['ফাজিল ২য়', 'ফাজিল ২য় বর্ষ', 'ফাজিল ২য় বর্ষ'] },
        { key: 'fazil_3', label: 'ফাজিল ৩য় বর্ষ', aliases: ['ফাজিল ৩য়', 'ফাজিল ৩য় বর্ষ', 'ফাজিল ৩য় বর্ষ'] },
    ];

    function normalizeClassClient(v) {
        const cleaned = String(v ?? '').replace(/শ্রেণি|শ্রেণী|class/gi, '').replace(/[()]/g, ' ').replace(/\s+/g, ' ').trim();
        if (!cleaned) return '';
        const low = enNum(cleaned).toLowerCase();
        for (const entry of CLIENT_CLASS_ALIASES) {
            if (entry.aliases.some((a) => enNum(a).toLowerCase() === low || cleaned.toLowerCase() === a.toLowerCase())) {
                return entry.key;
            }
        }
        return low;
    }

    function sanitizePhotoClient(url) {
        const val = String(url || '').trim();
        if (!val) return '/logo.png';
        if ((val.startsWith('/') && !val.startsWith('//')) || /^https?:\/\//i.test(val) || /^data:image\//i.test(val)) {
            return val;
        }
        return '/logo.png';
    }

    let unifiedPoolCache = [];

    function buildUnifiedStudioPool() {
        const byKey = new Map();
        const upsert = (rec) => {
            const clsKey = normalizeClassClient(rec.cls || rec.classId || '');
            const rNorm = normalizeRollClient(rec.roll);
            const idNorm = String(rec.id || rec.reg || '').trim().toLowerCase();
            const key = rNorm ? `${clsKey || 'unknown'}::${rNorm}` : (idNorm ? `id::${idNorm}` : `uniq::${byKey.size}`);
            const item = {
                key,
                clsKey,
                cls: String(rec.cls || (rec.classId && state.classMap?.[rec.classId]?.name) || '').trim(),
                roll: String(rec.roll || '').trim(),
                id: String(rec.id || '').trim(),
                reg: String(rec.reg || rec.id || '').trim(),
                name: String(rec.name || '').trim(),
                father: String(rec.father || '').trim(),
                mother: String(rec.mother || '').trim(),
                dob: String(rec.dob || '').trim(),
                mobile: String(rec.mobile || '').trim(),
                blood: String(rec.blood || '').trim(),
                address: String(rec.address || '').trim(),
                session: String(rec.session || '').trim(),
                gpa: String(rec.gpa || '').trim(),
                remark: String(rec.remark || '').trim(),
                photo: sanitizePhotoClient(rec.photo),
                hasStudentInfo: Boolean(rec.hasStudentInfo),
                hasResultInfo: Boolean(rec.hasResultInfo),
                exam: rec.exam || null,
                ev: rec.ev || null,
            };
            if (!byKey.has(key)) {
                byKey.set(key, item);
                return;
            }
            const cur = byKey.get(key);
            ['cls', 'roll', 'id', 'reg', 'name', 'father', 'mother', 'dob', 'mobile', 'blood', 'address', 'session', 'gpa', 'remark'].forEach((k) => {
                if (!cur[k] && item[k]) cur[k] = item[k];
            });
            if ((!cur.photo || cur.photo === '/logo.png') && item.photo && item.photo !== '/logo.png') {
                cur.photo = item.photo;
            }
            if (item.hasStudentInfo) cur.hasStudentInfo = true;
            if (item.hasResultInfo && !cur.hasResultInfo) {
                cur.hasResultInfo = true;
                cur.exam = item.exam;
                cur.ev = item.ev;
            }
        };

        // 1. Students Excel
        const stu = state.students || { rows: [], mapping: {} };
        const sm = stu.mapping || {};
        (stu.rows || []).forEach((row) => {
            const cls = getMappedField(row, sm, ['class_name']);
            const roll = getMappedField(row, sm, ['roll', 'id']);
            const name = getMappedField(row, sm, ['name_bn', 'name_en']);
            if (!name && !roll) return;
            upsert({
                cls,
                roll,
                id: getMappedField(row, sm, ['id', 'reg_no']),
                reg: getMappedField(row, sm, ['reg_no', 'id']),
                name,
                father: getMappedField(row, sm, ['father_bn']),
                mother: getMappedField(row, sm, ['mother_bn']),
                dob: getMappedField(row, sm, ['dob']),
                mobile: getMappedField(row, sm, ['mobile']),
                blood: getMappedField(row, sm, ['blood']),
                address: getMappedField(row, sm, ['address']),
                session: getMappedField(row, sm, ['session']) || '২০২৫-২০২৬',
                gpa: getMappedField(row, sm, ['gpa']),
                remark: getMappedField(row, sm, ['remark']),
                photo: getMappedField(row, sm, ['photo']) || row.photo || row['ছবি'] || '',
                hasStudentInfo: true,
            });
        });

        // 2. Results Excel (active exam first, then others)
        const activeId = state.results?.activeExamId || '';
        const exams = Object.values(state.results?.exams || {}).slice().sort((a, b) => {
            if (a.id === activeId) return -1;
            if (b.id === activeId) return 1;
            return String(b.updatedAt || '').localeCompare(String(a.updatedAt || ''));
        });
        exams.forEach((exam) => {
            if (!Array.isArray(exam.rows) || exam.rows.length === 0) return;
            const computed = recomputeExamClient(exam);
            const exCls = exam.className || (state.classMap?.[exam.classId]?.name || '');
            computed.evaluatedRows.forEach((ev) => {
                upsert({
                    cls: exCls,
                    classId: exam.classId,
                    roll: ev.roll,
                    id: ev.studentId,
                    reg: ev.studentId,
                    name: ev.name,
                    father: ev.father,
                    session: exam.year || '২০২৬',
                    gpa: ev.gpa ? ev.gpa.toFixed(2) : ev.statusBn,
                    hasResultInfo: true,
                    exam,
                    ev,
                });
            });
        });

        // 3. Legacy Documents Excel (if populated)
        const doc = state.documents || { rows: [], mapping: {} };
        const dm = doc.mapping || {};
        (doc.rows || []).forEach((row) => {
            const cls = getMappedField(row, dm, ['class_name']);
            const roll = getMappedField(row, dm, ['roll', 'id']);
            const name = getMappedField(row, dm, ['name_bn', 'name_en']);
            if (!name && !roll) return;
            upsert({
                cls,
                roll,
                id: getMappedField(row, dm, ['id', 'reg_no']),
                reg: getMappedField(row, dm, ['reg_no', 'id']),
                name,
                father: getMappedField(row, dm, ['father_bn']),
                mother: getMappedField(row, dm, ['mother_bn']),
                dob: getMappedField(row, dm, ['dob']),
                mobile: getMappedField(row, dm, ['mobile']),
                address: getMappedField(row, dm, ['address']),
                session: getMappedField(row, dm, ['session']),
                gpa: getMappedField(row, dm, ['gpa']),
                remark: getMappedField(row, dm, ['remark']),
                hasStudentInfo: true,
            });
        });

        unifiedPoolCache = Array.from(byKey.values()).sort((a, b) => {
            const ca = String(a.cls || '').localeCompare(String(b.cls || ''), 'bn');
            if (ca !== 0) return ca;
            const na = parseInt(enNum(a.roll), 10);
            const nb = parseInt(enNum(b.roll), 10);
            if (!Number.isNaN(na) && !Number.isNaN(nb) && na !== nb) return na - nb;
            return String(a.roll).localeCompare(String(b.roll), 'bn');
        });
        return unifiedPoolCache;
    }

    function openInDocStudio(source, rowIndex, docType) {
        switchTab('docstudio');
        document.getElementById('docTypeSelect').value = docType;
        document.getElementById('docBatchMode').value = 'single';
        const clsFilterEl = document.getElementById('docClassFilter');
        if (clsFilterEl) clsFilterEl.value = '';
        populateDocRecordPicker();

        let targetKey = '';
        if (source === 'results') {
            const exam = getActiveExam();
            const computed = recomputeExamClient(exam);
            const ev = computed.evaluatedRows[rowIndex];
            if (ev) {
                const ck = normalizeClassClient(exam.className || (state.classMap?.[exam.classId]?.name || ''));
                const rk = normalizeRollClient(ev.roll);
                const found = unifiedPoolCache.find((u) => u.clsKey === ck && normalizeRollClient(u.roll) === rk)
                    || unifiedPoolCache.find((u) => normalizeRollClient(u.roll) === rk);
                if (found) targetKey = found.key;
            }
        } else {
            const sheet = state[source];
            const row = sheet?.rows?.[rowIndex];
            if (row) {
                const m = sheet.mapping || {};
                const ck = normalizeClassClient(getMappedField(row, m, ['class_name']));
                const rk = normalizeRollClient(getMappedField(row, m, ['roll', 'id']));
                const found = unifiedPoolCache.find((u) => (!ck || u.clsKey === ck) && normalizeRollClient(u.roll) === rk);
                if (found) targetKey = found.key;
            }
        }

        if (targetKey) {
            document.getElementById('docRecordSelect').value = targetKey;
        }
        loadSelectedRecordIntoForm();
        onDocConfigChange();
    }

    function openBatchMarksheets() {
        const exam = getActiveExam();
        if (!exam.rows || exam.rows.length === 0) {
            showToast('প্রথমে রেজাল্ট শিটে শিক্ষার্থী আপলোড বা যোগ করুন।', true);
            return;
        }
        switchTab('docstudio');
        document.getElementById('docTypeSelect').value = 'marksheet';
        document.getElementById('docBatchMode').value = 'batch';
        populateDocRecordPicker();
        const clsSelect = document.getElementById('docClassFilter');
        const exClsKey = normalizeClassClient(exam.className || (state.classMap?.[exam.classId]?.name || ''));
        if (clsSelect && exClsKey) {
            clsSelect.value = exClsKey;
            populateDocRecordPicker(true);
        }
        onDocConfigChange();
    }

