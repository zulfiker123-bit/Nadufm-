                        <div class="field"><label>ঠিকানা</label><input type="text" id="fAddress" oninput="renderA4Document()"></div>
                    </div>
                    <div class="field" style="margin-top: 10px;">
                        <label>অধ্যক্ষের পদবি / নাম (স্বাক্ষর অংশ)</label>
                        <input type="text" id="fPrincipalLabel" value="অধ্যক্ষ, নলতা আহছানিয়া দারুল উলুম ফাজিল (ডিগ্রী) মাদ্রাসা" oninput="renderA4Document()">
                    </div>
                    <div class="field" style="margin-top: 10px;">
                        <label>অতিরিক্ত মন্তব্য / চরিত্র</label>
                        <input type="text" id="fRemark" value="আমার জানামতে সে একজন উত্তম চরিত্রের অধিকারী এবং মাদ্রাসার নিয়ম-শৃঙ্খলা মেনে চলে।" oninput="renderA4Document()">
                    </div>
