                    <div class="seg-group" id="docQuickSwitcher" role="tablist" aria-label="তাৎক্ষণিক ডকুমেন্ট পরিবর্তন">
                        <button type="button" class="seg-btn active" data-doc-switch="marksheet" onclick="quickSwitchDocType('marksheet')">মার্কশিট</button>
                        <button type="button" class="seg-btn" data-doc-switch="idcard" onclick="quickSwitchDocType('idcard')">আইডি কার্ড</button>
                        <button type="button" class="seg-btn" data-doc-switch="attestation" onclick="quickSwitchDocType('attestation')">প্রত্যায়ন পত্র</button>
