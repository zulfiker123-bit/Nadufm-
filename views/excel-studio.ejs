    function updateResultColFM(idx, val) {
        const exam = getActiveExam();
        exam.columns[idx].fullMarks = Number(val) > 0 ? Number(val) : 100;
        markDirty('results', true);
        renderResultsTableAndStats();
    }

    function updateResultMapping(fieldKey, colKey) {
        const exam = getActiveExam();
        if (!exam.mapping) exam.mapping = {};
        exam.mapping[fieldKey] = colKey;
        markDirty('results', true);
        renderResultsTableAndStats();
    }

    function addResultRow() {
        const exam = getActiveExam();
        const row = { _id: `r_${Date.now()}` };
        exam.columns.forEach((c) => { row[c.key] = ''; });
        exam.rows.push(row);
