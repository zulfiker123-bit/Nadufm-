            <div class="stat-box"><div class="stat-box-label">অকৃতকার্য (Failed)</div><div class="stat-box-val" style="color:#b91c1c;">${bnNum(s.failed)}</div></div>
            <div class="stat-box"><div class="stat-box-label">পাসের হার</div><div class="stat-box-val">${bnNum(s.passRate)}%</div></div>
        `;
        renderResultsTable();
    }

    function renderResultsTable() {
        const exam = getActiveExam();
        const computed = exam.computed || recomputeExamClient(exam);
        const container = document.getElementById('resultsTableContainer');
        const q = String(document.getElementById('resultsSearchInput')?.value || '').trim().toLowerCase();

        if (!exam.rows || exam.rows.length === 0) {
            const clsLabel = formatClassLabelClient(exam.className, exam.classId);
            container.innerHTML = `<div class="empty-state"><i class="fas fa-poll-h" aria-hidden="true"></i><p>${esc(clsLabel)}-এর রেজাল্ট শিটে এখনো কোনো শিক্ষার্থী নেই। উপরের <strong>${esc(clsLabel)}</strong> কার্ড থেকে Excel আপলোড করুন অথবা <strong>নতুন শিক্ষার্থী</strong> যোগ করুন।</p></div>`;
            return;
        }

        const matchesFilter = (item) => {
            if (resultStatusFilter !== 'all' && item.status !== resultStatusFilter) return false;
            if (q) {
                return String(item.name).toLowerCase().includes(q) || String(item.roll).toLowerCase().includes(q);
            }
            return true;
        };

        if (resultSubView === 'marksheet') {
            const list = computed.evaluatedRows.filter(matchesFilter);
            const clsLabel = formatClassLabelClient(exam.className, exam.classId);
            if (!list.length) {
                container.innerHTML = `<div class="empty-state"><i class="fas fa-filter" aria-hidden="true"></i><p>নির্বাচিত ফিল্টার অনুযায়ী কোনো শিক্ষার্থীর মার্কশিট পাওয়া যায়নি।</p></div>`;
                return;
            }

            let selectedEv = list.find((item) => item._id === selectedInlineMarksheetRowId) || list[0];
            selectedInlineMarksheetRowId = selectedEv._id;
            const origIdx = exam.rows.findIndex((r) => (r._id || '') === selectedEv._id);
            const safeIdx = origIdx >= 0 ? origIdx : 0;

            buildUnifiedStudioPool();
            const ck = normalizeClassClient(exam.className || (state.classMap?.[exam.classId]?.name || ''));
