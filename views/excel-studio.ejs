    function populateDocClassFilter() {
        buildUnifiedStudioPool();
        const clsSelect = document.getElementById('docClassFilter');
        if (!clsSelect) return;
        const prev = clsSelect.value;
        const clsMap = new Map();
        unifiedPoolCache.forEach((u) => {
            if (u.clsKey && !clsMap.has(u.clsKey)) {
                clsMap.set(u.clsKey, u.cls || u.clsKey);
            }
        });
        clsSelect.innerHTML = '<option value="">-- সকল শ্রেণি (' + bnNum(unifiedPoolCache.length) + ' জন) --</option>' +
            Array.from(clsMap.entries()).map(([k, lbl]) => `<option value="${esc(k)}">${esc(lbl)}</option>`).join('');
        if (prev && clsMap.has(prev)) clsSelect.value = prev;
    }

    function onDocClassFilterChange() {
        populateDocRecordPicker(true);
    }

    function jumpToDocRoll(rawInput) {
        const q = String(rawInput || '').trim().toLowerCase();
        const targetRoll = normalizeRollClient(rawInput);
        if (!q) return;
        const select = document.getElementById('docRecordSelect');
        const opts = Array.from(select.options);
        const foundOpt = opts.find((o) => {
            const r = normalizeRollClient(o.getAttribute('data-roll') || '');
            return (targetRoll && r === targetRoll) || o.textContent.toLowerCase().includes(q);
        });
        if (foundOpt && foundOpt.value !== '') {
            select.value = foundOpt.value;
            loadSelectedRecordIntoForm();
        }
    }

    function populateDocRecordPicker(preserveClassFilter) {
        if (!preserveClassFilter) {
            populateDocClassFilter();
        } else {
            buildUnifiedStudioPool();
        }
        const select = document.getElementById('docRecordSelect');
        const filterClsKey = document.getElementById('docClassFilter')?.value || '';
        const filtered = unifiedPoolCache.filter((u) => !filterClsKey || u.clsKey === filterClsKey);
        const prevVal = select.value;

        select.innerHTML = filtered.length
            ? filtered.map((u) => {
                const tag = u.hasStudentInfo && u.hasResultInfo
                    ? 'তথ্য + ফলাফল'
                    : (u.hasResultInfo ? 'ফলাফল' : 'তথ্য');
                return `<option value="${esc(u.key)}" data-roll="${esc(u.roll)}">${u.roll ? 'রোল ' + bnNum(u.roll) + ' - ' : ''}${esc(u.name || 'নাম নেই')}${u.cls ? ' (' + esc(u.cls) + ')' : ''} [${tag}]</option>`;
            }).join('')
            : '<option value="">-- কোনো শিক্ষার্থী পাওয়া যায়নি --</option>';

        if (prevVal && filtered.some((u) => u.key === prevVal)) {
            select.value = prevVal;
        }
        loadSelectedRecordIntoForm();
    }

    let currentStudioRecord = null;

    function loadSelectedRecordIntoForm() {
        const selectedKey = document.getElementById('docRecordSelect').value;
        const rec = unifiedPoolCache.find((u) => u.key === selectedKey) || null;
        currentStudioRecord = rec;
        const noteEl = document.getElementById('docMergeStatusNote');

        if (!rec) {
            if (noteEl) noteEl.textContent = '';
            renderA4Document();
            return;
        }

        document.getElementById('fName').value = rec.name || '';
        document.getElementById('fRoll').value = rec.roll || '';
        document.getElementById('fFather').value = rec.father || '';
        document.getElementById('fMother').value = rec.mother || '';
        document.getElementById('fClass').value = rec.cls || '';
        document.getElementById('fSession').value = rec.session || '২০২৫-২০২৬';
        document.getElementById('fDob').value = rec.dob || '';
        document.getElementById('fReg').value = rec.reg || rec.id || '';
        document.getElementById('fGpa').value = rec.ev ? (rec.ev.gpa ? rec.ev.gpa.toFixed(2) : rec.ev.statusBn) : (rec.gpa || '');
        document.getElementById('fAddress').value = rec.address || '';
        if (rec.remark) document.getElementById('fRemark').value = rec.remark;

        if (noteEl) {
            const parts = [];
            if (rec.hasStudentInfo) parts.push('শিক্ষার্থী তথ্য');
            if (rec.hasResultInfo) parts.push(`ফলাফল (GPA ${bnNum(rec.ev?.gpa ? rec.ev.gpa.toFixed(2) : '0.00')})`);
            noteEl.textContent = parts.length ? 'সংযুক্ত উৎস: ' + parts.join(' + ') : '';
        }
        renderA4Document();
    }

