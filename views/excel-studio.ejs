    function stepInlineMarksheet(delta) {
        const sel = document.getElementById('inlineMarksheetStudentSelect');
        if (!sel || sel.options.length === 0) return;
        const nextIdx = Math.max(0, Math.min(sel.options.length - 1, sel.selectedIndex + delta));
        selectedInlineMarksheetRowId = sel.options[nextIdx].value;
        renderResultsTable();
    }

    function renderResultsTableAndStats() {
        const exam = getActiveExam();
        const computed = recomputeExamClient(exam);
        const s = computed.stats;
        const clsLabel = formatClassLabelClient(exam?.className, exam?.classId);

        renderResultsTableClassSelect();

        const titleEl = document.getElementById('statsSelectedClassTitle');
        if (titleEl) titleEl.textContent = clsLabel;

        const allExams = Object.values(state.results?.exams || {}).filter((ex) => Array.isArray(ex.rows) && ex.rows.length > 0);
        const overallEl = document.getElementById('statsOverallSummary');
        if (overallEl) {
            const totalUploadedStudents = allExams.reduce((acc, ex) => acc + ex.rows.length, 0);
            overallEl.textContent = allExams.length > 0
                ? `সকল শ্রেণি (${bnNum(allExams.length)}টি): মোট ${bnNum(totalUploadedStudents)} জন`
