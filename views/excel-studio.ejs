    async function saveResultsSheet() {
        const btns = [document.getElementById('resultsSaveBtnTop'), document.getElementById('resultsSaveBtnBottom')].filter(Boolean);
        btns.forEach((b) => {
            b.dataset.origHtml = b.innerHTML;
            b.disabled = true;
            b.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> সংরক্ষণ হচ্ছে...';
        });
        try {
            const exam = getActiveExam();
            const payloadExam = { ...exam };
            delete payloadExam.computed;
            const res = await fetch('/api/excel/results/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ exam: payloadExam }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            applyState(data.state);
            showToast(data.message);
        } catch (err) {
            showToast(err.message || 'সংরক্ষণ ব্যর্থ হয়েছে।', true);
        } finally {
            btns.forEach((b) => {
                b.disabled = false;
                if (b.dataset.origHtml) b.innerHTML = b.dataset.origHtml;
            });
        }
    }

    // ============ EXPORT EXCEL ============
    async function exportSheetExcel(type) {
        const sheet = state[type];
        const headers = sheet.columns.map((c) => c.label);
        const clsFilter = activeClassFilter[type] || 'all';
        const filteredRows = sheet.rows.filter((r) => {
            if (clsFilter === 'all') return true;
            return (getRowClassValue(type, r) || 'অনির্ধারিত') === clsFilter;
        });
        const rows = filteredRows.map((r) => sheet.columns.map((c) => r[c.key] ?? ''));
        await downloadExportedXlsx(headers, rows, `${type}-export.xlsx`, type);
    }

    async function exportComputedResultsExcel() {
        const exam = getActiveExam();
        const computed = recomputeExamClient(exam);
        const headers = [...exam.columns.map((c) => c.label), 'মোট প্রাপ্ত নম্বর', 'পূর্ণমান', 'শতকরা (%)', 'GPA', 'ফেল বিষয়', 'মেধাক্রম', 'ফলাফল'];
        const rows = computed.meritList.map((m) => [
            ...exam.columns.map((c) => m.raw[c.key] ?? ''),
            m.totalObtained,
            m.totalFullMarks,
            m.percentage,
            m.gpa.toFixed(2),
            m.failCount,
            m.meritRank ?? '',
            m.statusBn,
        ]);
        await downloadExportedXlsx(headers, rows, `${exam.id}-gpa-merit.xlsx`, 'Result_Merit');
    }

    async function downloadExportedXlsx(headers, rows, filename, sheetName) {
        try {
            if (window.NadufmExport && typeof window.NadufmExport.postDownloadForm === 'function') {
                window.NadufmExport.postDownloadForm('/api/excel/export', {
                    payload: JSON.stringify({ headers, rows, filename, sheetName }),
                });
                showToast('Excel ফাইল ডাউনলোড শুরু হয়েছে।');
                return;
            }
            const res = await fetch('/api/excel/export', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ headers, rows, filename, sheetName }),
            });
            if (!res.ok) throw new Error('এক্সপোর্ট ব্যর্থ হয়েছে');
            const blob = await res.blob();
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            setTimeout(() => {
                if (a.parentNode) a.parentNode.removeChild(a);
                URL.revokeObjectURL(url);
            }, 30000);
        } catch (err) {
            showToast(err.message || 'এক্সপোর্ট ব্যর্থ হয়েছে', true);
        }
    }

