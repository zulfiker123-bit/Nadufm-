    // ============ RESULTS SECTION (PER-CLASS UPLOAD + STATS) ============
    function formatClassLabelClient(name, classId) {
        const raw = String(name || (classId && state.classMap?.[classId]?.name) || '').trim();
        if (!raw || raw === 'custom') return 'নির্ধারিত শ্রেণি';
        return /(?:শ্রেণি|শ্রেণী)$/.test(raw) ? raw : `${raw} শ্রেণি`;
    }

    function getExamForClass(classId) {
        const cid = String(classId || '').trim();
        const exams = Object.values(state.results?.exams || {});
        const matching = exams.filter((ex) => String(ex.classId || '').trim() === cid);
        if (!matching.length) return null;
        return matching.find((ex) => Array.isArray(ex.rows) && ex.rows.length > 0) || matching[0];
    }

    function ensureClassExamRecord(classId) {
        const cid = String(classId || '6').trim();
        let ex = getExamForClass(cid);
        if (ex) return ex;
        const className = String(state.classMap?.[cid]?.name || 'ষষ্ঠ').trim();
        const examName = String(document.getElementById('examNameInput')?.value || 'বার্ষিক পরীক্ষা').trim() || 'বার্ষিক পরীক্ষা';
        const year = String(document.getElementById('examYearInput')?.value || '২০২৬').trim() || '২০২৬';
        const examId = `exam_class_${cid}`;
        ex = {
            id: examId,
            title: `${formatClassLabelClient(className, cid)} — ${examName}`,
            classId: cid,
            className,
            examName,
            year,
            passPercent: 33,
            maxPromoteFail: 0,
            promotionLabel: 'বিশেষ বিবেচনায় প্রমোটেড',
            columns: [
                { key: 'roll', label: 'রোল', isSubject: false, fullMarks: 0 },
                { key: 'name', label: 'শিক্ষার্থীর নাম', isSubject: false, fullMarks: 0 },
                { key: 'father', label: 'পিতার নাম', isSubject: false, fullMarks: 0 },
                { key: 'sub_quran', label: 'কুরআন মাজিদ (100)', isSubject: true, fullMarks: 100 },
                { key: 'sub_arabic', label: 'আরবি (100)', isSubject: true, fullMarks: 100 },
                { key: 'sub_bangla', label: 'বাংলা (100)', isSubject: true, fullMarks: 100 },
                { key: 'sub_english', label: 'ইংরেজি (100)', isSubject: true, fullMarks: 100 },
                { key: 'sub_math', label: 'গণিত (100)', isSubject: true, fullMarks: 100 },
            ],
            mapping: { roll: 'roll', name: 'name', father: 'father', id: '', group: '', optionalSubject: '' },
            rows: [],
            updatedAt: null,
        };
        if (!state.results.exams) state.results.exams = {};
        state.results.exams[examId] = ex;
        return ex;
    }

    function selectClassResult(classId) {
        const ex = ensureClassExamRecord(classId);
        state.results.activeExamId = ex.id;
        selectedInlineMarksheetRowId = '';
        renderResultsSection();
    }

    async function uploadClassResultExcel(classId, droppedFile, inputEl) {
        const cid = String(classId ?? '6').trim();
        const inp = inputEl || document.getElementById('classResultFile_' + cid);
        const btn = document.getElementById('classUploadBtn_' + cid);
        const btnLabel = btn ? btn.querySelector('.upload-btn-label') : null;
        const selectedFile = droppedFile || (inp && inp.files && inp.files[0]);

        if (!selectedFile) {
            setUploadStatus('results', 'কোনো ফাইল পাওয়া যায়নি। আবার একটি .xlsx, .xls বা .csv ফাইল নির্বাচন করুন।', 'error');
            showToast('কোনো ফাইল নির্বাচন করা হয়নি।', true);
            return;
        }

        if (!navigator.onLine) {
            if (inp) inp.value = '';
            setUploadStatus('results', 'অফলাইনে Excel ফাইল আপলোড করা যাবে না। ইন্টারনেট সংযোগ চালু করে আবার চেষ্টা করুন।', 'error');
            showToast('ইন্টারনেট সংযোগ নেই।', true);
            return;
        }

        if (!isSupportedSpreadsheetFile(selectedFile)) {
            if (inp) inp.value = '';
            setUploadStatus('results', `"${selectedFile.name}" সঠিক Excel বা CSV ফাইল নয় (.xlsx, .xls, .csv আপলোড করুন)।`, 'error');
            showToast('সঠিক Excel বা CSV ফাইল নির্বাচন করুন।', true);
            return;
        }

        const existing = getExamForClass(cid);
        const examId = existing?.id || `exam_class_${cid}`;
        const className = String(existing?.className || state.classMap?.[cid]?.name || 'ষষ্ঠ').trim();
        const examName = String(document.getElementById('examNameInput')?.value || existing?.examName || 'বার্ষিক পরীক্ষা').trim();
        const year = String(document.getElementById('examYearInput')?.value || existing?.year || '২০২৬').trim();

        const fd = new FormData();
        fd.append('file', selectedFile);
        fd.append('target', 'results');
        fd.append('examId', examId);
        fd.append('classId', cid);
        fd.append('className', className);
        fd.append('examName', examName);
        fd.append('year', year);
        fd.append('passPercent', existing?.passPercent || 33);
        fd.append('maxPromoteFail', existing?.maxPromoteFail || 0);
        fd.append('promotionLabel', existing?.promotionLabel || 'বিশেষ বিবেচনায় প্রমোটেড');

        if (btn) {
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.7';
        }
        if (btnLabel) {
            btnLabel.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> আপলোড হচ্ছে...';
        }
        const clsLabel = formatClassLabelClient(className, cid);
        setUploadStatus('results', `${clsLabel}: "${selectedFile.name}" আপলোড ও GPA হিসাব হচ্ছে...`, 'loading');
        document.getElementById('resultsUploadStatus')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        try {
            const res = await fetch('/api/excel/upload', {
                method: 'POST',
                body: fd,
                credentials: 'same-origin',
            });
            if (res.status === 401) {
                throw new Error('অ্যাডমিন সেশন শেষ হয়েছে — অনুগ্রহ করে পুনরায় লগইন করে আপলোড করুন।');
            }
            const rawText = await res.text();
            let data = {};
            try {
                data = JSON.parse(rawText);
            } catch {
                throw new Error('সার্ভার থেকে সঠিক উত্তর পাওয়া যায়নি। ফাইল ফরম্যাট যাচাই করুন।');
            }
            if (!res.ok) throw new Error(data.error || 'আপলোড ব্যর্থ হয়েছে');

            resultStatusFilter = 'all';
            document.querySelectorAll('[data-res-status]').forEach((b) => {
                b.classList.toggle('active', b.getAttribute('data-res-status') === 'all');
            });
            const searchEl = document.getElementById('resultsSearchInput');
            if (searchEl) searchEl.value = '';
            selectedInlineMarksheetRowId = '';

            applyState(data.state);
            if (inp) inp.value = '';
            setUploadStatus('results', `${clsLabel}: ${data.message}`, 'success');
            showToast(`${clsLabel} — ${data.message}`);
        } catch (err) {
            if (inp) inp.value = '';
            setUploadStatus('results', `${clsLabel}: ${err.message || 'আপলোড ব্যর্থ হয়েছে'}`, 'error');
            showToast(err.message || 'আপলোড ব্যর্থ হয়েছে', true);
        } finally {
            const latestBtn = document.getElementById('classUploadBtn_' + cid);
            if (latestBtn) {
                latestBtn.style.pointerEvents = '';
                latestBtn.style.opacity = '';
                const latestLabel = latestBtn.querySelector('.upload-btn-label');
                const hasRows = (getExamForClass(cid)?.rows || []).length > 0;
                if (latestLabel) {
                    latestLabel.innerHTML = `<i class="fas fa-upload" aria-hidden="true"></i> ${hasRows ? 'নতুন Excel' : 'Excel আপলোড'}`;
                }
            }
        }
    }

    async function clearClassResult(classId, ev) {
        if (ev) ev.stopPropagation();
        const ex = getExamForClass(classId);
        if (!ex || !(ex.rows || []).length) return;
        try {
            if (window.NadufmOffline) {
                const res = await window.NadufmOffline.saveMutationOrQueue({
                    label: 'ফলাফল মুছে ফেলা (' + (ex.className || classId) + ')',
                    url: '/api/excel/results/' + encodeURIComponent(ex.id),
                    method: 'DELETE',
                    headers: {},
                    optimisticUpdate: () => {
                        if (state.results && state.results.exams && state.results.exams[ex.id]) {
                            state.results.exams[ex.id].rows = [];
                        }
                        persistLocalExcelState();
                    },
                });
                if (res.queued) {
                    if (state.results && state.results.exams && state.results.exams[ex.id]) {
                        state.results.exams[ex.id].rows = [];
                    }
                    renderResultsSection();
                    showToast('অফলাইনে ডিলিট সংরক্ষিত হয়েছে — অনলাইনে অটো সিঙ্ক হবে।');
                    return;
                }
                if (res.data && res.data.state) applyState(res.data.state);
                showToast((res.data && res.data.message) || 'ফলাফল মুছে ফেলা হয়েছে।');
                return;
            }
            const res = await fetch('/api/excel/results/' + encodeURIComponent(ex.id), {
                method: 'DELETE',
                credentials: 'same-origin',
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            applyState(data.state);
            showToast(data.message);
        } catch (err) {
            showToast(err.message || 'মুছে ফেলা সম্ভব হয়নি।', true);
        }
    }

