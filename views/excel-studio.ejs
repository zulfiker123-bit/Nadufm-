    function getMappedField(row, mapping, candidateKeys) {
        for (const mk of candidateKeys) {
            const colKey = mapping?.[mk];
            if (colKey && row[colKey] !== undefined && String(row[colKey]).trim() !== '') {
                return String(row[colKey]).trim();
            }
        }
        return '';
    }

