            card.addEventListener('dragleave', () => {
                card.classList.remove('is-dragover');
            });
            card.addEventListener('drop', (e) => {
                e.preventDefault();
                card.classList.remove('is-dragover');
                const file = e.dataTransfer?.files?.[0];
                if (file && cid) uploadClassResultExcel(cid, file);
            });
        });
