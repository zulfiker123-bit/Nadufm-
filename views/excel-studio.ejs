            <div class="stat-box"><div class="stat-box-label">প্রমোটেড (Promoted)</div><div class="stat-box-val" style="color:#b45309;">${bnNum(s.promoted)}</div></div>
            <div class="stat-box"><div class="stat-box-label">অকৃতকার্য (Failed)</div><div class="stat-box-val" style="color:#b91c1c;">${bnNum(s.failed)}</div></div>
            <div class="stat-box"><div class="stat-box-label">পাসের হার (উত্তীর্ণ+প্রমোটেড)</div><div class="stat-box-val">${bnNum(s.passRate)}%</div></div>
        `;
        renderResultsTable();
