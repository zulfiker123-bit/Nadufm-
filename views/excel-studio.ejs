    function updatePromoConfig() {
        const exam = getActiveExam();
        exam.passPercent = Number(document.getElementById('examPassPercent').value) || 33;
        exam.maxPromoteFail = Number(document.getElementById('examMaxPromoteFail').value) || 0;
        exam.promotionLabel = document.getElementById('examPromoLabel').value || 'বিশেষ বিবেচনায় প্রমোটেড';
        renderResultsTableAndStats();
    }

    function bulkPromoteFailed(val) {
        const exam = getActiveExam();
        const computed = recomputeExamClient(exam);
        computed.evaluatedRows.forEach((ev, idx) => {
            if (val === true) {
                if (ev.failCount > 0 && !ev.allAbsent) {
                    exam.rows[idx]._promoted = true;
                }
            } else {
                delete exam.rows[idx]._promoted;
            }
        });
        renderResultsTableAndStats();
        showToast(val === true ? 'সকল ফেলকৃত শিক্ষার্থীকে প্রমোটেড করা হয়েছে।' : 'ম্যানুয়াল প্রমোশন রিসেট হয়েছে।');
    }

    function toggleRowPromote(rowIndex) {
        const exam = getActiveExam();
        const computed = recomputeExamClient(exam);
        const ev = computed.evaluatedRows[rowIndex];
        if (!ev) return;
        exam.rows[rowIndex]._promoted = !ev.isPromoted;
        renderResultsTableAndStats();
    }

