    function renderResultsTableAndStats() {
        const exam = getActiveExam();
        const computed = recomputeExamClient(exam);
        const s = computed.stats;
        const clsLabel = formatClassLabelClient(exam?.className, exam?.classId);

        const titleEl = document.getElementById('statsSelectedClassTitle');
        if (titleEl) titleEl.textContent = clsLabel;

        const allExams = Object.values(state.results?.exams || {}).filter((ex) => Array.isArray(ex.rows) && ex.rows.length > 0);
