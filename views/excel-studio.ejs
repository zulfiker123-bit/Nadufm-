                            ${list.map((m) => `<option value="${esc(m._id)}" ${m._id === selectedEv._id ? 'selected' : ''}>রোল ${bnNum(m.roll || '—')} — ${esc(m.name || 'নাম নেই')} (GPA ${bnNum(m.gpa.toFixed(2))})</option>`).join('')}
